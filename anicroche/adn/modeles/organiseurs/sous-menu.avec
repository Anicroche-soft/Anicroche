@style [
    /* Le sous-menu n apparaît qu ouvert (boite-dialogue), à la place du menu principal, sur
       tout le contenu de la boîte (marges comprises) : il y défile lui-même, et sa piste part
       avec lui. Pendant sa transition, il est posé par-dessus le menu principal */
    .sous-menu {
        display: none;
    }

    .sous-menu.ouvert {
        display: flex;
        flex-flow: column nowrap;
        flex: 1 1 auto;
        min-height: 0;

        margin: calc(0rem - var(--l-marge));
    }

    /* Sa hauteur, celle de sa vue ouverte, est fixée par boite-dialogue */
    .sous-menu.superpose {
        position: absolute;
        top: 0;
        right: 0;
        left: 0;

        margin: 0;
    }

    .sous-menu > .liste-sous-menu {
        flex: 1 1 auto;
        min-height: 0;

        padding: var(--l-marge);
    }

    .liste-sous-menu > .separateur-sous-menu {
        flex: none;

        width: 100%;
        height: 0.125rem;

        border-radius: 0.0625rem;

        --f-fond: var(--c-flux);
    }
]

# Sous-menu d'une boîte de dialogue, placé dans son contenu (boite-dialogue) et ouvert par
# $ouvrir_sous_menu($nom) : il commence par le retour au menu principal ($fermer_sous_menu), avec
# son titre ; un seul niveau de sous-menu
@args [$nom, $titre]

<div .sous-menu data-sous-menu="$nom">
    defilement.liste-sous-menu [$integration : :(]
        boite-action [$fermer_sous_menu]
            icone-fleche-gauche
            <span>
                "$titre"
        <hr .separateur-sous-menu>
        @stud
