@script [
    $monter_tiroir = () =>
    {
        const tiroir  = $node
        const racine  = document.documentElement
        const contenu = () => tiroir.querySelector('.contenu-tiroir')

        // Au bas de l écran en format petit ou au toucher, au centre sinon
        const en_feuille = () => racine.classList.contains('petit') || racine.classList.contains('grossier')

        // Durée des animations du tiroir (--d-tiroir), lue dans sa transition calculée par le
        // navigateur : la variable elle-même garde son calc() non calculé
        const duree = () =>
        {
            const valeur = getComputedStyle(tiroir).transitionDuration.split(',')[0].trim()
            const nombre = parseFloat(valeur) || 0
            return valeur.endsWith('ms') ? nombre : nombre * 1000
        }

        // Ce qui défile : le sous-menu ouvert, sinon le contenu
        const defilant = () => sous_menu?.querySelector(':scope > .liste-sous-menu') ?? contenu()

        // Tiroir extensible ($extensible) : non modal (la page reste utilisable, sans fond
        // grisé) ; au bas de l écran, il garde sa hauteur de base (celle où il est positionné,
        // même petite) quel que soit son contenu, et seule sa barre l agrandit, jusqu à sa
        // hauteur agrandie
        const extensible = () => tiroir.classList.contains('extensible')

        // Hauteur de base d un tiroir positionné ($ouvrir_tiroir(nom, haut)), comme dans le
        // style : son haut à cette distance du haut de l écran (la moitié de l écran au plus,
        // sauf pour un tiroir extensible)
        const hauteur_positionnee = () =>
        {
            const haut = parseFloat(tiroir.style.getPropertyValue('--haut-tiroir'))
            if (Number.isNaN(haut))
                return null
            const limite = extensible() ? haut : Math.min(haut, window.innerHeight / 2)
            return Math.max(0, window.innerHeight - limite)
        }

        // Hauteur du tiroir où tout son contenu est visible, mesurée en lui rendant un instant
        // sa hauteur naturelle (fit-content : en auto, le dialog modal, fixé en haut et en bas
        // de l écran, le prendrait tout), sans limite ni transition (le style d origine revient
        // avant que la transition ne soit rétablie, pour qu aucune ne parte)
        const hauteur_entiere = () =>
        {
            const proprietes = [ 'transition', 'height', 'min-height', 'max-height' ]
            const origine    = proprietes.map(propriete => tiroir.style.getPropertyValue(propriete))

            tiroir.style.transition = 'none'
            tiroir.style.height     = 'fit-content'
            tiroir.style.minHeight  = '0'
            tiroir.style.maxHeight  = 'none'
            const hauteur = tiroir.getBoundingClientRect().height

            proprietes.forEach((propriete, i) =>
            {
                if (propriete !== 'transition')
                    tiroir.style.setProperty(propriete, origine[i])
            })
            tiroir.getBoundingClientRect()
            tiroir.style.setProperty('transition', origine[0])
            return hauteur
        }

        let fermeture    = false
        let hauteur_base = null
        let geste        = null
        let retour       = null

        const vider_styles = () =>
        {
            for (const propriete of [ 'transform', 'height', 'max-height', '--retrait-tiroir' ])
                tiroir.style.removeProperty(propriete)
        }

        // Après la fermeture, quelle qu en soit la cause (y compris une demande de fermeture
        // que le navigateur n a pas laissé retarder)
        const reinitialiser = () =>
        {
            clearTimeout(retour)
            tiroir.classList.remove('fermeture', 'glissement', 'positionne', 'agrandi')
            vider_styles()
            tiroir.style.removeProperty('--haut-tiroir')
            fermeture    = false
            hauteur_base = null
            geste        = null
            ne_plus_veiller()
            remettre_menu_principal()
        }

        // Le tiroir se ferme une fois son animation de sortie finie : il part de là où il est
        // (glissé vers le bas, par exemple)
        const fermer = () =>
        {
            if (!tiroir.open || fermeture)
                return

            fermeture = true
            clearTimeout(retour)
            tiroir.classList.remove('glissement')
            tiroir.style.removeProperty('transform')
            tiroir.style.removeProperty('--retrait-tiroir')
            tiroir.classList.add('fermeture')

            setTimeout(() =>
            {
                if (tiroir.open)
                    tiroir.close()
            }, duree())
        }

        tiroir.addEventListener('close', reinitialiser)
        tiroir.addEventListener('fermer-tiroir', fermer)

        // ─── Sous-menus ──────────────────────────────────────────────────────

        // Un sous-menu (modèle sous-menu) arrive de la droite par-dessus le menu principal, qui
        // reste en place et s estompe ; le retour fait l inverse. Pendant la transition, le
        // sous-menu qui arrive ou qui part est posé par-dessus le menu principal, et la hauteur
        // du contenu passe de l une à l autre. Chacun défile pour lui-même
        let sous_menu   = null
        let transition  = null

        // Position du menu principal dans son défilement, gardée pendant la transition (le
        // sous-menu superposé est posé à cette hauteur, devant la partie visible) et retrouvée
        // au retour
        let position_menu = 0

        const defiler_vers = (element, haut) =>
        {
            element.scrollTo({ top: haut, behavior: 'instant' })
            return element.scrollTop
        }

        const principaux = () => [ ...contenu().children ]
            .filter(element => !element.classList.contains('piste') && !element.classList.contains('sous-menu'))

        // Les animations gardent leur état final (fill: forwards) jusqu à ce que la vue finale
        // soit en place, pour qu aucune image ne montre l état de départ entre les deux
        const options_animation = () => ({ duration: duree(), easing: 'ease', fill: 'forwards' })

        const animer_vues = (cible, principaux, entree) =>
        {
            // Hors de vue : décalé de sa largeur et de la marge de droite du contenu
            const marge   = parseFloat(getComputedStyle(contenu()).paddingRight) || 0
            const dehors  = { transform: `translateX(calc(100% + ${marge}px))` }
            const dedans  = { transform: 'none' }
            const visible = { opacity: 1 }
            const estompe = { opacity: 0 }

            return [
                cible.animate(entree ? [ dehors, dedans ] : [ dedans, dehors ], options_animation()),
                ...principaux.map(element => element.animate(entree ? [ visible, estompe ] : [ estompe, visible ], options_animation()))
            ]
        }

        // La hauteur du contenu passe de depart à arrivee
        const animer_hauteur = (element, depart, arrivee) =>
        {
            if (Math.abs(depart - arrivee) < 1)
                return null
            return element.animate([ { height: `${depart}px` }, { height: `${arrivee}px` } ], options_animation())
        }

        // La vue finale est mise en place à la fin réelle des animations, puis celles-ci sont
        // retirées, dans la même image
        const finir_transition = (animations, action) =>
        {
            const actives = animations.filter(Boolean)
            transition = { animations: actives }
            contenu().classList.add('transition-sous-menu')

            Promise.all(actives.map(animation => animation.finished))
                .then(() =>
                {
                    if (transition?.animations !== actives)
                        return
                    transition = null
                    action()
                    actives.forEach(animation => animation.cancel())

                    // Après la mise à jour de la piste par le défilement (son observateur, appelé
                    // dans une microtâche mise en file par action) : sinon, sa mesure la ferait
                    // afficher, survolée, avant de la cacher, et elle s estomperait
                    queueMicrotask(() => contenu()?.classList.remove('transition-sous-menu'))
                })
                .catch(() => {})
        }

        // Le focus suit le sous-menu au clavier
        const deplacer_focus = (vers) =>
        {
            if (document.activeElement?.matches(':focus-visible') && tiroir.contains(document.activeElement))
                vers?.focus({ preventScroll: true })
        }

        const ouvrir_sous_menu = (nom) =>
        {
            if (transition || sous_menu || fermeture)
                return

            const element = contenu()
            const cible   = [ ...element.children ].find(enfant => enfant.classList.contains('sous-menu') && enfant.dataset.sousMenu === nom)
            if (!cible)
                return

            const depart   = element.getBoundingClientRect().height
            const sortants = principaux()
            position_menu  = element.scrollTop

            // Hauteur finale, celle du sous-menu seul (limitée par le tiroir), mesurée dans sa
            // vue finale avant la transition ; le menu principal reste là où il était défilé
            sortants.forEach(sortant => sortant.classList.add('masque-sous-menu'))
            cible.classList.add('ouvert')
            cible.querySelector(':scope > .liste-sous-menu')?.scrollTo({ top: 0, behavior: 'instant' })
            const arrivee = element.getBoundingClientRect().height
            sortants.forEach(sortant => sortant.classList.remove('masque-sous-menu'))
            const haut = defiler_vers(element, position_menu)

            // Superposé, il garde la hauteur de sa vue ouverte, et non celle du contenu qui
            // change : sa piste n apparaît que s il déborde vraiment
            cible.style.height = `${arrivee}px`
            cible.style.top    = `${haut}px`
            cible.classList.add('superpose')

            sous_menu = cible
            const animations = [ ...animer_vues(cible, sortants, true), animer_hauteur(element, depart, arrivee) ]
            deplacer_focus(cible.querySelector('a, button'))

            finir_transition(animations, () =>
            {
                sortants.forEach(sortant => sortant.classList.add('masque-sous-menu'))
                cible.classList.remove('superpose')
                cible.style.removeProperty('height')
                cible.style.removeProperty('top')

                // Le sous-menu, à sa place, est tout en haut du contenu : le défilement du menu
                // principal y revient aussitôt (sinon, la piste, encore posée à sa hauteur, le
                // garderait défilé jusqu à sa mise à jour, et le sous-menu sauterait)
                element.scrollTo({ top: 0, behavior: 'instant' })
            })
        }

        const fermer_sous_menu = () =>
        {
            if (transition || !sous_menu || fermeture)
                return

            const element = contenu()
            const cible   = sous_menu
            const depart  = element.getBoundingClientRect().height
            const entrants = principaux()

            // Le menu principal revient là où il était défilé, le sous-menu superposé devant
            // la partie visible
            cible.style.height = `${depart}px`
            cible.classList.add('superpose')
            entrants.forEach(entrant => entrant.classList.remove('masque-sous-menu'))
            const arrivee = element.getBoundingClientRect().height
            cible.style.top = `${defiler_vers(element, position_menu)}px`

            sous_menu = null
            const animations = [ ...animer_vues(cible, entrants, false), animer_hauteur(element, depart, arrivee) ]
            deplacer_focus(entrants.find(entrant => entrant.matches('a, button')) ?? entrants[0]?.querySelector('a, button'))

            finir_transition(animations, () =>
            {
                cible.classList.remove('ouvert', 'superpose')
                cible.style.removeProperty('height')
                cible.style.removeProperty('top')
            })
        }

        // À la fermeture du tiroir, le menu principal revient sans transition
        const remettre_menu_principal = () =>
        {
            transition?.animations.forEach(animation => animation.cancel())
            transition    = null
            sous_menu     = null
            position_menu = 0

            const element = contenu()
            if (!element)
                return
            element.classList.remove('transition-sous-menu')
            for (const enfant of element.children)
            {
                enfant.classList.remove('masque-sous-menu', 'ouvert', 'superpose')
                if (enfant.classList.contains('sous-menu'))
                {
                    enfant.style.removeProperty('height')
                    enfant.style.removeProperty('top')
                }
            }
        }

        tiroir.addEventListener('ouvrir-sous-menu', (evenement) => ouvrir_sous_menu(evenement.detail))
        tiroir.addEventListener('fermer-sous-menu', fermer_sous_menu)

        // Échap, ou retour d Android : depuis un sous-menu, retour au menu principal ; sinon, le
        // tiroir se ferme avec son animation
        const annuler = () =>
        {
            if (sous_menu)
                fermer_sous_menu()
            else
                fermer()
        }

        tiroir.addEventListener('cancel', (evenement) =>
        {
            evenement.preventDefault()
            annuler()
        })

        // Un tiroir non modal (extensible) ne reçoit pas cancel : Échap et le retour d Android
        // passent par un CloseWatcher, renouvelé après chaque retour d un sous-menu, ou à
        // défaut Échap seul, écouté sur la page
        let veilleur = null

        const echap = (evenement) =>
        {
            if (evenement.key === 'Escape' && !evenement.defaultPrevented)
                annuler()
        }

        const veiller = () =>
        {
            if (!tiroir.open || tiroir.matches(':modal') || fermeture)
                return

            if (!('CloseWatcher' in window))
                return document.addEventListener('keydown', echap)

            veilleur = new CloseWatcher()
            veilleur.addEventListener('close', () =>
            {
                veilleur = null
                annuler()
                veiller()
            })
        }

        const ne_plus_veiller = () =>
        {
            document.removeEventListener('keydown', echap)
            veilleur?.destroy()
            veilleur = null
        }

        tiroir.addEventListener('ouverture-tiroir', veiller)

        // Un clic sur le fond grisé (d un tiroir modal) a pour cible le tiroir lui-même, hors de
        // son rectangle ; l appui doit aussi y avoir commencé (et non dans le tiroir, en
        // sélectionnant du texte)
        const dehors = (x, y) =>
        {
            const rectangle = tiroir.getBoundingClientRect()
            return x < rectangle.left || x > rectangle.right || y < rectangle.top || y > rectangle.bottom
        }

        const hors_tiroir = (evenement) =>
            evenement.target === tiroir && dehors(evenement.clientX, evenement.clientY)

        let appui_sur_fond = false

        tiroir.addEventListener('pointerdown', (evenement) =>
        {
            appui_sur_fond = hors_tiroir(evenement)
        })

        tiroir.addEventListener('click', (evenement) =>
        {
            if (appui_sur_fond && hors_tiroir(evenement))
                fermer()
            appui_sur_fond = false
        })

        // Un lien vers la page affichée ne navigue pas (navigateur) : il ferme le tiroir
        tiroir.addEventListener('click', (evenement) =>
        {
            const lien = evenement.target.closest?.('a[href]')
            if (!lien || !tiroir.contains(lien) || lien.target === '_blank')
                return

            const adresse = new URL(lien.href, location.href)
            if (adresse.origin === location.origin && adresse.pathname + adresse.search === location.pathname + location.search)
                fermer()
        })

        // ─── Glissement ──────────────────────────────────────────────────────

        // La position du geste est la hauteur visible du tiroir. Au-dessus de sa hauteur de
        // base, il grandit jusqu à geste.max (sa hauteur agrandie, pour un tiroir extensible
        // tenu par sa barre), puis résiste ; en dessous, il descend
        const placer = (visible) =>
        {
            const base = hauteur_base
            const max  = geste.max

            if (visible >= base)
            {
                const hauteur = visible > max ? max + (visible - max) / 4 : visible

                tiroir.style.height = `${hauteur}px`
                tiroir.style.removeProperty('transform')
                tiroir.style.removeProperty('--retrait-tiroir')
                return
            }

            const descente = base - visible
            tiroir.style.height    = `${base}px`
            tiroir.style.transform = `translateY(${descente}px)`
            tiroir.style.setProperty('--retrait-tiroir', Math.min(1, descente / base).toFixed(3))
        }

        // Vitesse des 100 dernières millisecondes, en pixels par milliseconde (positive vers le
        // bas)
        const vitesse = () =>
        {
            const points = geste.points
            const dernier = points.at(-1)
            const premier = points.find(point => dernier.temps - point.temps <= 100) ?? dernier
            const temps   = dernier.temps - premier.temps
            return temps > 0 ? (dernier.y - premier.y) / temps : 0
        }

        // Retour à la hauteur de base ou agrandie, puis la hauteur revient à celle du style,
        // qui suit la taille de l écran et du contenu
        const revenir = (hauteur, agrandi) =>
        {
            tiroir.style.removeProperty('transform')
            tiroir.style.removeProperty('--retrait-tiroir')
            tiroir.style.maxHeight = 'none'
            tiroir.style.height    = `${hauteur}px`
            tiroir.classList.toggle('agrandi', agrandi)

            clearTimeout(retour)
            retour = setTimeout(() =>
            {
                if (!geste)
                    vider_styles()
            }, duree())
        }

        const relacher = () =>
        {
            const base    = hauteur_base
            const max     = geste.max
            const visible = geste.visible
            const elan    = vitesse()

            tiroir.classList.remove('glissement')

            if (visible < base)
            {
                if (base - visible > base / 4 || elan > 0.5)
                    return fermer()
                return revenir(base, false)
            }

            const vers_le_haut = elan < -0.5 || (elan <= 0.5 && visible - base > (max - base) / 2)
            if (max > base + 1 && vers_le_haut)
                return revenir(max, true)
            revenir(base, false)
        }

        // Un geste commence sur le tiroir (marges comprises), jamais sur le fond grisé
        const debuter = (x, y, cible) =>
        {
            if (!en_feuille() || fermeture || dehors(x, y))
                return

            clearTimeout(retour)

            const hauteur = tiroir.getBoundingClientRect().height
            const poignee = !!cible.closest('.entete-tiroir')
            const agrandi = tiroir.classList.contains('agrandi')

            hauteur_base = agrandi ? (hauteur_positionnee() ?? hauteur) : hauteur

            // Hauteur agrandie d un tiroir extensible, mesurée à chaque geste d après l écran et
            // le contenu du moment : celle où il est positionné si tout le contenu y tient, sinon
            // celle où tout le contenu tient, sinon tout l écran. Sinon, le tiroir peut seulement
            // revenir à sa hauteur de départ
            const max = extensible() && poignee
                ? Math.max(hauteur_base, Math.min(hauteur_entiere(), window.innerHeight))
                : Math.max(hauteur_base, hauteur)

            geste = {
                depart  : y,
                hauteur,
                visible : null,
                poignee,
                max,
                mode    : null,
                points  : [ { y, temps: performance.now() } ]
            }
        }

        // Par la barre, le tiroir suit le doigt dans les deux sens ; depuis le contenu, vers le
        // bas quand il est tout en haut. Sinon, le contenu défile normalement
        const choisir_mode = (deplacement) =>
        {
            if (geste.poignee)
                return 'glissement'

            const element = defilant()
            const en_haut = !element || element.scrollTop <= 0

            return deplacement > 0 && en_haut ? 'glissement' : 'defilement'
        }

        const deplacer = (y) =>
        {
            geste.points.push({ y, temps: performance.now() })
            if (geste.points.length > 20)
                geste.points.shift()

            geste.visible = geste.hauteur - (y - geste.depart)
            placer(geste.visible)
        }

        // Le premier mouvement décide du geste : la décision doit tomber avant que le
        // navigateur ne commence à faire défiler, tant que touchmove peut encore être annulé
        const bouger = (y, evenement) =>
        {
            if (!geste)
                return

            const deplacement = y - geste.depart

            if (!geste.mode)
            {
                if (deplacement === 0)
                    return

                geste.mode = evenement.cancelable === false ? 'defilement' : choisir_mode(deplacement)
                if (geste.mode === 'glissement')
                {
                    tiroir.classList.add('glissement')
                    geste.depart = y
                }
            }

            if (geste.mode !== 'glissement')
                return

            evenement.preventDefault()
            deplacer(y)
        }

        const finir = () =>
        {
            if (geste?.mode === 'glissement' && geste.visible !== null)
                relacher()
            else
                tiroir.classList.remove('glissement')
            geste = null
        }

        // Toucher : touchmove, contrairement aux évènements de pointeur, peut empêcher le
        // défilement une fois le geste commencé
        tiroir.addEventListener('touchstart', (evenement) =>
        {
            if (evenement.touches.length !== 1)
            {
                geste = null
                return
            }
            debuter(evenement.touches[0].clientX, evenement.touches[0].clientY, evenement.target)
        }, { passive: true })

        tiroir.addEventListener('touchmove', (evenement) =>
        {
            if (evenement.touches.length === 1)
                bouger(evenement.touches[0].clientY, evenement)
        }, { passive: false })

        tiroir.addEventListener('touchend',    finir)
        tiroir.addEventListener('touchcancel', finir)

        // Souris : seulement par l en-tête (la barre)
        const souris_bougee = (evenement) => bouger(evenement.clientY, evenement)

        const souris_relachee = () =>
        {
            document.removeEventListener('pointermove', souris_bougee)
            document.removeEventListener('pointerup',   souris_relachee)
            finir()
        }

        tiroir.addEventListener('pointerdown', (evenement) =>
        {
            if (evenement.pointerType !== 'mouse' || evenement.button !== 0 || !evenement.target.closest('.entete-tiroir'))
                return
            if (evenement.target.closest('button'))
                return

            debuter(evenement.clientX, evenement.clientY, evenement.target)
            if (!geste)
                return

            geste.mode = 'glissement'
            tiroir.classList.add('glissement')
            evenement.preventDefault()
            document.addEventListener('pointermove', souris_bougee)
            document.addEventListener('pointerup',   souris_relachee)
        })

        $vars.souris_bougee   = souris_bougee
        $vars.souris_relachee = souris_relachee
    }

    // Un tiroir retiré (page quittée) se ferme avec lui
    $demonter_tiroir = () =>
    {
        document.removeEventListener('pointermove', $vars.souris_bougee)
        document.removeEventListener('pointerup',   $vars.souris_relachee)
        if ($node.open)
            $node.close()
    }
]

@style [
    /* Tiroir : boîte de dialogue modale, au centre de l écran, avec une croix, pour un
       pointeur précis sur grand écran ; au bas de l écran, en format petit ou au toucher, avec
       une barre au toucher. Le fond grisé (::backdrop) s éclaircit quand le tiroir descend.
       Il se place dans la page sans le menu de gauche (--l-tete), qu il ne couvre jamais : il
       est centré sur ce qui reste, sans dépasser sa largeur */
    .tiroir {
        inset: 0 0 0 var(--l-tete);
        margin: auto;
        width: min(var(--l-tiroir), 100% - var(--l-tete) - 2rem);
        max-width: none;
        max-height: calc(100dvh - 2rem);

        overflow: hidden;
        border-radius: 1.5rem;
        padding: 1rem;
        padding-bottom: calc(1rem + env(safe-area-inset-bottom));

        transform: none;
        opacity: 1;

        transition: transform var(--d-tiroir) ease,
                    opacity   var(--d-tiroir) ease,
                    height    var(--d-tiroir) ease;

        --d-tiroir: var(--d-animation-page);
        --l-tiroir: 32rem;

        --l-fonte: 1rem;
        --l-ecart: 1rem;
        --f-fond:  var(--c-theme);
        --c-fond:  var(--c-theme);
        --c-flux:  var(--c-inverse);
    }

    .tiroir[open] {
        display: flex;
        flex-flow: column nowrap;
    }

    .tiroir::backdrop {
        background: oklch(0 0 0 / 40%);
        opacity: calc(1 - var(--retrait-tiroir, 0));

        transition: opacity var(--d-tiroir) ease;
    }

    /* Extensible : non modal, il se place comme un tiroir modal, par-dessus la page */
    .tiroir.extensible {
        position: fixed;
        z-index: 100;
    }

    @starting-style {
        .tiroir[open] {
            opacity: 0;
            transform: scale(0.95);
        }

        .tiroir[open]::backdrop {
            opacity: 0;
        }
    }

    .tiroir.fermeture {
        opacity: 0;
        transform: scale(0.95);
    }

    .tiroir.fermeture::backdrop {
        opacity: 0;
    }

    .tiroir.glissement,
    .tiroir.glissement::backdrop {
        transition: none;
    }

    .tiroir.glissement {
        max-height: none;
    }

    /* Au bas de l écran */
    :is(.petit, .grossier) .tiroir {
        margin: auto auto 0;
        width: min(var(--l-tiroir), 100% - var(--l-tete));

        border-radius: 1.5rem 1.5rem 0 0;
    }

    /* Sa hauteur est celle de son contenu, sans dépasser tout l écran ; positionné, son haut
       est au moins à --haut-tiroir du haut de l écran (la moitié de l écran au plus), son
       contenu en haut : si son contenu n y tient pas, il prend la hauteur où il tient, ou tout
       l écran. fit-content, comme le style d origine du dialog : en auto, fixé en haut et en
       bas de l écran, il le prendrait tout */
    :is(.petit, .grossier) .tiroir {
        max-height: 100dvh;
    }

    :is(.petit, .grossier) .tiroir.positionne {
        height: fit-content;
        min-height: calc(100dvh - min(var(--haut-tiroir), 50dvh));
    }

    /* Extensible et positionné : la hauteur où il est positionné (même petite), quel que soit
       son contenu ; agrandi, celle où tout son contenu tient (au moins la précédente, au plus
       tout l écran) */
    :is(.petit, .grossier) .tiroir.positionne.extensible {
        height: max(0px, 100dvh - var(--haut-tiroir));
        min-height: 0;
    }

    :is(.petit, .grossier) .tiroir.positionne.extensible.agrandi {
        height: fit-content;
        min-height: max(0px, 100dvh - var(--haut-tiroir));
    }

    @starting-style {
        :is(.petit, .grossier) .tiroir[open] {
            opacity: 1;
            transform: translateY(100%);
        }
    }

    :is(.petit, .grossier) .tiroir.fermeture {
        opacity: 1;
        transform: translateY(100%);
    }

    /* En-tête : la croix pour un pointeur précis, la barre au toucher */
    .tiroir > .entete-tiroir {
        flex: none;
        flex-direction: row;
        justify-content: flex-end;
        align-items: center;
    }

    /* La barre s attrape sur tout le haut du tiroir, de son bord jusqu au contenu : l en-tête
       couvre les marges du tiroir et l écart qui le suit (marge négative et padding de 1rem,
       sans rien changer à la mise en page), par-dessus le défilement du contenu */
    .grossier .tiroir > .entete-tiroir {
        position: relative;
        z-index: 1;
        justify-content: center;

        margin: -1rem;
        padding: 1rem;

        cursor: grab;
        touch-action: none;
    }

    .grossier .tiroir.glissement > .entete-tiroir {
        cursor: grabbing;
    }

    .tiroir .barre-tiroir {
        width: 6rem;
        height: 0.25rem;

        border-radius: 0.125rem;

        --f-fond: var(--c-gris);
    }

    .tiroir .croix-tiroir {
        display: flex;

        border-radius: 0.125rem;

        --c-flux: var(--c-gris);
    }

    .grossier .tiroir .croix-tiroir,
    .precis .tiroir .barre-tiroir {
        display: none;
    }

    /* La piste du menu principal s estompe avec lui pendant la transition (règle plus précise
       que celle du survol, dans defilement) */
    :root dialog.tiroir > .defilement.contenu-tiroir.transition-sous-menu > .piste {
        opacity: 0;
    }

    /* Le menu principal ne défile pas pendant la transition : le sous-menu superposé est posé
       devant sa partie visible */
    :root dialog.tiroir > .defilement.contenu-tiroir.transition-sous-menu {
        overflow-y: hidden;
    }

    /* Lien vers la page affichée (boite-ancre active), en gras */
    .tiroir .boite-ancre.actif {
        --e-fonte: var(--e-gras);
    }

    /* Menu principal caché derrière un sous-menu ouvert */
    .tiroir > .contenu-tiroir > .masque-sous-menu {
        display: none;
    }

    .tiroir > .contenu-tiroir {
        flex: 1 1 auto;
        min-height: 0;

        /* Les vues d un sous-menu glissent sur les côtés sans faire défiler le contenu, coupées
           au bord du tiroir */
        overflow-x: hidden;

        /* none plutôt que contain : pas de rebond du trackpad quand rien ne déborde */
        overscroll-behavior: none;
    }
]

# Tiroir (boîte de dialogue), ouvert par $ouvrir_tiroir($nom) (ou $ouvrir_tiroir($nom, $haut),
# pour placer son haut, au bas de l'écran, à $haut pixels du haut de l'écran) et fermé par
# $fermer_tiroir() (base.avec) : un seul à la fois. Il se ferme aussi par la croix, par la barre
# ou en le glissant vers le bas, par un clic sur le fond grisé, par Échap ou le retour
# d'Android, et à la navigation vers une autre page. Son contenu peut défiler.
# Extensible ($extensible) : non modal, la page restant utilisable (sans fond grisé) ; au bas de
# l'écran, il garde la hauteur où il est positionné (même petite) quel que soit son contenu, et
# sa barre seule l'agrandit jusqu'à montrer tout son contenu (ou tout l'écran), puis le ramène
@args [$nom, $extensible : :(]

$navigation_tiroir = $suivre_navigation_tiroir($path)

<dialog
    .tiroir
    [$extensible] ? .extensible
    data-tiroir="$nom"
    @mount="$monter_tiroir()"
    @unmount="$demonter_tiroir()"
>
    <div .entete-tiroir>
        <div .barre-tiroir>
        <button .croix-tiroir type="button" aria-label="Fermer" @click="$fermer_tiroir()">
            icone-croix

    defilement.contenu-tiroir
        @stud
