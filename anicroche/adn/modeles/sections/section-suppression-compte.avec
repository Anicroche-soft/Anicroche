@script [
    const coordonnee_principale = () =>
        $compte?.coordonnees?.find(coordonnee => coordonnee.est_principale)?.coordonnee ?? null

    // La clef n'est envoyée qu'avec le bon mot de passe
    const envoyer_clef = async (mot_de_passe) =>
    {
        const reponse = await $create('clef', {
            type         : 'effacement',
            coordonnee   : coordonnee_principale(),
            mot_de_passe
        })

        if (!reponse.error)
        {
            $ids_suppression.push(reponse.data.id)
            $date_clef_suppression = Date.now()
        }
        return reponse
    }

    $depart_clef_suppression = () => $date_clef_suppression

    // Suppression refusée pendant les sept jours qui suivent un changement d adresse principale
    // null quand la suppression est possible : un texte vide rendrait la condition vraie
    $date_effacement_possible_suppression = $compte?.date_effacement_possible
        ? $formater_date($compte.date_effacement_possible, true)
        : null

    const lire_erreur_clef = (reponse) =>
    {
        if (!reponse.error)
            return false
        if (reponse.data?.date_effacement_possible)
            return reponse.error
        if (reponse.code === 403)
            return "Mot de passe invalide"
        if (reponse.code === 429)
            return "Veuillez réessayer dans trente secondes"
        return reponse.error ?? "Erreur serveur"
    }

    $envoyer_formulaire_profils_suppression = () =>
    {
        $profils_a_supprimer = new FormData($node).getAll('profils_a_supprimer')

        $basculer_vers_onglet_suivant()
    }

    // La clef n est envoyée qu une fois, même après un retour en arrière (comme à la connexion)
    $envoyer_formulaire_mot_de_passe_suppression = async () =>
    {
        if (!$ids_suppression.length)
        {
            const mot_de_passe = new FormData($node).get('mot_de_passe')
            const reponse      = await envoyer_clef(mot_de_passe)

            if (reponse.error)
            {
                $erreur_mot_de_passe_suppression = lire_erreur_clef(reponse)
                return
            }

            $mot_de_passe_suppression = mot_de_passe
        }

        $erreur_mot_de_passe_suppression = false
        $basculer_vers_onglet_suivant()
    }

    $renvoyer_clef_suppression = async () =>
    {
        const erreur = lire_erreur_clef(await envoyer_clef($mot_de_passe_suppression))

        $succes_clef_suppression = erreur ? false : "Une nouvelle clef a été envoyée"
        $erreur_clef_suppression = erreur
    }

    $envoyer_formulaire_clef_suppression = async () =>
    {
        const reponse = await $create('desinscription', {
            clef                : new FormData($node).get('clef'),
            ids                 : $ids_suppression,
            profils_a_supprimer : $profils_a_supprimer
        })

        if (reponse.error)
        {
            $succes_clef_suppression = false
            $erreur_clef_suppression = reponse.code === 403
                ? "La clef de validation est invalide"
                : reponse.error ?? "Erreur serveur"
            return
        }

        $mot_de_passe_suppression = null
        $date_suppression         = new Date(reponse.data.date_effacement)
            .toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
        $basculer_vers_onglet_suivant()
    }

    $revenir_etape_suppression = () =>
    {
        $erreur_mot_de_passe_suppression = false
        $erreur_clef_suppression         = false
        $succes_clef_suppression         = false
        $basculer_vers_onglet_precedant()
    }
]

@args [$etape]

@if [$etape = profils]
    section [suppression-compte, centree]
        titre [centre]
            "Supprimer votre compte"
        carte
            @if [$date_effacement_possible_suppression]
                information-formulaire
                    "Vous ne pouvez pas supprimer votre compte avant le $date_effacement_possible_suppression, car son adresse électronique principale a changé il y a moins de sept jours. Ce délai vous laisse le temps de réagir si quelqu'un d'autre a pris le contrôle de votre compte."
                ligne
                    bouton-ancre [/compte]
                        icone-fleche-gauche
                        alt
                            "Retour"
            @else
                formulaire [$envoyer_formulaire_profils_suppression]
                    information-formulaire
                        "Votre compte sera suspendu dès votre demande, puis effacé définitivement trente jours plus tard. D'ici là, vous aurez encore la possibilité de restaurer votre compte."
                    @if [_ $choix_profils_suppression > 0]
                        choix-multiple [
                            "Profils", profils_a_supprimer
                            $choix : $choix_profils_suppression
                            $description : "Tous vos profils vont être anonymisés, cochez uniquement ceux que vous voulez supprimer."
                        ]
                    bouton-soumission
                        <span>
                            "Continuer"
                        icone-fleche-droite

@else-if [$etape = mot_de_passe]
    section [suppression-compte, centree]
        titre [centre]
            "Saisissez votre mot de passe"
        carte
            formulaire [$envoyer_formulaire_mot_de_passe_suppression]
                @if [$erreur_mot_de_passe_suppression]
                    erreur-formulaire
                        "$erreur_mot_de_passe_suppression"
                champ-mot-de-passe ["Mot de passe", mot_de_passe]
                ligne
                    bouton-action [$revenir_etape_suppression]
                        icone-fleche-gauche
                        alt
                            "Retour"
                    bouton-soumission
                        <span>
                            "Continuer"
                        icone-fleche-droite

@else-if [$etape = clef]
    section [suppression-compte, centree]
        titre [centre]
            "Saisissez la clef de validation"
        carte
            formulaire [$envoyer_formulaire_clef_suppression]
                @if [$succes_clef_suppression]
                    succes-formulaire
                        "$succes_clef_suppression"
                @if [$erreur_clef_suppression]
                    erreur-formulaire
                        "$erreur_clef_suppression"
                champ-clef ["Clef de validation", clef]
                lien-action [$renvoyer_clef_suppression, 30, $depart_clef_suppression]
                    "Renvoyer la clef"
                alerte-formulaire
                    "Toutes vos sessions seront fermées, celle-ci comprise."
                ligne
                    bouton-action [$revenir_etape_suppression]
                        icone-fleche-gauche
                        alt
                            "Retour"
                    bouton-soumission
                        "Désinscription"

@else-if [$etape = resultat]
    section [suppression-compte, centree]
        titre [centre]
            "Suppression demandée"
        carte
            <p>
                "Votre compte est suspendu et sera effacé définitivement le $date_suppression. Un courriel de confirmation vous a été envoyé."
            <p>
                "Si vous changez d'avis d'ici là, connectez-vous ou utilisez le lien « Restauration du compte » du courriel."
            ligne
                bouton-ancre [/]
                    "Accueil"
