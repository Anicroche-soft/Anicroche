@script [
    $envoyer_formulaire_courriel = async () =>
    {
        $mode_formulaire = $event.submitter.value

        data = new FormData($node)

        if ($mode_formulaire == 'clef')
        {
            const deja_envoyee = $courriels_clefs.has(data.get('courriel'))
            let reponse = null

            if (!deja_envoyee)
            {
                reponse = await $create('clef', {type: 'authentification', coordonnee: data.get('courriel')})
            }

            if (deja_envoyee || !reponse.error)
            {
                if (reponse)
                    $ids.push(reponse.data.id)
                $courriel_formulaire = data.get('courriel')
                $basculer_vers_onglet_suivant()
                $courriels_clefs.add($courriel_formulaire)
            }
            else
            {
                $erreur_courriel = "Veuillez réessayer dans trente secondes"
            }
        }
        else if ($mode_formulaire == 'mot_de_passe')
        {
            $courriel_formulaire = data.get('courriel')
            $basculer_vers_onglet_suivant()
        }
    }

    $envoyer_formulaire_mot_de_passe = async () =>
    {
        data = new FormData($node)

        let reponse = await $create('connexion', {
            coordonnee: data.get('courriel'),
            mot_de_passe: data.get('mot_de_passe')
        })

        if (reponse.error)
        {
            $erreur_mot_de_passe = "L'adresse électronique ou le mot de passe est invalide"
        }
    }

    $renvoyer_clef = async () =>
    {
        let reponse = await $create('clef', {type: 'authentification', coordonnee: $courriel_formulaire})

        if (!reponse.error)
        {
            $ids.push(reponse.data.id)
            $succes_clef   = "Une nouvelle clef a été envoyée"
            $erreur_clef = false
        }
        else
        {
            $erreur_clef = "Veuillez réessayer dans trente secondes"
            $succes_clef   = false
        }
    }

    $envoyer_formulaire_clef = async () =>
    {
        data = new FormData($node)
        $clef_formulaire = data.get('clef')

        let reponse = await $create('authentification', {
            coordonnee: data.get('courriel'),
            clef: data.get('clef'),
            ids: $ids
        })

        if (!reponse.error)
        {
            type = reponse.data?.type
            if (type == 'inscription')
            {
                $basculer_vers_onglet_suivant()
            }
            else if (type == 'connexion')
            {
                reponse = await $create('connexion', {
                    coordonnee: data.get('courriel'),
                    clef: data.get('clef'),
                    ids: $ids
                })
                if (reponse.error)
                {
                    $succes_clef = false
                    $erreur_clef = "Erreur serveur"
                }
            }
            else
            {
                $succes_clef = false
                $erreur_clef = "Réponse serveur invalide"
            }
        }
        else
        {
            $succes_clef = false
            $erreur_clef = "La clef de validation est invalide"
        }
    }

    // Même âge minimum que l API, qui vérifie aussi : voir age_minimum dans index.sans
    const AGE_MINIMUM = 15

    const calculer_age = (date_naissance) =>
    {
        const [annee, mois, jour] = String(date_naissance).split('-').map(Number)
        const maintenant = new Date()
        const anniversaire_passe = maintenant.getMonth() + 1 > mois
                                || (maintenant.getMonth() + 1 === mois && maintenant.getDate() >= jour)
        return maintenant.getFullYear() - annee - (anniversaire_passe ? 0 : 1)
    }

    $envoyer_formulaire_naissance = () =>
    {
        const data = new FormData($node)
        $date_naissance_formulaire = data.get('date_naissance')
        $age_insuffisant = calculer_age($date_naissance_formulaire) < AGE_MINIMUM
        $basculer_vers_onglet_suivant()
    }

    $envoyer_formulaire_inscription = () =>
    {
        const data = new FormData($node)
        $mot_de_passe_formulaire = data.get('mot_de_passe')
        $erreur_conditions = false
        $basculer_vers_onglet_suivant()
    }

    $envoyer_formulaire_conditions = async () =>
    {
        const data = new FormData($node)

        let reponse = await $create('inscription', {
            type_coordonnee    : 'courriel',
            coordonnee         : $courriel_formulaire,
            clef               : $clef_formulaire,
            mot_de_passe       : $mot_de_passe_formulaire,
            date_naissance     : $date_naissance_formulaire,
            accepte_conditions : data.get('conditions') === 'oui',
            ids                : $ids
        })

        if (reponse.error)
        {
            $erreur_conditions = reponse.code === 403 && reponse.error === 'Accès refusé'
                ? "La clef de validation a expiré"
                : reponse.error ?? "Erreur serveur"
            return
        }

        reponse = await $create('connexion', {
            coordonnee   : $courriel_formulaire,
            mot_de_passe : $mot_de_passe_formulaire
        })

        if (reponse.error)
            $erreur_conditions = "La connexion a échoué"
    }

    $revenir_a_l_etape_precedente = () =>
    {
        $basculer_vers_onglet_precedant()
    }

    $basculer_vers_section_courriel = () =>
    {
        $erreur_courriel = false
        $basculer_vers_onglet_precedant()
    }

    $basculer_vers_section_clef = () =>
    {
        $succes_clef = false
        $erreur_clef = false
        $basculer_vers_onglet_precedant()
    }
]

@args [$etape]

@if [$etape = courriel]
    section [connexion, centree]
        titre [centre]
            "Connectez-vous ou inscrivez-vous"
        carte
            formulaire [$envoyer_formulaire_courriel]
                @if [$erreur_courriel]
                    erreur-formulaire
                        "$erreur_courriel"
                champ-courriel ["Adresse électronique", courriel]
                bouton-soumission [clef]
                    <span>
                        "Continuer"
                    icone-fleche-droite
                lien-soumission [mot_de_passe]
                    "Me connecter avec mon mot de passe"

@else-if [$etape = mot_de_passe]
    section [connexion, centree]
        titre [centre]
            "Saisissez votre mot de passe"
        carte
            formulaire [$envoyer_formulaire_mot_de_passe]
                @if [$erreur_mot_de_passe]
                    erreur-formulaire
                        "$erreur_mot_de_passe"
                champ-courriel [
                    "Adresse électronique", courriel
                    $valeur : $courriel_formulaire
                    $modifiable : :(
                ]
                champ-mot-de-passe ["Mot de passe", mot_de_passe]
                ligne
                    bouton-action [$basculer_vers_section_courriel]
                        icone-fleche-gauche
                        alt
                            "Retour"
                    bouton-soumission
                        "Me connecter"

@else-if [$etape = clef]
    section [connexion, centree]
        titre [centre]
            "Saisissez la clef de validation"
        carte
            formulaire [$envoyer_formulaire_clef]
                @if [$succes_clef]
                    succes-formulaire
                        "$succes_clef"
                @if [$erreur_clef]
                    erreur-formulaire
                        "$erreur_clef"
                champ-courriel [
                    "Adresse électronique", courriel
                    $valeur : $courriel_formulaire
                    $modifiable : :(
                ]
                champ-clef ["Clef de validation", clef]
                lien-action [$renvoyer_clef, 30]
                    "Renvoyer la clef"
                ligne
                    bouton-action [$basculer_vers_section_courriel]
                        icone-fleche-gauche
                        alt
                            "Retour"
                    bouton-soumission
                        <span>
                            "Continuer"
                        icone-fleche-droite

@else-if [$etape = naissance]
    section [connexion, centree]
        titre [centre]
            "Indiquez votre date de naissance"
        carte
            formulaire [$envoyer_formulaire_naissance]
                champ-date [
                    "Date de naissance", date_naissance
                    $valeur : $date_naissance_formulaire
                    $indice : "Elle sert à vérifier votre âge et à adapter l'accès à certains contenus."
                ]
                ligne
                    bouton-action [$basculer_vers_section_clef]
                        icone-fleche-gauche
                        alt
                            "Retour"
                    bouton-soumission
                        <span>
                            "Continuer"
                        icone-fleche-droite

@else-if [$etape = age_insuffisant]
    section [connexion, centree]
        titre [centre]
            "Inscription impossible pour le moment"
        carte
            <p>
                "Anicroche est réservé aux personnes de 15 ans et plus. Les comptes sous contrôle parental, qui permettront aux plus jeunes de s'inscrire, ne sont pas encore disponibles."
            ligne
                bouton-action [$revenir_a_l_etape_precedente]
                    icone-fleche-gauche
                    alt
                        "Retour"

@else-if [$etape = inscription]
    section [connexion, centree]
        titre [centre]
            "Définissez un mot de passe fort"
        carte
            formulaire [$envoyer_formulaire_inscription]
                champ-courriel [
                    "Adresse électronique", courriel
                    $valeur : $courriel_formulaire
                    $modifiable : :(
                ]
                champ-mot-de-passe [
                    "Mot de passe", mot_de_passe
                    $longueur_minimale : 12
                    $longueur_maximale : 128
                ]
                ligne
                    bouton-action [$revenir_a_l_etape_precedente]
                        icone-fleche-gauche
                        alt
                            "Retour"
                    bouton-soumission
                        <span>
                            "Continuer"
                        icone-fleche-droite

@else-if [$etape = conditions]
    section [connexion, centree]
        titre [centre]
            "Acceptez les conditions d'utilisation"
        carte
            formulaire [$envoyer_formulaire_conditions]
                @if [$erreur_conditions]
                    erreur-formulaire
                        "$erreur_conditions"
                case-a-cocher [$nom : conditions, $requis : :)]
                    "J'ai lu et j'accepte les "
                    <a href="/conditions-generales-d-utilisation" target="_blank" rel="noopener">
                        "conditions d'utilisation"
                    "."
                <p .information>
                    "Vos données sont traitées comme l'explique la "
                    <a href="/politique-de-confidentialite" target="_blank" rel="noopener">
                        "politique de confidentialité"
                    "."
                ligne
                    bouton-action [$revenir_a_l_etape_precedente]
                        icone-fleche-gauche
                        alt
                            "Retour"
                    bouton-soumission
                        "Créer le compte"
