@script [
    const LIMITE_RACINES = 5

    $erreur_edition_profil = false

    const id_profil_edite   = $profil.id
    const identifiant_actuel = $profil.identifiant
    const separateur         = identifiant_actuel.indexOf('.')
    const base_actuelle      = separateur > 0 ? identifiant_actuel.slice(0, separateur) : null

    $type_edition       = base_actuelle ? 'derive' : 'racine'
    $base_edition       = base_actuelle
    $nom_edition        = base_actuelle ? identifiant_actuel.slice(separateur + 1) : identifiant_actuel
    $choix_type_edition = false
    $a_des_derives_edition         = false
    $identifiant_modifie_edition   = false

    const racines_gerees = $compte.is_gerant_of_profils.filter(profil => !profil.identifiant.includes('.'))

    // La base actuelle reste proposée même si le compte ne gère pas ce profil racine
    const bases = racines_gerees
        .filter(profil => profil.id !== id_profil_edite)
        .map(profil => profil.identifiant)
    if (base_actuelle && !bases.includes(base_actuelle))
        bases.unshift(base_actuelle)
    $options_edition = bases.map(base => ({ etiquette: base, nom: base }))

    // $nombre_derives_edition est chargé par la page avant son affichage
    if (base_actuelle)
        $choix_type_edition = racines_gerees.length < LIMITE_RACINES
    else
    {
        $choix_type_edition    = $nombre_derives_edition === 0 && $options_edition.length > 0
        $a_des_derives_edition = $nombre_derives_edition > 0
    }

    // Le type est lu dans le formulaire : l'événement input précède le change qui met à jour $type_edition
    const lire_identifiant = (data) =>
        (data.get('type') ?? $type_edition) === 'derive'
            ? `${data.get('base')}.${data.get('identifiant')}`
            : data.get('identifiant')

    $suivre_identifiant_edition = () =>
    {
        $identifiant_modifie_edition = lire_identifiant(new FormData($node.closest('form'))) !== identifiant_actuel
    }

    $mettre_a_jour_type_edition = () =>
    {
        $type_edition = $node.value
    }

    // Envoie la modification ; renvoie le message d erreur à afficher, ou rien en cas de succès
    const envoyer = async (corps) =>
    {
        const reponse = await $update(`profil/${encodeURIComponent(id_profil_edite)}`, corps)

        if (reponse.error)
            return reponse.code === 429
                ? "Trop de tentatives, veuillez réessayer plus tard"
                : reponse.error ?? "La modification du profil a échoué"

        const reponse_compte = await $search('moi')
        if (!reponse_compte.error)
        {
            $compte = reponse_compte.data
            $selectionner_profil(id_profil_edite)
        }
        $navigate_to('/profil')
    }

    // Un nouvel identifiant passe par le second onglet, qui demande le mot de passe
    $envoyer_formulaire_edition = async () =>
    {
        const noeud       = $node
        const data        = new FormData(noeud)
        const pseudonyme  = String(data.get('pseudonyme') ?? '').trim()
        const identifiant = lire_identifiant(data)

        if (!pseudonyme)
        {
            $erreur_edition_profil = "Le nom d'affichage est obligatoire"
            return
        }

        if (identifiant !== identifiant_actuel)
        {
            $erreur_edition_profil      = false
            $erreur_mot_de_passe_profil = false
            $modification_profil        = { identifiant, pseudonyme }
            $basculer_vers_onglet_suivant(noeud)
            return
        }

        $erreur_edition_profil = await envoyer({ identifiant, pseudonyme }) ?? false
    }

    $envoyer_formulaire_mot_de_passe_profil = async () =>
    {
        $erreur_mot_de_passe_profil = await envoyer({
            ...$modification_profil,
            mot_de_passe : new FormData($node).get('mot_de_passe')
        }) ?? false
    }

    $revenir_edition_profil = () =>
    {
        $erreur_mot_de_passe_profil = false
        $basculer_vers_onglet_precedant()
    }
]

@style [
    .section-edition-profil .champ[data-disabled] {
        display: none;
    }

    .section-edition-profil .identifiant {
        display: contents;
    }
]

# $etape : informations (identifiant et nom d'affichage), ou mot_de_passe (confirmation d'un
# nouvel identifiant)
@args [$etape : informations]

@if [$etape = mot_de_passe]
    section [edition-profil, centree]
        titre [centre]
            "Confirmez le nouvel identifiant"
        carte
            formulaire [$envoyer_formulaire_mot_de_passe_profil]
                @if [$erreur_mot_de_passe_profil]
                    erreur-formulaire
                        "$erreur_mot_de_passe_profil"
                champ-mot-de-passe ["Mot de passe", mot_de_passe]
                ligne
                    bouton-action [$revenir_edition_profil]
                        icone-fleche-gauche
                        alt
                            "Retour"
                    bouton-soumission
                        "Éditer le profil"

@else
    section [edition-profil, centree]
        titre [centre]
            "Éditez votre profil"
        carte
            formulaire [$envoyer_formulaire_edition]
                @if [$erreur_edition_profil]
                    erreur-formulaire
                        "$erreur_edition_profil"
                <div .identifiant @input="$suivre_identifiant_edition()">
                    @if [$choix_type_edition]
                        choix-unique [
                            "Type de profil", type
                            $choix : [
                                {etiquette : "Nouveau", nom : racine}
                                {etiquette : "Suffixé", nom : derive}
                            ]
                            $valeur : $type_edition
                            $action : $mettre_a_jour_type_edition()
                        ]
                    ligne
                        choix-option [
                            "Base", base
                            $choix : $options_edition
                            $valeur : $base_edition
                            $desactive : $type_edition = racine
                            $prefixe : @
                        ]
                        champ-texte [
                            $etiquette : [$type_edition = racine] ? "Identifiant unique" : "Suffixe"
                            identifiant
                            $valeur : $nom_edition
                            $prefixe : [$type_edition = racine] ? @ : .
                            $regle : "/^(?=.{1,32}$)(?=[a-z0-9-]*[a-z])[a-z0-9]+(?:-[a-z0-9]+)*$/"
                            $indice : "Autorisés : a-z, 0-9, -"
                        ]
                champ-texte [
                    "Nom d'affichage", pseudonyme
                    $valeur : $profil.pseudonyme
                ]
                @if [$a_des_derives_edition & $identifiant_modifie_edition]
                    alerte-formulaire
                        "En éditant le profil, tous les profils dérivés seront également renommés."
                bouton-soumission
                    @if [$identifiant_modifie_edition]
                        <span>
                            "Continuer"
                        icone-fleche-droite
                    @else
                        "Éditer le profil"
