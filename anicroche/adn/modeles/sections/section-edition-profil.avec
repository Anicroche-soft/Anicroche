@script [
    $erreur_edition_profil = false

    $envoyer_formulaire_edition = async () =>
    {
        const data       = new FormData($node)
        const id_profil  = $profil.id
        const pseudonyme = String(data.get('pseudonyme') ?? '').trim()

        if (!pseudonyme)
        {
            $erreur_edition_profil = "Le nom d'affichage est obligatoire"
            return
        }

        const reponse = await $update(`profil/${encodeURIComponent(id_profil)}`, { pseudonyme })

        if (reponse.error)
        {
            $erreur_edition_profil = reponse.error ?? "La modification du profil a échoué"
            return
        }

        const reponse_compte = await $search('moi')
        if (!reponse_compte.error)
        {
            $compte = reponse_compte.data
            $selectionner_profil(id_profil)
        }
        $navigate_to('/profil')
    }
]

section [edition-profil, centree]
    titre [centre]
        "Éditez votre profil"
    carte
        formulaire [$envoyer_formulaire_edition]
            @if [$erreur_edition_profil]
                erreur-formulaire
                    "$erreur_edition_profil"
            champ-texte [
                "Identifiant", identifiant
                $valeur : $profil.identifiant
                $modifiable : :(
                $prefixe : @
                $indice : "L'identifiant ne peut pas être modifié"
            ]
            champ-texte [
                "Nom d'affichage", pseudonyme
                $valeur : $profil.pseudonyme
            ]
            bouton-soumission
                "Enregistrer"
