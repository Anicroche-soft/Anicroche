@script [
    $deconnecter_compte = async () =>
    {
        const reponse = await $create('deconnexion')

        if (!reponse.error)
        {
            $navigate_to("/")
        }
    }

    // L API renvoie la principale, puis les autres par ordre alphabétique
    $adresses_compte       = $compte?.coordonnees ?? []
    $etiquette_adresses    = $adresses_compte.length > 1 ? "Adresses électroniques" : "Adresse électronique"
    $date_naissance_compte = $formater_date($compte?.date_naissance)
]

@style [
    .section-compte .informations {
        --l-ecart: 1rem;
    }

    .section-compte .information {
        --l-ecart: 0.5rem;
    }

    .section-compte .information > span:not(.etiquette) {
        overflow-wrap: anywhere;
    }
]

section [compte]
    titre
        "Votre compte"
    carte
        <div .informations>
            <div .information>
                <span .etiquette>
                    "Date de naissance"
                <span>
                    "$date_naissance_compte"
            <div .information>
                <span .etiquette>
                    "$etiquette_adresses"
                @for-each [$adresse] of [$adresses_compte]
                    <span>
                        "$adresse.coordonnee"
        ligne
            bouton-ancre [/compte/edition]
                "Modifier le compte"
            bouton-ancre [/compte/suppression]
                "Supprimer le compte"
            bouton-action [$deconnecter_compte]
                "Déconnexion"
