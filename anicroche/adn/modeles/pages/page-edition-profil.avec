@script [
    // Nombre de profils dérivés du profil édité, s il est racine : chargé avant l affichage de
    // la page, le routeur montre d ici là son modèle d attente
    $nombre_derives_edition = 0
    if ($profil && !$profil.identifiant.includes('.'))
    {
        const reponse = await $search(`profil/${encodeURIComponent($profil.id)}/derives`)
        $nombre_derives_edition = reponse.error ? 0 : reponse.data?.nombre ?? 0
    }
]

$titre = "Édition de profil"
$puce  = profil

page [$authentification : requise]
    navigation
        <div .gauche>
            fleche-retour [/profil]

        <div .centre>
            <span>
                "Édition de profil"

        <div .droite>
            icone-horloge

    onglet
        section-edition-profil
