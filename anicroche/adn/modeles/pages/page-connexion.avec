@script [
    $mode_formulaire = null

    $courriel_formulaire       = ''
    $clef_formulaire           = ''
    $date_naissance_formulaire = ''
    $mot_de_passe_formulaire   = ''
    $age_insuffisant           = false
    $ids           = []

    $courriels_clefs     = new Set()

    $erreur_courriel     = false
    $erreur_mot_de_passe = false
    $succes_clef         = false
    $erreur_clef         = false
    $erreur_conditions   = false
]

page [:(, $authentification : interdite]
    navigation
        <div .gauche>
            fleche-retour

        <div .centre>
            <span>
                "Connexion"

        # <div .droite>
        #     boite-ancre [/preferences, Préférences]
        #         icone-engrenage

    onglet
        section-connexion [courriel]

    onglet
        @if [$mode_formulaire = clef]
            section-connexion [clef]
        @else-if [$mode_formulaire = mot_de_passe]
            section-connexion [mot_de_passe]

    onglet
        section-connexion [naissance]

    onglet
        @if [$age_insuffisant]
            section-connexion [age_insuffisant]
        @else
            section-connexion [inscription]

    onglet
        section-connexion [conditions]
