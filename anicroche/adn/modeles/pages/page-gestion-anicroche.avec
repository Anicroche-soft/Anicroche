@script [
    // interdite, introuvable ou prete
    $etat_gestion                = 'introuvable'
    $anicroche_gestion           = null
    $type_gestion                = null
    $acces_gestion               = 'prive'
    $brouillon_gestion           = null
    $versions_gestion            = []
    $date_parution_gestion       = ''
    $sources_brouillon           = []
    $ajouts_edition              = []
    $adresse_gestion_anicroche   = ''
    $adresse_edition_anicroche   = ''
    $adresse_brouillon_anicroche = ''

    // Accès de l anicroche entière
    $choix_acces_gestion = [
        { nom: 'prive',   etiquette: "Privé : seulement ses gérants" },
        { nom: 'partage', etiquette: "Partagé : par son lien, sans être listé" },
        { nom: 'public',  etiquette: "Public : visible et listé partout" }
    ]

    // Accès d une version ; une version programmée peut aussi être privée jusqu à sa parution,
    // puis publique
    const CHOIX_ACCES_VERSION = [
        { nom: 'prive',   etiquette: "Privée" },
        { nom: 'partage', etiquette: "Partagée" },
        { nom: 'public',  etiquette: "Publique" }
    ]
    const CHOIX_ACCES_PROGRAMME = [
        ...CHOIX_ACCES_VERSION,
        { nom: 'programme', etiquette: "Programmée" }
    ]

    // Choix permis par l API (voir versions.sans), en lecture seule s il n y en a qu un : une
    // version parue d une page légale est publique, une version programmée d une page soumise
    // au préavis aussi (elle est annoncée), celle d une autre page légale publique ou programmée
    const choix_acces = (anicroche, etat) =>
    {
        if (etat === 'a_paraitre' && anicroche.preavis)
            return CHOIX_ACCES_VERSION.filter(choix => choix.nom === 'public')
        if (etat === 'a_paraitre' && anicroche.legale)
            return CHOIX_ACCES_PROGRAMME.filter(choix => choix.nom === 'public' || choix.nom === 'programme')
        if (etat === 'a_paraitre')
            return CHOIX_ACCES_PROGRAMME
        if (etat !== 'brouillon' && anicroche.legale)
            return CHOIX_ACCES_VERSION.filter(choix => choix.nom === 'public')
        return CHOIX_ACCES_VERSION
    }

    // Premier segment de l adresse, commun aux onglets (/<id>/gestion, /<id>/edition)
    const lire_segment = () => $path.split('/')[1] ?? ''

    // Lignes du tableau des versions, de la plus récente à la plus ancienne : le brouillon
    // (programmé ou non), puis les versions parues. Chacune a son état (brouillon, a_paraitre,
    // en_vigueur ou ancienne, comme le menu des versions de page-anicroche), son lien, sa date
    // (seul texte affiché, « Brouillon » ou « À l essai » pour le brouillon ; alt la précise
    // pour les lecteurs d écran) et son choix d accès ; une parution programmée se déprogramme,
    // sauf pour une page soumise au préavis
    const lister_versions = (anicroche, chemin) =>
    {
        // Un brouillon public est à l essai : lisible de tous avant sa parution
        const sans_date = (version) => version.acces === 'public' ? "À l'essai" : "Brouillon"

        const entree = (version, etat, alt) => ({
            numero         : version.numero,
            etat,
            texte          : version.date_parution ? $formater_date(version.date_parution) : sans_date(version),
            texte_court    : version.date_parution ? $formater_date(version.date_parution, false, true) : sans_date(version),
            date           : version.date_parution ?? null,
            acces          : version.acces,
            choix          : choix_acces(anicroche, etat),
            verrouille     : choix_acces(anicroche, etat).length === 1,
            nom            : `acces-${version.numero}`,
            lien           : version.numero === anicroche.en_vigueur ? chemin : `${chemin}/${version.numero}`,
            alt            : alt ? `Version ${alt}` : '',
            etiquette      : alt
                ? `Accès de la version ${alt} ${$formater_date(version.date_parution)}`
                : "Accès du brouillon",
            deprogrammable : etat === 'a_paraitre' && !anicroche.preavis
        })

        const entrees   = []
        const brouillon = anicroche.brouillon
        if (brouillon && brouillon.date_parution)
            entrees.push(entree(brouillon, 'a_paraitre', "à paraître le"))
        else if (brouillon)
            entrees.push(entree(brouillon, 'brouillon', ''))

        for (const version of anicroche.versions ?? [])
            entrees.push(version.numero === anicroche.en_vigueur
                ? entree(version, 'en_vigueur', "en vigueur depuis le")
                : entree(version, 'ancienne', "du"))

        return entrees
    }

    // Sources du brouillon, avec le nom et l étiquette de leur champ, et boutons d ajout des
    // rôles qui n ont pas atteint leur maximum
    const preparer_edition = (type, brouillon) =>
    {
        $sources_brouillon = $lister_sources_anicroche(type, brouillon?.sources)
            .map(source => ({
                ...source,
                nom       : `source-${source.role}-${source.position}`,
                etiquette : source.max === 1 ? source.libelle : `${source.libelle} ${source.position}`
            }))
        $ajouts_edition    = type.sources
            .filter(source => source.max === null || $sources_brouillon.filter(element => element.role === source.role).length < source.max)
            .map(source => ({ role: source.role, etiquette: `Ajouter : ${source.libelle}` }))
    }

    // Chargée avant l affichage de la page, puis rechargée après chaque action de l un ou
    // l autre onglet. Avec attente, une promesse, l onglet Gestion n est mis à jour qu une fois
    // celle-ci tenue (voir $creer_brouillon)
    $charger_gestion = async (attente = null) =>
    {
        const segment = lire_segment()
        const racine  = `/${segment}`

        // Les boutons des onglets ont leur adresse quel que soit l état de la page
        $adresse_gestion_anicroche = `${racine}/gestion`
        $adresse_edition_anicroche = `${racine}/edition`

        // Sans profil, aucun type ne peut être administré
        if (!$profil)
        {
            $etat_gestion = 'interdite'
            return
        }

        const id = $lire_identifiant_anicroche(segment)
        if (!id)
        {
            $etat_gestion = 'introuvable'
            return
        }

        // Un type inconnu fait recharger les types de l API, et reste introuvable s il en est
        // toujours absent
        const reponse = await $charger_anicroche(id)

        // Une réponse arrivée après une navigation vers une autre adresse que les onglets de
        // cette anicroche est ignorée
        if (lire_segment() !== segment)
            return

        if (reponse.code !== 200)
        {
            $etat_gestion = 'introuvable'
            return
        }

        // Le droit vient de l administration du type ; l API le vérifie de son côté
        if (!$administre_type(reponse.data.type))
        {
            $etat_gestion = 'interdite'
            return
        }

        const brouillon = reponse.data.brouillon

        preparer_edition(reponse.type, brouillon)

        $anicroche_gestion           = reponse.data
        $type_gestion                = reponse.type
        $date_parution_gestion       = brouillon?.date_parution ? $formater_date(brouillon.date_parution, true) : ''
        $adresse_brouillon_anicroche = brouillon ? `${racine}/${brouillon.numero}` : ''

        const mettre_a_jour_gestion = () =>
        {
            $acces_gestion     = reponse.data.acces ?? 'prive'
            $brouillon_gestion = brouillon
            $versions_gestion  = lister_versions(reponse.data, racine)
        }

        if (attente)
            attente.then(mettre_a_jour_gestion)
        else
            mettre_a_jour_gestion()

        $etat_gestion = 'prete'
    }

    // La page n est affichée qu une fois l anicroche chargée : le routeur montre d ici là son
    // modèle d attente
    await $charger_gestion()
]

@if [$type_gestion]
    $titre = [$path = $adresse_edition_anicroche] ? "Édition : $type_gestion.libelle" : "Gestion : $type_gestion.libelle"
@else
    $titre = [$path = $adresse_edition_anicroche] ? "Édition" : "Gestion"
$puce = creer

page [$authentification : requise_sans_profil]
    navigation
        <div .gauche>
            fleche-retour

        <div .centre>
            barre-onglets
                bouton-onglet [$adresse_gestion_anicroche]
                    <span>
                        "Gestion"
                bouton-onglet [$adresse_edition_anicroche]
                    <span>
                        "Édition"

    onglet
        @if [$etat_gestion = interdite]
            section [gestion-interdite, centree]
                titre [centre]
                    "Vous ne pouvez pas gérer ce contenu"

        @else-if [$etat_gestion = introuvable]
            section [gestion-introuvable, centree]
                titre [centre]
                    "Contenu introuvable !"

        @else
            section-versions-anicroche
            section-acces-anicroche

    onglet
        @if [$etat_gestion = interdite]
            section [edition-interdite, centree]
                titre [centre]
                    "Vous ne pouvez pas modifier ce contenu"

        @else-if [$etat_gestion = introuvable]
            section [edition-introuvable, centree]
                titre [centre]
                    "Contenu introuvable !"

        @else
            section-edition-anicroche
