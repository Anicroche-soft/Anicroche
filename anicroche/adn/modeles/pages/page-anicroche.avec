@script [
    // chargement, introuvable, non_publiee ou trouvee
    $etat_anicroche          = 'chargement'
    $anicroche               = null
    $contenu_anicroche       = ''
    $chemin_anicroche_charge = null

    // Le modèle reste en place quand on passe d une anicroche à une autre :
    // le chargement suit donc $path plutôt que l exécution du script
    $charger_anicroche = async () =>
    {
        const chemin = $path
        $chemin_anicroche_charge = chemin
        $etat_anicroche = 'chargement'

        const id = $lire_identifiant_anicroche(chemin.slice(1))
        if (!id)
        {
            $etat_anicroche = 'introuvable'
            return
        }

        const reponse = await $search(`anicroche/${encodeURIComponent(id)}`)

        // Une réponse arrivée après une nouvelle navigation est ignorée
        if ($path !== chemin)
            return

        // Seules les pages ont un affichage pour l instant
        if (reponse.code !== 200 || reponse.data?.type !== 'page')
        {
            $etat_anicroche = 'introuvable'
            return
        }

        $anicroche         = reponse.data
        $contenu_anicroche = reponse.data.sources?.contenu?.contenu ?? ''

        // Seuls les gérants de @anicroche reçoivent une page qui n a pas encore de version publiée
        $etat_anicroche = reponse.data.version === null ? 'non_publiee' : 'trouvee'
    }
]

@if [$path != $chemin_anicroche_charge]
    <div hidden @mount="$charger_anicroche()">

@if [$etat_anicroche = introuvable]
    page-404

@else
    page
        navigation
            <div .gauche>
                fleche-retour

            <div .centre>
                <span>
                    "Page"

        onglet
            @if [$etat_anicroche = chargement]
                section-chargement

            @else-if [$etat_anicroche = non_publiee]
                section [anicroche-non-publiee, centree]
                    titre [centre]
                        "Cette page n'est pas encore publiée"

            @else
                section [anicroche]
                    texte-mis-en-forme [$contenu_anicroche]
