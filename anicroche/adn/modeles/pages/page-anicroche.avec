@script [
    // introuvable, non_publiee ou trouvee
    $etat_anicroche         = 'introuvable'
    $anicroche              = null
    $libelle_anicroche      = ''
    $titre_page_anicroche   = ''
    $texte_anicroche        = []
    $description_anicroche  = null
    $gerant_anicroche       = false
    $lien_gestion_anicroche = ''
    $lien_edition_anicroche = ''

    // Barre d informations : auteurs, lien vers une autre version et date de parution de la
    // version affichée
    $auteurs_anicroche    = []
    $lien_version         = ''
    $texte_lien_version   = ''
    $date_anicroche       = null

    // /<id> montre la version en vigueur, /<id>/<numero> une version précise : le lien mène à
    // la version en vigueur depuis une version qui ne l est pas, et sinon à la version à
    // paraître ou à l essai (brouillon public). Les gérants de l anicroche (auteurs, ou profils
    // qui administrent son type) reçoivent aussi son brouillon : /<id> en montre l aperçu tant
    // qu aucune version n est parue
    const preparer_lien_version = (anicroche, affichee, chemin) =>
    {
        const lien = (texte, adresse) =>
        {
            $texte_lien_version = texte
            $lien_version       = adresse
        }

        lien('', '')

        if (affichee !== null && affichee !== anicroche.en_vigueur && anicroche.en_vigueur !== null)
            lien("Voir la version en vigueur", chemin)
        else if (anicroche.a_venir && anicroche.a_venir.numero !== affichee)
            lien(`Voir la version à paraître le ${$formater_date(anicroche.a_venir.date_parution)}`, `${chemin}/${anicroche.a_venir.numero}`)
        else if (anicroche.a_l_essai && anicroche.a_l_essai.numero !== affichee)
            lien("Voir la version à l'essai", `${chemin}/${anicroche.a_l_essai.numero}`)
    }

    // Début du premier contenu qui n est pas un titre, repris par les moteurs de recherche
    const resumer = (sources) =>
    {
        const contenu = sources.find(source => source.format !== 'titre')?.contenu ?? ''
        const texte   = String(contenu).replace(/\s+/g, ' ').trim()
        if (texte.length <= 160)
            return texte || null
        return `${texte.slice(0, 160).replace(/\s+\S*$/, '')}…`
    }

    // Le routeur reconstruit la page à chaque adresse (@key) : /<id> ou /<id>/<numero>
    const charger_anicroche = async () =>
    {
        const adresse                   = $path
        const [ segment, version = '' ] = adresse.slice(1).split('/')
        const chemin                    = `/${segment}`

        const id = $lire_identifiant_anicroche(segment)
        if (!id || (version !== '' && !/^[1-9][0-9]*$/.test(version)))
        {
            $etat_anicroche = 'introuvable'
            return
        }

        // Un type inconnu fait recharger les types de l API, et reste introuvable s il en est
        // toujours absent
        const reponse = await $charger_anicroche(id, version === '' ? null : Number(version))
        const type    = reponse.type

        // Une réponse arrivée après une nouvelle navigation est ignorée
        if ($path !== adresse)
            return

        if (reponse.code !== 200)
        {
            $etat_anicroche = 'introuvable'
            return
        }

        // Sans version visible, un gérant voit l aperçu du brouillon
        const apercu  = reponse.data.version === null ? reponse.data.brouillon ?? null : null
        const sources = apercu ? apercu.sources : reponse.data.sources
        const listees = $lister_sources_anicroche(type, sources)
            .filter(source => String(source.contenu ?? '').trim() !== '')

        $anicroche         = reponse.data
        $libelle_anicroche = type.libelle

        // Une version parue avant la source de titre de son type prend le titre de son exception
        // (voir $titre_anicroche) ; l aperçu prend celui de son brouillon
        $titre_page_anicroche  = listees.find(source => source.format === 'titre')?.contenu
            ?? (apercu ? $titre_anicroche(reponse.data, apercu.sources) : reponse.data.titre)
        $texte_anicroche       = listees.filter(source => source.format !== 'titre')
        $description_anicroche = resumer(listees)
        preparer_lien_version(reponse.data, apercu ? apercu.numero : reponse.data.version, chemin)

        // Les auteurs ne sont pas encore lisibles par la projection ; seule une version datée
        // a une date
        $auteurs_anicroche = []
        $date_anicroche    = apercu ? apercu.date_parution : reponse.data.date_parution

        // La gestion et l édition sont réservées aux gérants ; l API le vérifie de son côté
        $gerant_anicroche       = $administre_type(reponse.data.type)
        $lien_gestion_anicroche = `${chemin}/gestion`
        $lien_edition_anicroche = `${chemin}/edition`

        // Une page sans version visible n est renvoyée qu à ses gérants, ou quand sa parution
        // est annoncée
        $etat_anicroche = reponse.data.version === null && !apercu ? 'non_publiee' : 'trouvee'
    }

    // La page n est affichée qu une fois l anicroche chargée : le routeur montre d ici là son
    // modèle d attente
    await charger_anicroche()
]

@if [$etat_anicroche = introuvable]
    page-404

@else
    $titre       = $titre_page_anicroche
    $description = $description_anicroche
    $puce        = accueil

    page
        navigation
            <div .gauche>
                fleche-retour

            <div .centre>
                <span>
                    "$libelle_anicroche"

        onglet
            section [anicroche]
                titre
                    "$titre_page_anicroche"
                carte
                    informations-anicroche [
                        $auteurs    : $auteurs_anicroche
                        $lien       : $lien_version
                        $texte_lien : $texte_lien_version
                        $date       : $date_anicroche
                    ]
                    @if [$etat_anicroche = non_publiee]
                        <p>
                            "Cette page n'est pas encore publiée."
                    @else
                        sources-anicroche [$texte_anicroche]
                    @if [$gerant_anicroche]
                        ligne
                            bouton-ancre [$lien_gestion_anicroche]
                                "Gestion"
                            bouton-ancre [$lien_edition_anicroche]
                                "Édition"
