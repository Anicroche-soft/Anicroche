@script [
    // Deux formes d adresse pour une anicroche :
    // - un identifiant lisible en minuscules, tel quel : /conditions-generales-d-utilisation
    // - un identifiant en majuscules et chiffres, découpé en groupes de trois : /AB1-C2D
    // Renvoie l identifiant, ou null si le chemin ne correspond à aucune des deux formes
    $lire_identifiant_anicroche = (chemin) =>
    {
        if (/^(?=[a-z0-9-]*[a-z])[a-z0-9]+(?:-[a-z0-9]+)*$/.test(chemin))
            return chemin
        if (/^[A-Z0-9]{3}(?:-[A-Z0-9]{3})*$/.test(chemin))
            return chemin.replaceAll('-', '')
        return null
    }
]

@if [$phase = chargement]
    page-chargement

@else-if [$path ~= '/']
    -page-accueil

@else-if [$path ~= '/gadgets']
    -page-gadgets

@else-if [$path ~= '/connexion']
    -page-connexion

@else-if [$path ~= '/profil']
    -page-profil

@else-if [$path ~= '/profil/creation']
    -page-creation-profil

@else-if [$path ~= '/profil/selection']
    -page-selection-profil

@else-if [$path ~= '/profil/edition']
    -page-edition-profil

@else-if [$path ~= '/chargement']
    -page-chargement

# Anicroches : identifiant lisible en minuscules, ou majuscules et chiffres par groupes de trois
@else-if [$path ~= '/<$chemin_anicroche :+ abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789->/edition']
    -page-edition-anicroche

@else-if [$path ~= '/<$chemin_anicroche :+ abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789->']
    -page-anicroche

@else
    -page-404

?page-chargement
!page-404
