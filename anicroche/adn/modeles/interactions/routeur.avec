@script [
    // Deux formes d adresse pour une anicroche :
    // - un identifiant lisible en minuscules, tel quel : /conditions-generales-d-utilisation
    // - un identifiant en majuscules et chiffres, découpé en groupes de trois : /AB1-C2D
    // Renvoie l identifiant, ou null si le chemin ne correspond à aucune des deux formes
    $lire_identifiant_anicroche = (chemin) =>
    {
        if (/^(?=[a-z0-9-]*[a-z])[a-z0-9]+(?:-[a-z0-9]+)*$/.test(chemin))
            return chemin
        if (/^[A-Z0-9]{3}(?:-[A-Z0-9]{3})*$/.test(chemin))
            return chemin.replaceAll('-', '')
        return null
    }

    // La page n est choisie qu une fois le démarrage terminé : le modèle d attente de l appel
    // (corps) reste affiché jusqu à la page demandée, données comprises
    await $demarrage
]

@if [$path ~= '/']
    -page-accueil

@else-if [$path ~= '/gadgets']
    -page-gadgets

@else-if [$path ~= '/connexion']
    -page-connexion

# Une page dont les onglets ont chacun leur adresse
@else-if [$path ~{ ['/profil', '/compte']]
    -page-profil

@else-if [$path ~= '/profil/creation']
    -page-creation-profil

@else-if [$path ~= '/profil/selection']
    -page-selection-profil

@else-if [$path ~= '/profil/edition']
    -page-edition-profil

@else-if [$path ~= '/compte/edition']
    -page-edition-compte

@else-if [$path ~= '/compte/suppression']
    -page-suppression-compte

@else-if [$path ~= '/compte/export']
    -page-export-donnees

@else-if [$path ~= '/compte/restauration']
    -page-restauration-compte

@else-if [$path ~= '/chargement']
    -page-chargement

# Anicroches : identifiant lisible en minuscules, ou majuscules et chiffres par groupes de trois
# Une même page pour une autre anicroche ou une autre version est reconstruite (@key), avec
# la transition d un changement de page
@else-if [$path ~= '/<$chemin_anicroche :+ abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789->/edition']
    @key [$path]
        -page-edition-anicroche

@else-if [$path ~{ ['/<$chemin_anicroche :+ abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789->', '/<$chemin_anicroche :+ abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789->/<$version_anicroche :+ 0123456789>']]
    @key [$path]
        -page-anicroche

@else
    -page-404

?page-chargement
!page-404
