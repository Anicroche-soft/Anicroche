@if [$phase = chargement]
    page-chargement

@else-if [$path ~= '/']
    -page-accueil

@else-if [$path ~= '/gadgets']
    -page-gadgets

@else-if [$path ~= '/connexion']
    -page-connexion

@else-if [$path ~= '/profil']
    -page-profil

@else-if [$path ~= '/profil/creation']
    -page-creation-profil

@else-if [$path ~= '/profil/selection']
    -page-selection-profil

@else-if [$path ~= '/profil/edition']
    -page-edition-profil

@else-if [$path ~= '/chargement']
    -page-chargement

# Anicroches : identifiant lisible en minuscules, ou majuscules et chiffres par groupes de trois
@else-if [$path ~= '/<$chemin_anicroche :+ abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789->']
    -page-anicroche

@else
    -page-404

?page-chargement
!page-404
