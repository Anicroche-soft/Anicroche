@script [
    // Deux formes d adresse pour une anicroche (motifs des routes anicroche, gestion_anicroche et
    // edition_anicroche, dans app.adn) :
    // - un identifiant lisible en minuscules, tel quel : /conditions-generales-d-utilisation
    // - un identifiant en majuscules et chiffres, découpé en groupes de trois : /AB1-C2D
    // Renvoie l identifiant, ou null si le chemin ne correspond à aucune des deux formes
    $lire_identifiant_anicroche = (chemin) =>
    {
        if (/^(?=[a-z0-9-]*[a-z])[a-z0-9]+(?:-[a-z0-9]+)*$/.test(chemin))
            return chemin
        if (/^[A-Z0-9]{3}(?:-[A-Z0-9]{3})*$/.test(chemin))
            return chemin.replaceAll('-', '')
        return null
    }

    // Route d une adresse, d après routes dans app.adn : la première, dans leur ordre, dont un
    // motif (path, adresse ou liste d adresses, écrites comme pour ~=) correspond ; une route
    // sans path correspond à toute adresse. Renvoie la route avec son nom (name) et ses
    // captures (params), ou null
    $trouver_route = (chemin) =>
    {
        for (const [nom, route] of Object.entries($routes ?? {}))
        {
            const motifs = route.path === undefined ? null : [route.path].flat()
            const params = motifs
                ? motifs.reduce((trouve, motif) => trouve ?? $match(chemin, motif), null)
                : {}
            if (params)
                return { ...route, name: nom, params }
        }
        return null
    }

    // La page n est choisie qu une fois le démarrage terminé : le modèle d attente de l appel
    // (corps) reste affiché jusqu à la page demandée, données comprises
    await $demarrage
]

$route = $trouver_route($path)

# La page est le modèle de la route de l'adresse (la route introuvable reçoit toute autre
# adresse). Elle est reconstruite, avec la transition d'un changement de page, quand la route
# change, ou ses captures (une autre anicroche, une autre version) ; elle reste en place d'une
# adresse à l'autre d'une même route (/profil et /compte)
@key [[$route.name, $route.params]]
    @model ["-$route.model"]

?page-chargement
!page-404
