@style [
    .boite-ancre {
        display: flex;
        flex-flow: row nowrap;
        align-items: center;

        height: fit-content;

        border-radius: 0.1875rem;

        --l-ecart: 1rem;
    }

    *:has(> .boite-ancre.etendue) {
        position: relative;
    }

    .boite-ancre.etendue {
        position: absolute;
        top: 0;
        left: 0;

        height: 100%;
        width: 100%;

        border-radius: inherit;
    }

    /* Les liens et boutons d une boîte étendue passent au-dessus d elle ; sans spécificité, pour
       qu un bouton positionné exprès (comme la bascule d un mot de passe) le reste */
    :where(*:has(> .boite-ancre.etendue) :is(a, button):not(.boite-ancre.etendue)) {
        position: relative;
        z-index: 1;
    }
]

# $adresse : une adresse (/compte, https://…), lien précis, ou le nom d'une route à adresse fixe
# ($routes, dans app.adn) : le lien mène alors à son adresse actuelle, celle de son dernier onglet
# affiché pour une page dont les onglets ont chacun leur adresse (profil : /profil ou /compte)
@args [$adresse, $alt : '', $etendue : :(, $actif : :(]

<a
    .boite-ancre
    [$etendue] ? .etendue
    [$actif] ? .actif
    [$actif] ? aria-current="page"
    [$adresses_pages }- $adresse] ? href="$adresses_pages[$adresse]" : href="$adresse"
>
    @if [$alt != '']
        alt
            "$alt"
    @stud
