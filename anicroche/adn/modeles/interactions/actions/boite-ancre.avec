@style [
    .boite-ancre {
        display: flex;
        flex-flow: row nowrap;
        align-items: center;

        height: fit-content;

        border-radius: 0.1875rem;

        --l-ecart: 1rem;
    }

    *:has(> .boite-ancre.etendue) {
        position: relative;
    }

    .boite-ancre.etendue {
        position: absolute;
        top: 0;
        left: 0;

        height: 100%;
        width: 100%;

        border-radius: inherit;
    }

    /* Les liens et boutons d une boîte étendue passent au-dessus d elle ; sans spécificité, pour
       qu un bouton positionné exprès (comme la bascule d un mot de passe) le reste */
    :where(*:has(> .boite-ancre.etendue) :is(a, button):not(.boite-ancre.etendue)) {
        position: relative;
        z-index: 1;
    }
]

@args [$adresse, $alt : '', $etendue : :(]

<a
    .boite-ancre
    [$etendue] ? .etendue
    href="$adresse"
>
    @if [$alt != '']
        alt
            "$alt"
    @stud
