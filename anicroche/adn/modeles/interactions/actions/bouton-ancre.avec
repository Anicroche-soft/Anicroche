@style [
    .bouton-ancre {
        position: relative;

        height: 2rem;
        flex: 1024;

        border: 0.125rem solid var(--c-vif);
        border-radius: 0.5rem;
        padding: 0.375rem;
        white-space: nowrap;

        display: flex;
        justify-content: safe center;

        transition: outline-color var(--d-animation),
                    border-color var(--d-animation),
                    background var(--d-animation);

        --f-fond:  var(--c-vif);
        --c-fond:  var(--c-vif);
        --c-flux:  var(--c-creme);
        --c-focus: var(--c-vif);
        --e-fonte: var(--e-bouton);
        --p-fonte: var(--p-bouton);
    }

    .bouton-ancre:has(> .icone):not(:has(> .icone ~ .icone)):not(:has(> :not(.icone):not(.alt))) {
        flex: 1;
    }

    .bouton-ancre:hover,
    .bouton-ancre:focus {
        border-color: var(--c-plus);

        --f-fond: var(--c-plus);
        --c-fond: var(--c-plus);
    }

    .bouton-ancre .icone {
        margin: -0.25rem;
        flex-shrink: 0;
    }
]

# $adresse : une adresse (/compte, https://…), lien précis, ou le nom d'une route à adresse fixe
# ($routes, dans app.adn) : le lien mène alors à son adresse actuelle, celle de son dernier onglet
# affiché pour une page dont les onglets ont chacun leur adresse (profil : /profil ou /compte)
@args [$adresse, $alt : '']

<a .bouton .bouton-ancre [$adresses_pages }- $adresse] ? href="$adresses_pages[$adresse]" : href="$adresse">
    @if [$alt != '']
        alt
            "$alt"
    @stud
