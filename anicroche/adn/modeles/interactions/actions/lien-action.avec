@script [
    const demarrer_compte_a_rebours = (delai, noeud, vars) =>
    {
        const compte_a_rebours = noeud.querySelector('.compte-a-rebours')

        if (vars.chronometre)
        {
            clearInterval(vars.chronometre)
            vars.chronometre = null
        }

        if (delai <= 0)
        {
            noeud.disabled = false

            if (compte_a_rebours)
            {
                compte_a_rebours.textContent = ''
            }

            return
        }

        let restant = delai

        const actualiser = () =>
        {
            if (!compte_a_rebours) return
            compte_a_rebours.textContent = ` (${restant} s)`
        }

        noeud.disabled = true
        actualiser()

        const chronometre = setInterval(() =>
        {
            restant -= 1

            if (restant <= 0)
            {
                clearInterval(chronometre)
                vars.chronometre = null
                noeud.disabled = false

                if (compte_a_rebours)
                {
                    compte_a_rebours.textContent = ''
                }

                return
            }

            actualiser()
        }, 1000)

        vars.chronometre = chronometre
    }

    // Avec $depart (date de la dernière action, en millisecondes), le délai court depuis cette
    // date : revenir sur l onglet sans nouvelle action ne le relance pas
    const restant = (vars) =>
    {
        if (!vars.depart)
            return vars.delai
        const date = vars.depart()
        if (!date)
            return 0
        return Math.max(0, vars.delai - Math.floor((Date.now() - date) / 1000))
    }

    // Dans un formulaire en étapes, tous les onglets sont montés dès l ouverture de la page :
    // le compte à rebours démarre donc quand l onglet du lien devient actif (l étape est
    // atteinte, la clef vient d être envoyée)
    $monter_lien_action = ($delai, $depart) =>
    {
        const noeud = $node
        const vars  = $vars
        const delai = Math.max(0, Math.floor(Number($delai) || 0))

        vars.delai  = delai
        vars.depart = typeof $depart === 'function' ? $depart : null

        const onglet = noeud.closest('.onglet')
        if (!onglet || delai <= 0)
        {
            demarrer_compte_a_rebours(restant(vars), noeud, vars)
            return
        }

        let etait_actif = onglet.classList.contains('actif')
        if (etait_actif)
            demarrer_compte_a_rebours(restant(vars), noeud, vars)

        vars.observateur_onglet = new MutationObserver(() =>
        {
            const actif = onglet.classList.contains('actif')
            if (actif && !etait_actif)
                demarrer_compte_a_rebours(restant(vars), noeud, vars)
            etait_actif = actif
        })
        vars.observateur_onglet.observe(onglet, { attributes: true, attributeFilter: ['class'] })
    }

    $demonter_lien_action = () =>
    {
        if ($vars.observateur_onglet)
        {
            $vars.observateur_onglet.disconnect()
            $vars.observateur_onglet = null
        }

        if (!$vars.chronometre) return

        clearInterval($vars.chronometre)
        $vars.chronometre = null
    }

    $clic_lien_action = async () =>
    {
        const noeud = $node
        const vars  = $vars

        if (noeud.disabled) return

        await $fonction()

        if (vars.delai > 0)
            demarrer_compte_a_rebours(restant(vars), noeud, vars)
    }
]

@style [
    .lien-action {
        display: inline;
        width: fit-content;

        text-decoration: underline transparent;

        --c-flux: var(--c-vif);

        transition: text-decoration-color var(--d-animation),
                    outline-color var(--d-animation);
    }

    .lien-action:hover {
        text-decoration-color: var(--c-flux);
    }

    .lien-action:disabled {
        cursor: not-allowed;
        text-decoration: none;
    }
]

@args [
    $fonction
    $delai : :(
    $depart : :(
]

<button
    .lien-action
    type="button"
    @mount="$monter_lien_action($delai, $depart)"
    @unmount="$demonter_lien_action()"
    @click="$clic_lien_action()"
>
    @stud

    @if [$delai]
        <span .compte-a-rebours>
