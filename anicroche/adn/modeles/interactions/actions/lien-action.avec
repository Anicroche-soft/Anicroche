@script [
    const demarrer_compte_a_rebours = (delai, noeud, vars) =>
    {
        const compte_a_rebours = noeud.querySelector('.compte-a-rebours')

        if (vars.chronometre)
        {
            clearInterval(vars.chronometre)
            vars.chronometre = null
        }

        if (delai <= 0)
        {
            noeud.disabled = false

            if (compte_a_rebours)
            {
                compte_a_rebours.textContent = ''
            }

            return
        }

        let restant = delai

        const actualiser = () =>
        {
            if (!compte_a_rebours) return
            compte_a_rebours.textContent = ` (${restant} s)`
        }

        noeud.disabled = true
        actualiser()

        const chronometre = setInterval(() =>
        {
            restant -= 1

            if (restant <= 0)
            {
                clearInterval(chronometre)
                vars.chronometre = null
                noeud.disabled = false

                if (compte_a_rebours)
                {
                    compte_a_rebours.textContent = ''
                }

                return
            }

            actualiser()
        }, 1000)

        vars.chronometre = chronometre
    }

    $monter_lien_action = ($delai) =>
    {
        const delai = Math.max(0, Math.floor(Number($delai) || 0))

        $vars.delai = delai

        demarrer_compte_a_rebours(delai, $node, $vars)
    }

    $demonter_lien_action = () =>
    {
        if (!$vars.chronometre) return

        clearInterval($vars.chronometre)
        $vars.chronometre = null
    }

    $clic_lien_action = async () =>
    {
        const noeud = $node
        const vars  = $vars

        if (noeud.disabled) return

        await $fonction()

        if (vars.delai > 0)
        {
            demarrer_compte_a_rebours(vars.delai, noeud, vars)
        }
    }
]

@style [
    .lien-action {
        display: inline;
        width: fit-content;

        text-decoration: underline transparent;

        transition: text-decoration-color var(--d-animation);
    }

    .lien-action:hover {
        text-decoration-color: var(--c-flux);
    }

    .lien-action:disabled {
        cursor: not-allowed;
        text-decoration: none;
    }
]

@args [
    $fonction
    $delai : :(
]

<button
    .lien-action
    type="button"
    @mount="$monter_lien_action($delai)"
    @unmount="$demonter_lien_action()"
    @click="$clic_lien_action()"
>
    @stud

    @if [$delai]
        <span .compte-a-rebours>
