@style [
    .champ-texte-long {
        flex: 1024;

        --l-ecart: 0.5rem;
    }

    .champ-texte-long > textarea {
        width: 100%;
        min-height: 16rem;

        border: 0.125rem solid var(--c-vif);
        border-radius: 0.5rem;
        padding: 0.375rem;

        resize: vertical;

        line-height: 1.5;

        --c-focus: var(--c-vif);
        --p-fonte: var(--p-champ);
    }

    .champ-texte-long > textarea:invalid {
        border-style: dashed;
    }
]

@args [
    $etiquette, $nom
    $valeur : ''
    $requis : :(
]

<label
    .champ
    .champ-texte-long
    for="champ-$nom"
>
    "$etiquette"
    <textarea
        #champ-$nom
        name="$nom"
        [$requis] ? required
    >
        "$valeur"
