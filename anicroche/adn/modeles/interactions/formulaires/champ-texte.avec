@script [
    // Le champ est dans son <label> : un clic sur l'étiquette lui donnerait le focus
    $bloquer_focus_lecture_seule = () =>
    {
        $event.preventDefault()
    }

    $tester_regle = () =>
    {
        const regex = new RegExp($regle.slice(1, -1))

        if(regex.test($node.value))
        {
            $node.setCustomValidity('')
        }
        else
        {
            $node.setCustomValidity('Valeur invalide')
        }
    }

    // Lettres qui ne se décomposent pas en une lettre de base et des marques
    const SPECIFICITES = { 'œ': 'oe', 'æ': 'ae', 'ß': 'ss', 'ø': 'o', 'đ': 'd', 'ð': 'd', 'ł': 'l', 'þ': 'th', 'ı': 'i' }

    // Sans accents ni autres marques, et sous sa forme ordinaire (pleine chasse, ligatures…)
    const sans_marques = (texte) => texte.normalize('NFKD').replace(/\p{M}/gu, '')

    const est_permis = (texte) => texte.length > 0 && [ ...texte ].every(caractere => $saisie.includes(caractere))

    // Caractère gardé par $saisie : lui-même s il est permis, sinon le premier remplaçant
    // permis, dans sa casse puis dans une autre (É → E, puis e ; œ → oe), sinon rien
    const filtrer_caractere = (caractere) =>
    {
        if (est_permis(caractere))
            return caractere

        const formes = [ ...new Set([ caractere, caractere.toLowerCase(), caractere.toUpperCase() ]) ]
        for (const forme of formes)
        {
            const specificite = SPECIFICITES[forme.toLowerCase()]
            const candidats   = [
                forme,
                sans_marques(forme),
                ...(specificite ? [ forme === forme.toLowerCase() ? specificite : specificite.toUpperCase() ] : [])
            ]
            const candidat = candidats.find(est_permis)
            if (candidat)
                return candidat
        }
        return ''
    }

    // Garde dans le champ les seuls caractères permis par $saisie, le curseur restant après le
    // même caractère
    const filtrer_saisie = (champ) =>
    {
        const filtrer = (texte) => [ ...texte ].map(filtrer_caractere).join('')

        const valeur = filtrer(champ.value)
        if (valeur === champ.value)
            return

        const curseur = filtrer(champ.value.slice(0, champ.selectionStart ?? champ.value.length)).length
        champ.value = valeur
        champ.setSelectionRange(curseur, curseur)
    }

    $traiter_saisie = () =>
    {
        if ($saisie)
            filtrer_saisie($node)
        if ($regle)
            $tester_regle()
    }
]

@style [
    .champ-texte {
        flex: 1024;

        --l-ecart: 0.5rem;
    }

    .champ-texte > div {
        position: relative;
        width: 100%;
        height: 2rem;

        border: 0.125rem var(--c-vif);
        border-style: dashed solid;
        border-radius: 0.5rem;
        padding: 0.375rem;

        flex-direction: row;
        align-items: center;

        cursor: text;

        --c-focus: var(--c-vif);
        --p-fonte: var(--p-champ);
        --l-ecart: 0;
    }

    .champ-texte > div::after {
        content : "";
        pointer-events: none;

        position: absolute;
        inset: -0.125rem;

        border: 0.125rem solid var(--c-vif);
        border-radius: 0.5rem;

        transition: opacity var(--d-animation);
    }

    .champ-texte > div:has(> input:invalid)::after {
        opacity: 0;
    }

    .champ-texte > div:has(> input[readonly]) {
        cursor: not-allowed;

        --c-flux: var(--c-vif);
    }

    .champ-texte > div > input[readonly] {
        pointer-events: none;
        caret-color: transparent;
        user-select: none;
    }

    .champ-texte > div:focus-within {
        outline-color: var(--c-focus);
    }

    .champ-texte > div::before {
        content: attr(data-prefixe);
    }

    .champ-texte > div > input {
        outline: none;
        width: 0rem;
        flex-grow: 1;
    }

    .champ-texte > div > input::placeholder {
        color: var(--c-plus);
        font-style: italic;
    }
]

# $saisie : caractères permis, seuls gardés au fil de la frappe, avant $regle. Un caractère
# absent est remplacé, si possible, par sa forme sans accent ni autre marque, dans une autre
# casse, ou par les lettres qu'il réunit (É → e, œ → oe), sinon retiré
@args [
    $etiquette, $nom
    $requis : :)
    $valeur : ''
    $modifiable : :)
    $prefixe : :(
    $regle : :(
    $indice : :(
    $saisie : :(
]

<label
    .champ
    .champ-texte
    for="champ-$nom"
    [! $modifiable] ? @click="$bloquer_focus_lecture_seule()"
>
    <span .etiquette>
        "$etiquette"
    <div
        [$prefixe] ? data-prefixe="$prefixe"
    >
        <input
            #champ-$nom
            name="$nom"
            type="text"
            value="$valeur"
            [$requis] ? required
            [! $modifiable] ? readonly
            [! $modifiable] ? tabindex="-1"
            [$regle | $saisie] ? @input="$traiter_saisie()"
        >
    @if [$indice]
        indication
            "$indice"
