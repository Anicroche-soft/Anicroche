@script [
    // $node et $event sont réécrits par les gestionnaires imbriqués (un .focus() déclenche
    // aussitôt un autre @focus) : chaque gestionnaire les copie avant tout appel.

    const taille_clef = 9

    const extraire_chiffres = (texte) => `${texte ?? ''}`.replace(/\D/g, '')

    const elements_champ_clef = (noeud) =>
    {
        const racine = noeud.closest('.champ-clef')
        return {
            cache    : racine.querySelector('.cache'),
            chiffres : Array.from(racine.querySelectorAll('.chiffre'))
        }
    }

    const est_modifiable = ({ chiffres }) => chiffres.length > 0 && !chiffres[0].readOnly

    // value vaut ’’ dès que le contenu d’un champ nombre est invalide.
    const lire_chiffre = (case_clef) => case_clef.dataset.chiffre ?? ''

    const ecrire_chiffre = (case_clef, chiffre) =>
    {
        case_clef.value           = chiffre
        case_clef.dataset.chiffre = chiffre
    }

    const premiere_case_vide = ({ chiffres }) => chiffres.findIndex((case_clef) => lire_chiffre(case_clef) === '')

    const case_a_atteindre = (elements) =>
    {
        const index = premiere_case_vide(elements)
        return index < 0 ? elements.chiffres.length - 1 : index
    }

    const atteindre_case = ({ chiffres }, index) =>
    {
        chiffres[Math.max(0, Math.min(chiffres.length - 1, index))].focus()
    }

    const synchroniser = (elements) =>
    {
        const { cache, chiffres } = elements

        cache.value = chiffres.map(lire_chiffre).join('')

        const cible      = case_a_atteindre(elements)
        const modifiable = est_modifiable(elements)
        chiffres.forEach((case_clef, index) =>
        {
            case_clef.tabIndex = modifiable && index === cible ? 0 : -1
        })
    }

    // Les derniers chiffres sont gardés pour ignorer un indicatif (+33) ajouté par la messagerie.
    const coller = (elements, texte) =>
    {
        const { chiffres } = elements
        const collage      = extraire_chiffres(texte).slice(-taille_clef)
        if (!collage)
            return

        const vides = chiffres.filter((case_clef) => lire_chiffre(case_clef) === '')
        const cases = collage.length <= vides.length
            ? vides.slice(0, collage.length)
            : chiffres.slice(-collage.length)

        cases.forEach((case_clef, rang) => ecrire_chiffre(case_clef, collage[rang]))
        synchroniser(elements)
        atteindre_case(elements, case_a_atteindre(elements))
    }

    const saisir = (elements, index, texte) =>
    {
        const saisie = extraire_chiffres(texte)
        if (!saisie)
            return

        if (saisie.length > 1)
            return coller(elements, saisie)

        ecrire_chiffre(elements.chiffres[index], saisie)
        synchroniser(elements)
        atteindre_case(elements, index + 1)
    }

    const effacer = (elements, index, reculer) =>
    {
        const { chiffres } = elements

        if (lire_chiffre(chiffres[index]) !== '')
        {
            ecrire_chiffre(chiffres[index], '')
            synchroniser(elements)
            return
        }

        if (!reculer || index === 0)
            return

        ecrire_chiffre(chiffres[index - 1], '')
        synchroniser(elements)
        atteindre_case(elements, index - 1)
    }

    const envoyer_formulaire = (noeud) =>
    {
        const formulaire = noeud.form
        if (!formulaire)
            return
        const bouton = Array.from(formulaire.elements).find((element) => element.type === 'submit')
        if (bouton?.disabled)
            return
        formulaire.requestSubmit(bouton)
    }

    $monter_champ_clef = () =>
    {
        const elements = elements_champ_clef($node)
        const valeur   = extraire_chiffres(elements.cache.value).slice(0, taille_clef)

        elements.chiffres.forEach((case_clef, index) => ecrire_chiffre(case_clef, valeur[index] ?? ''))
        synchroniser(elements)
    }

    $focus_champ_clef = () =>
    {
        const noeud    = $node
        const elements = elements_champ_clef(noeud)
        if (!est_modifiable(elements))
            return

        if (noeud === elements.cache)
            return atteindre_case(elements, case_a_atteindre(elements))

        const vide = premiere_case_vide(elements)
        if (vide >= 0 && elements.chiffres.indexOf(noeud) !== vide)
            atteindre_case(elements, vide)
    }

    $clic_champ_clef = () =>
    {
        const evenement = $event
        const elements  = elements_champ_clef($node)
        if (!est_modifiable(elements) || evenement.target.classList.contains('chiffre'))
            return

        atteindre_case(elements, case_a_atteindre(elements))
    }

    $clavier_champ_clef = () =>
    {
        const noeud     = $node
        const evenement = $event
        if (noeud.readOnly)
            return

        const elements = elements_champ_clef(noeud)
        const index    = elements.chiffres.indexOf(noeud)

        switch (evenement.key)
        {
        case 'Enter':
            // L envoi implicite serait annulé avec la saisie par beforeinput (insertLineBreak).
            if (evenement.isComposing)
                break
            evenement.preventDefault()
            envoyer_formulaire(noeud)
            break
        case 'Backspace':
        case 'Delete':
            evenement.preventDefault()
            effacer(elements, index, evenement.key === 'Backspace')
            break
        case 'ArrowLeft':
            evenement.preventDefault()
            atteindre_case(elements, index - 1)
            break
        case 'ArrowRight':
            evenement.preventDefault()
            atteindre_case(elements, index + 1)
            break
        case 'ArrowUp':
        case 'ArrowDown':
            // Empêche l’incrémentation propre aux champs de type nombre.
            evenement.preventDefault()
            break
        }
    }

    // Les claviers virtuels n’indiquent souvent pas la touche dans keydown.
    $avant_saisie_champ_clef = () =>
    {
        const noeud     = $node
        const evenement = $event
        if (noeud.readOnly || !evenement.cancelable)
            return

        const elements = elements_champ_clef(noeud)
        const index    = elements.chiffres.indexOf(noeud)
        const type     = evenement.inputType ?? ''

        if (type === 'insertLineBreak')
            return
        if (type.startsWith('insert'))
        {
            evenement.preventDefault()
            saisir(elements, index, evenement.data ?? evenement.dataTransfer?.getData('text') ?? '')
        }
        else if (type.startsWith('delete'))
        {
            evenement.preventDefault()
            effacer(elements, index, type.endsWith('Backward'))
        }
    }

    // Repli pour ce que beforeinput n’a pas pu empêcher (composition, remplissage automatique).
    $saisie_champ_clef = () =>
    {
        const noeud = $node
        if (noeud.readOnly)
            return

        const elements = elements_champ_clef(noeud)
        const index    = elements.chiffres.indexOf(noeud)
        const ancien   = lire_chiffre(noeud)
        const saisie   = noeud.validity.badInput ? null : extraire_chiffres(noeud.value)

        noeud.value = ancien

        if (saisie === null)
            return

        if (!saisie)
            return effacer(elements, index, false)

        const nouveau = saisie.length === 2 && ancien && saisie.includes(ancien)
            ? saisie.replace(ancien, '')
            : saisie
        saisir(elements, index, nouveau)
    }

    $coller_champ_clef = () =>
    {
        const noeud     = $node
        const evenement = $event
        if (noeud.readOnly)
            return

        evenement.preventDefault()
        coller(elements_champ_clef(noeud), evenement.clipboardData?.getData('text') ?? '')
    }
]

@style [
    .champ-clef {
        flex: 1024;

        --l-ecart: 0.5rem;
    }

    .champ-clef > div {
        position: relative;
        height: 2rem;

        width: 100%;

        border-radius: 0.5rem;
        cursor: text;

        flex-direction: row;

        --c-focus: var(--c-vif);
        --l-ecart: 0.5rem;
    }

    .champ-clef > div > div {
        position: relative;
        flex: 1;

        border: 0.125rem var(--c-vif);
        border-style: dashed solid;
        border-radius: 0.5rem;
        padding: 0.375rem;

        flex-direction: row;

        --c-focus: var(--c-vif);
        --p-fonte: var(--p-champ);
        --l-ecart: 0;
    }

    .champ-clef > div > div::after {
        content : "";
        pointer-events: none;

        position: absolute;
        inset: -0.125rem;

        border: 0.125rem solid var(--c-vif);
        border-radius: 0.5rem;

        transition: opacity var(--d-animation);
    }

    .champ-clef > div > input:invalid ~ div::after {
        opacity: 0;
    }

    .champ-clef > div:focus-within {
        outline-color: var(--c-focus);
    }

    .champ-clef .chiffre {
        width: 100%;
        text-align: center;
        caret-color: transparent;
        user-select: none;
        outline-color: transparent;

        -moz-appearance: textfield;
        appearance: textfield;
    }

    .champ-clef .chiffre:focus,
    .champ-clef .chiffre:focus-visible {
        outline: none;
        outline-color: transparent;
    }

    .champ-clef .chiffre[readonly] {
        cursor: not-allowed;

        --c-flux: var(--c-vif);
    }

    .champ-clef .chiffre::placeholder {
        color: var(--c-plus);
    }

    .champ-clef .chiffre::-webkit-outer-spin-button,
    .champ-clef .chiffre::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .champ-clef .cache {
        position: absolute;
        inset: 0;
        opacity: 0;
        pointer-events: none;
    }
]

@args [$etiquette, $nom, $requis : :), $valeur : '', $modifiable : :)]

<label
    .champ
    .champ-clef
    for="champ-$nom"
>
    "$etiquette"
    <div @mount="$monter_champ_clef()" @click="$clic_champ_clef()">
        <input
            #champ-$nom
            .cache
            name="$nom"
            type="text"
            value="$valeur"
            tabindex="-1"
            autocomplete="off"
            pattern="[0-9]{9}|"
            @focus="$focus_champ_clef()"
            [$requis] ? required
        >

        @repeat [3]
            <div>
                @repeat [3]
                    <input
                        .chiffre
                        type="number"
                        inputmode="numeric"
                        min="0"
                        max="9"
                        step="1"
                        placeholder="x"
                        autocomplete="one-time-code"
                        @focus="$focus_champ_clef()"
                        @keydown="$clavier_champ_clef()"
                        @beforeinput="$avant_saisie_champ_clef()"
                        @input="$saisie_champ_clef()"
                        @paste="$coller_champ_clef()"
                        [! $modifiable] ? readonly
                    >
