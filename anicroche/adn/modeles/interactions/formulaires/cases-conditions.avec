@script [
    // Une case obligatoire par version à accepter, telle que la renvoie l API à la restauration
    // d un compte : { id_anicroche, titre, numero, date_parution, a_venir }. Le lien ouvre la
    // version dans un nouvel onglet
    $cases_conditions = ($conditions ?? []).map((condition, i) => ({
        nom   : `condition-${i + 1}`,
        lien  : condition.a_venir ? `/${condition.id_anicroche}?version=${condition.numero}` : `/${condition.id_anicroche}`,
        titre : condition.titre,
        fin   : condition.a_venir
            ? `, qui entrera en vigueur le ${$formater_date(condition.date_parution)}.`
            : `, en vigueur depuis le ${$formater_date(condition.date_parution)}.`
    }))
]

@args [$conditions]

<div .cases-conditions>
    @for-each [$case] of [$cases_conditions]
        case-a-cocher [$nom : $case.nom, $requis : :)]
            "J'ai lu et j'accepte la nouvelle version de la page "
            lien-ancre [$case.lien, $nouvel_onglet : :)]
                "$case.titre"
            "$case.fin"
