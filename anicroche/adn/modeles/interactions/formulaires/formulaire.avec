@script [
    $envoyer_formulaire = () =>
    {
        $event.preventDefault()
        $fonction()
    }
]

@style [
    .formulaire .ligne {
        gap: 0.5rem;
    }

    .formulaire :is(.lien-ancre, .lien-action, .lien-soumission) {
        --c-flux: var(--c-vif);
    }
]

@args [$fonction]

<form .formulaire @submit="$envoyer_formulaire()">
    @stud
