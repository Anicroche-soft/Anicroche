@script [
    $envoyer_formulaire = () =>
    {
        $event.preventDefault()

        const formulaire = $node
        if ($est_en_attente(formulaire))
            return
        $attendre_action([ formulaire, $event.submitter ], $fonction())
    }
]

@style [
    .formulaire .ligne {
        gap: 0.5rem;
    }
]

@args [$fonction]

<form .formulaire @submit="$envoyer_formulaire()">
    @stud
