@style [
    .case-a-cocher {
        flex: 1024;

        flex-direction: row;
        align-items: flex-start;

        cursor: pointer;

        --l-ecart: 0.5rem;
    }

    .case-a-cocher > input[type="checkbox"] {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: 0;
        padding: 0;
        border: 0;
        clip-path: inset(50%);
        overflow: hidden;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
    }

    .case-a-cocher > .case {
        position: relative;
        flex-shrink: 0;

        width: 1.25rem;
        height: 1.25rem;

        border: 0.125rem var(--c-vif);
        border-style: dashed solid;
        border-radius: 0.375rem;

        transition: background var(--d-animation);

        --c-focus: var(--c-vif);
    }

    /* Bordure pleine, sauf pour une case obligatoire encore décochée */
    .case-a-cocher > .case::before {
        content: "";
        pointer-events: none;

        position: absolute;
        inset: -0.125rem;

        border: 0.125rem solid var(--c-vif);
        border-radius: 0.375rem;

        transition: opacity var(--d-animation);
    }

    .case-a-cocher > input:invalid + .case::before {
        opacity: 0;
    }

    /* Coche dessinée avec deux bordures */
    .case-a-cocher > .case::after {
        content: "";
        pointer-events: none;

        position: absolute;
        left: 0.3125rem;
        top: 0.0625rem;
        width: 0.3125rem;
        height: 0.625rem;

        border: solid var(--c-creme);
        border-width: 0 0.125rem 0.125rem 0;
        transform: rotate(45deg);

        opacity: 0;
        transition: opacity var(--d-animation);
    }

    .case-a-cocher > input:checked + .case {
        background: var(--c-vif);
    }

    .case-a-cocher > input:checked + .case::after {
        opacity: 1;
    }

    .case-a-cocher > input:focus-visible + .case {
        outline: 0.125rem solid var(--c-focus);
        outline-offset: 0.125rem;
    }

    .case-a-cocher > .texte {
        display: inline;
    }
]

@args [
    $etiquette : :(, $nom
    $requis : :(
    $coche : :(
    $action : :(
]

<label
    .champ
    .case-a-cocher
    for="champ-$nom"
>
    <input
        #champ-$nom
        name="$nom"
        type="checkbox"
        value="oui"
        [$requis] ? required
        [$coche] ? checked
        [$action] ? @change="$action()"
    >
    <span .case>
    <span .texte>
        @if [$etiquette]
            "$etiquette"
        @stud
