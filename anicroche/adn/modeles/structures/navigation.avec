@style [
    .navigation {
        position: absolute;
        top: 0;
        left: var(--l-tete);
        right: 0;
        z-index: 6;

        height: var(--h-navigation);
        padding: var(--l-marge);

        flex-direction: row;

        --c-fond: var(--c-vif);
        --c-flux: var(--c-creme);
    }

    .interieur .navigation {
        --c-fond: var(--c-analogue);
        --c-flux: var(--c-inverse);
    }

    .navigation::before {
        content: "";
        transform: translateZ(0);

        position: absolute;
        z-index: -1;
        top: 0;
        left: calc(0rem - var(--l-tete));

        height: 100dvh;
        width: var(--l-fenetre);

        background: var(--f-fond);
        backdrop-filter: blur(var(--l-blur));

        clip-path: polygon(
            0                 0,
            var(--l-fenetre)  0,
            var(--l-fenetre)  var(--h-navigation),
            var(--l-tete)     var(--h-navigation),
            var(--l-tete)     100dvh,
            0                 100dvh
        );
        pointer-events: none;

        --f-fond: var(--c-analogue-trans);
        --c-fond: var(--c-analogue);
    }

    .petit.portrait .navigation::before {
        clip-path: polygon(
            0                0,
            var(--l-fenetre) 0,
            var(--l-fenetre) var(--h-navigation),
            0                var(--h-navigation),
            0                calc(100dvh - var(--h-tete)),
            var(--l-fenetre) calc(100dvh - var(--h-tete)),
            var(--l-fenetre) 100dvh,
            0                100dvh
        );
    }

    .navigation::after {
        content: "";

        position: absolute;
        z-index: -1;
        top: 0;
        left: 0;

        height: var(--h-navigation);
        width: 100%;

        background: var(--f-fond);

        transition: opacity var(--d-animation);

        --f-fond: var(--f-degrade-vif);
        --c-fond: var(--c-vif);
    }

    .interieur .navigation::after {
        opacity: 0;
    }

    .navigation .gauche {
        justify-content: flex-start;
    }

    /* Le centre peut être plus étroit que son contenu : une barre d'onglets trop large défile */
    .navigation .centre {
        flex: 1;
        min-width: 0;
        justify-content: center;
    }

    .navigation .droite {
        justify-content: flex-end;
    }

    /* Sans onglets, le centre est centré dans toute la barre, quelle que soit la largeur des
       côtés : chaque côté prend la moitié de la place restante, mais jamais moins que son
       contenu. Le centre ne se décale donc que lorsqu'un côté a besoin de plus que cette
       moitié, et son texte se termine par « … » quand même ce décalage ne suffit plus */
    .navigation:not(:has(.barre-onglets)) {
        display: grid;
        grid-template-columns: minmax(max-content, 1fr) minmax(0, auto) minmax(max-content, 1fr);
        column-gap: 0;
    }

    /* Chaque côté, à la largeur de son contenu, reste contre son bord de la barre ; l'écart
       avec le centre est une marge du côté, et non un gap de la grille, pour qu'un côté absent
       ne laisse pas d'espace */
    .navigation:not(:has(.barre-onglets)) > .gauche {
        grid-area: 1 / 1;
        justify-self: start;
        margin-right: 1rem;
    }

    .navigation:not(:has(.barre-onglets)) > .centre {
        grid-area: 1 / 2;
        min-width: 0;
    }

    .navigation:not(:has(.barre-onglets)) > .droite {
        grid-area: 1 / 3;
        justify-self: end;
        margin-left: 1rem;
    }

    .navigation .centre > span {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .navigation span {
        white-space: nowrap;
        text-align: center;

        --l-fonte: 1.5rem;
        --e-fonte: var(--e-titre);
        --p-fonte: var(--p-titre);
    }

    .navigation .bouton-onglet span {
        --l-fonte: 1.25rem;
    }

    .petit .navigation span {
        --l-fonte: 1.25rem;
    }

    .petit .navigation .bouton-onglet span {
        --l-fonte: 1rem;
    }

    .petit .navigation .icone {
        margin: -0.25rem 0;
    }

    /* Boutons et liens à icône (les onglets texte de la barre d'onglets sont exclus) */
    .navigation :is(a, button):not(.bouton-onglet) {
        display: flex;
        align-items: center;

        height: 1.5rem;

        border-radius: 0.1875rem;
    }
]

<div .navigation>
    @stud
