@script [
    $basculer_bouton_onglet = () =>
    {
        const evenement = $event

        // Un onglet avec adresse est un vrai lien : un clic avec modificateur (nouvel onglet,
        // nouvelle fenêtre…) est laissé au navigateur
        if ($node.localName === 'a')
        {
            if (evenement.ctrlKey || evenement.metaKey || evenement.shiftKey || evenement.button !== 0)
                return
            evenement.preventDefault()
        }

        const barre = $node.closest('.barre-onglets')
        if (!barre) return

        const boutons = barre.querySelectorAll(':scope > .bouton-onglet')
        const n = [...boutons].indexOf($node) + 1

        $basculer_vers_onglet(n)
        $node.blur()
    }
]

@style [
    .bouton-onglet {
        flex: 1;

        display: flex;
        justify-content: center;

        border-radius: 0.1875rem;
    }

    .bouton-onglet > * {
        transition: opacity var(--d-animation);
    }

    /* Le texte de l'onglet occupe toute la largeur du bouton, centré */
    .bouton-onglet > span {
        flex: 1;
        min-width: 0;
        text-align: center;
    }

    .bouton-onglet:not(.actif) > * {
        opacity: 75%;
    }
]

# $adresse : adresse propre à l'onglet (/profil, /compte…). Le bouton devient alors un lien, et
# passer sur l'onglet remplace l'adresse dans l'historique (voir page)
@args [$adresse : :(]

@if [$adresse]
    <a .bouton-onglet href="$adresse" @click="$basculer_bouton_onglet()">
        @stud

@else
    <button .bouton-onglet @click="$basculer_bouton_onglet()">
        @stud
