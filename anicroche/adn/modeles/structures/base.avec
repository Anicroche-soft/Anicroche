@script [
    $connecte = null
    $jeton_acces = null

    $compte = null
    $profil = null

    // Faux pour un compte dont l effacement est demandé : les pages le traitent alors comme
    // déconnecté, sauf la page du compte, qui affiche l effacement en cours
    $compte_actif = false

    // Types d anicroches de l API (GET /types), gardés jusqu à l actualisation de la page :
    // { <nom> : { libelle, identifiant, auteurs, administration, exceptions, sources } }
    $types_anicroches = {}

    // Pages qui ont la spécificité legalite, tous types confondus, pour le pied de page :
    // [{ identifiant, specificites, titre }]
    $pages_legales = []

    // Types rencontrés mais absents de l API même après rechargement : ils ne la font plus
    // recharger jusqu à l actualisation de la page
    const types_inconnus = new Set()

    // Un seul chargement à la fois : les demandes simultanées attendent le même
    let chargement_types = null

    $charger_types_anicroches = () =>
    {
        chargement_types ??= (async () =>
        {
            const reponse = await $search('types')
            if (!reponse.error && reponse.data && typeof reponse.data === 'object')
            {
                $types_anicroches = reponse.data
                $pages_legales    = Object.values($types_anicroches).flatMap(type =>
                    (type.exceptions ?? []).filter(exception => exception.specificites.includes('legalite')))
            }
            chargement_types = null
            return !reponse.error
        })()
        return chargement_types
    }

    // Configuration d un type, ou null s il est inconnu. Un type absent fait recharger les types
    // une fois : toujours absent, il est retenu comme inconnu (sauf si l API n a pas répondu)
    $obtenir_type_anicroche = async (nom) =>
    {
        if (Object.hasOwn($types_anicroches, nom))
            return $types_anicroches[nom]
        if (types_inconnus.has(nom))
            return null

        const charge = await $charger_types_anicroches()

        if (Object.hasOwn($types_anicroches, nom))
            return $types_anicroches[nom]
        if (charge)
            types_inconnus.add(nom)
        return null
    }

    // Version synchrone, pour les gabarits : le type doit déjà avoir été obtenu
    $type_anicroche = (nom) => Object.hasOwn($types_anicroches, nom) ? $types_anicroches[nom] : null

    // Le rôle est celui du profil sélectionné
    $administre_type = (nom) => !!$profil && ($type_anicroche(nom)?.administration ?? []).includes($profil.role)

    // Exceptions : [{ identifiant, specificites, titre }], specificites parmi legalite, preavis
    // et acceptation
    const exception_anicroche = (anicroche) =>
        ($type_anicroche(anicroche?.type)?.exceptions ?? []).find(exception => exception.identifiant === anicroche?.id) ?? null

    $a_specificite = (anicroche, specificite) =>
        exception_anicroche(anicroche)?.specificites.includes(specificite) ?? false

    $est_legale = (anicroche) => $a_specificite(anicroche, 'legalite')

    $soumise_au_preavis = (anicroche) => $a_specificite(anicroche, 'preavis')

    // Sources d une version (telles que les donne $charger_anicroche : une source par rôle, ou
    // une liste pour un rôle à plusieurs sources), dans l ordre des rôles du type puis des
    // positions :
    // [{ role, libelle, format, max, position, langue, region, version, contenu }]
    $lister_sources_anicroche = (type, sources) =>
        (type?.sources ?? []).flatMap(source =>
        {
            const valeur = sources?.[source.role]
            const liste  = Array.isArray(valeur) ? valeur : valeur ? [ valeur ] : []
            return liste.map(element => ({
                role    : source.role,
                libelle : source.libelle,
                format  : source.format,
                max     : source.max,
                ...element
            }))
        })

    // ─── Lecture des anicroches ──────────────────────────────────────────────

    const est_parue = (version) => !!version?.date_parution && new Date(version.date_parution) <= new Date()

    const role_titre = (type) => (type?.sources ?? []).find(source => source.format === 'titre')?.role ?? null

    const adresse_anicroche = (id) => `anicroche/${encodeURIComponent(id)}`

    // L API résout les sources d une version (la source la plus récente jusqu à elle, dans la
    // langue d origine de l anicroche) et n en donne que si la version est visible
    const lire_sources_version = async (id, type, numero) =>
    {
        const reponse   = await $search(adresse_anicroche(id), { projection: 'id;sources', version: numero })
        const lignes    = reponse.code === 200 ? reponse.data?.sources ?? [] : []
        const multiples = new Set((type?.sources ?? []).filter(source => source.max === null || source.max > 1).map(source => source.role))
        const sources   = {}

        for (const { role, id_anicroche, ...source } of [ ...lignes ].sort((a, b) => a.position - b.position))
        {
            if (multiples.has(role))
                (sources[role] ??= []).push(source)
            else
                sources[role] ??= source
        }
        return sources
    }

    // Titre d une version : sa source de titre, sinon celui de l exception à sa création (pour
    // une version parue avant la source de titre de son type), sinon l identifiant
    $titre_anicroche = (anicroche, sources) =>
    {
        const role    = role_titre($type_anicroche(anicroche.type))
        const valeur  = role ? sources?.[role] : null
        const source  = Array.isArray(valeur) ? valeur[0] : valeur
        const contenu = String(source?.contenu ?? '').trim()

        return contenu || exception_anicroche(anicroche)?.titre || anicroche.id
    }

    // Une anicroche avec la version demandée (sinon celle en vigueur) et ses sources :
    // { code, type, data } ; data reçoit en plus de id, type, langue et region :
    // - version, date_parution, acces, sources et titre de la version affichée (null si aucune) ;
    // - en_vigueur : numéro de la version en vigueur ;
    // - a_venir    : { numero, date_parution } de la version programmée ;
    // - a_l_essai  : { numero } de la version à l essai (dernière version, non datée et publique) ;
    // - versions   : versions parues, de la plus récente à la plus ancienne ({ numero, date_parution }) ;
    // - legale, preavis : spécificités de l anicroche ;
    // - brouillon  : pour les gérants, la dernière version si elle n est pas parue
    //                ({ numero, date_parution, acces, sources }), ou null.
    // L API ne donne que les versions visibles : les gérants les voient toutes
    $charger_anicroche = async (id, demandee = null) =>
    {
        const reponse = await $search(adresse_anicroche(id), { projection: 'id;type;langue;region;versions' })
        const type    = reponse.code === 200 ? await $obtenir_type_anicroche(reponse.data?.type) : null
        if (!type)
            return { code: reponse.code === 200 ? 404 : reponse.code, error: reponse.error, type: null, data: null }

        const { versions = [], ...anicroche } = reponse.data
        const rangees    = [ ...versions ].sort((a, b) => b.numero - a.numero)
        const gere       = $administre_type(anicroche.type)
        const en_vigueur = rangees.find(est_parue) ?? null
        const derniere   = rangees[0] ?? null
        const programmee = derniere?.date_parution && !est_parue(derniere) ? derniere : null
        const essai      = derniere && !derniere.date_parution && derniere.acces === 'public' ? derniere : null
        const affichee   = demandee === null ? en_vigueur : rangees.find(version => version.numero === demandee) ?? null

        if (!affichee && (demandee !== null || (!programmee && !essai)) && !gere)
            return { code: 404, type, data: null }

        const sources = affichee ? await lire_sources_version(anicroche.id, type, affichee.numero) : {}

        anicroche.version       = affichee?.numero ?? null
        anicroche.date_parution = affichee?.date_parution ?? null
        anicroche.acces         = affichee?.acces ?? null
        anicroche.sources       = sources
        anicroche.titre         = $titre_anicroche(anicroche, sources)
        anicroche.en_vigueur    = en_vigueur?.numero ?? null
        anicroche.a_venir       = programmee ? { numero: programmee.numero, date_parution: programmee.date_parution } : null
        anicroche.a_l_essai     = essai ? { numero: essai.numero } : null
        anicroche.versions      = rangees.filter(est_parue).map(({ numero, date_parution }) => ({ numero, date_parution }))
        anicroche.legale        = $est_legale(anicroche)
        anicroche.preavis       = $soumise_au_preavis(anicroche)
        anicroche.brouillon     = gere && derniere && !est_parue(derniere)
            ? {
                numero        : derniere.numero,
                date_parution : derniere.date_parution,
                acces         : derniere.acces,
                sources       : derniere.numero === affichee?.numero ? sources : await lire_sources_version(anicroche.id, type, derniere.numero)
            }
            : null

        return { code: 200, type, data: anicroche }
    }

    // Versions programmées des anicroches soumises au préavis, d après les types :
    // [{ id_anicroche, titre, numero, date_parution }]
    $lire_versions_a_venir = async () =>
    {
        const ids = Object.values($types_anicroches).flatMap(type => (type.exceptions ?? [])
            .filter(exception => exception.specificites.includes('preavis'))
            .map(exception => exception.identifiant))
        const versions = []

        for (const id of ids)
        {
            const reponse = await $search(adresse_anicroche(id), { projection: 'id;type;versions' })
            if (reponse.code !== 200)
                continue

            const anicroche  = reponse.data
            const derniere   = [ ...anicroche.versions ?? [] ].sort((a, b) => b.numero - a.numero)[0]
            if (!derniere?.date_parution || est_parue(derniere))
                continue

            // Seule la source de titre est lue, dans la langue d origine (- : aucune préférence)
            const role   = role_titre($type_anicroche(anicroche.type))
            const titres = role ? await $search(`sources/${encodeURIComponent(id)}/${encodeURIComponent(role)}/${derniere.numero}/-/-`) : null
            const titre  = $titre_anicroche(anicroche, role && titres?.code === 200 ? { [role]: titres.data?.[0] } : {})

            versions.push({ id_anicroche: id, titre, numero: derniere.numero, date_parution: derniere.date_parution })
        }
        return versions
    }

    $add_action('prior_requested', async (options) =>
    {
        if ($jeton_acces)
            options.headers['Authorization'] = `Bearer ${$jeton_acces}`

        // L API ne tient compte que du profil sélectionné
        if ($profil?.id)
            options.headers['X-Profil'] = $profil.id
    })

    $add_action('post_requested', async (data, options) =>
    {
        if (data?.data?.jeton_acces)
            $jeton_acces = data.data.jeton_acces

        if (options?.url?.pathname === '/connexion' && data?.code === 200)
        {
            if (await $obtenir_compte())
            {
                $navigate_to($compte_actif ? '/' : '/compte')
            }
            else
            {
                $navigate_to(
                    $compte?.is_gerant_of_profils?.length === 0
                        ? '/profil/creation'
                        : '/profil/selection'
                )
            }
        }

        if (options?.url?.pathname === '/deconnexion' && data?.code === 200)
        {
            $jeton_acces = null
            localStorage.removeItem('id_profil')
            $oublier_onglets()
        }

        if (data && data.est_connecte !== undefined)
        {
            $connecte = data.est_connecte ? true : false
            if (!$connecte)
            {
                $compte       = null
                $profil       = null
                $compte_actif = false
            }
        }
    })

    $obtenir_compte = async () =>
    {
        const reponse = await $search('moi')
        if (!reponse.error)
        {
            $compte       = reponse.data
            $compte_actif = !$compte.date_demande_effacement
        }

        // Sans profil sélectionné, l API traite aussi le compte en cours d effacement comme déconnecté
        if (!reponse.error && !$compte_actif)
        {
            $profil = null
            return true
        }

        if (!reponse.error)
        {
            if ($compte?.is_gerant_of_profils?.length === 1)
            {
                return $selectionner_profil($compte.is_gerant_of_profils[0].id)
            }
            else
            {
                return $selectionner_profil(localStorage.getItem('id_profil'))
            }
        }
        else
        {
            return false
        }
    }

    // Écart entre une date et maintenant, en deux formes : court (« 3 h », « dans 2 j ») et
    // long (« il y a 3 heures », « dans 2 jours ») ; null sans date
    $formater_anciennete = (date) =>
    {
        if (!date)
            return null

        const ecart    = new Date(date).getTime() - Date.now()
        const futur    = ecart > 0
        const secondes = Math.abs(ecart) / 1000
        const jours    = secondes / 86400

        const [ nombre, court, singulier, pluriel ] =
            secondes < 3600     ? [ Math.floor(secondes / 60),   'min',  'minute',  'minutes'  ] :
            secondes < 86400    ? [ Math.floor(secondes / 3600), 'h',    'heure',   'heures'   ] :
            jours < 7           ? [ Math.floor(jours),           'j',    'jour',    'jours'    ] :
            jours < 30          ? [ Math.floor(jours / 7),       'sem',  'semaine', 'semaines' ] :
            jours < 365         ? [ Math.floor(jours / 30.44),   'mois', 'mois',    'mois'     ] :
                                  [ Math.floor(jours / 365.25),  'an',   'an',      'ans'      ]

        if (nombre < 1)
            return { court: '< 1 min', long: futur ? "dans un instant" : "à l'instant" }

        const duree_courte = `${nombre} ${court === 'an' && nombre > 1 ? 'ans' : court}`
        const duree_longue = `${nombre} ${nombre > 1 ? pluriel : singulier}`

        return {
            court : futur ? `dans ${duree_courte}` : duree_courte,
            long  : futur ? `dans ${duree_longue}` : `il y a ${duree_longue}`
        }
    }

    // Date lisible (« 19 novembre 2026 », ou « 19 novembre 2026 à 14:05 » avec l heure) : une
    // date seule AAAA-MM-JJ est lue telle quelle, une date et heure de l API (en UTC) dans le
    // fuseau du visiteur
    $formater_date = (date, avec_heure = false) =>
    {
        if (!date)
            return ''

        const jour_seul = /^\d{4}-\d{2}-\d{2}$/.test(String(date))
        const valeur    = new Date(date)
        const jour      = valeur.toLocaleDateString('fr-FR', {
            day      : 'numeric',
            month    : 'long',
            year     : 'numeric',
            timeZone : jour_seul ? 'UTC' : undefined
        })

        if (!avec_heure || jour_seul)
            return jour
        return `${jour} à ${valeur.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}`
    }

    $selectionner_profil = (id) =>
    {
        if (!id)
        {
            return false
        }

        const profil = $compte.is_gerant_of_profils.find(p => p.id == id)

        if (!profil)
        {
            return false
        }

        $profil = profil
        localStorage.setItem('id_profil', id)

        return true
    }

    // ─── Attente des boutons ─────────────────────────────────────────────────

    $est_en_attente = (noeud) => noeud?.getAttribute('aria-busy') === 'true'

    // Décalages du tour des traits : le tracé du rect commence en haut à gauche, après l arrondi,
    // et sa distance au milieu du haut (sur un tour de 100) dépend des proportions du bouton.
    // Le premier trait (10 de long) y est centré au départ
    const placer_indicateur_attente = (noeud) =>
    {
        const trait = noeud.querySelector(':scope > .attente > rect')
        if (!trait)
            return

        const { width, height } = trait.getBBox()
        const rayon     = Math.min(parseFloat(getComputedStyle(trait).rx) || 0, width / 2, height / 2)
        const perimetre = trait.getTotalLength()
        if (perimetre <= 0)
            return

        const debut = 5 - (width / 2 - rayon) / perimetre * 100
        noeud.style.setProperty('--debut-tour-attente',  debut.toFixed(3))
        noeud.style.setProperty('--milieu-tour-attente', (debut - 50).toFixed(3))
        noeud.style.setProperty('--fin-tour-attente',    (debut - 100).toFixed(3))
    }

    // Durée de --d-animation en millisecondes, celle du fondu de l indicateur
    const duree_animation = (noeud) =>
    {
        const valeur = getComputedStyle(noeud).getPropertyValue('--d-animation').trim()
        const nombre = parseFloat(valeur) || 0
        return valeur.endsWith('ms') ? nombre : nombre * 1000
    }

    // Une action est asynchrone quand elle renvoie une promesse : les noeuds donnés restent en
    // attente (aria-busy, .en-attente) jusqu à ce qu elle se termine, réussie ou non. Une action
    // synchrone ne touche à rien : aucun état n est posé, il n y a donc rien à retirer
    $attendre_action = async (noeuds, resultat) =>
    {
        if (typeof resultat?.then !== 'function')
            return resultat

        const liste = [ noeuds ].flat().filter(Boolean)

        // Dans le try : même une erreur pendant la pose de l état passe par le finally
        try
        {
            liste.forEach(noeud =>
            {
                noeud.setAttribute('aria-busy', 'true')
                noeud.classList.remove('fin-attente')
                noeud.classList.add('en-attente')
                placer_indicateur_attente(noeud)
            })

            return await resultat
        }
        finally
        {
            liste.forEach(noeud =>
            {
                noeud.removeAttribute('aria-busy')

                // Les traits continuent de tourner pendant leur fondu
                noeud.classList.replace('en-attente', 'fin-attente')
                setTimeout(() =>
                {
                    if (!noeud.classList.contains('en-attente'))
                        noeud.classList.remove('fin-attente')
                }, duree_animation(noeud))
            })
        }
    }

    // ─── Tiroirs ─────────────────────────────────────────────────────────────

    // Un seul tiroir (boîte de dialogue, modèle tiroir) est ouvert à la fois
    const tiroir_ouvert = () => document.querySelector('dialog.tiroir[open]')

    // Ouvre le tiroir de ce nom ; renvoie false si un tiroir est déjà ouvert ou si aucun ne
    // porte ce nom dans la page. Avec haut (en pixels), le tiroir, quand il s ouvre au bas de
    // l écran, a son haut à cette distance du haut de l écran (la moitié de l écran au plus),
    // même s il est plus grand que son contenu
    $ouvrir_tiroir = (nom, haut = null) =>
    {
        if (tiroir_ouvert())
            return false

        const tiroir = [ ...document.querySelectorAll('dialog.tiroir') ]
            .find(element => element.dataset.tiroir === nom)
        if (!tiroir)
            return false

        tiroir.dataset.chemin = location.pathname
        if (Number.isFinite(haut))
        {
            tiroir.classList.add('positionne')
            tiroir.style.setProperty('--haut-tiroir', `${Math.max(0, haut)}px`)
        }
        // Un tiroir extensible laisse la page utilisable : il n est pas modal
        if (tiroir.classList.contains('extensible'))
            tiroir.show()
        else
            tiroir.showModal()
        tiroir.dispatchEvent(new Event('ouverture-tiroir'))
        return true
    }

    // Ferme le tiroir ouvert, avec son animation
    $fermer_tiroir = () =>
    {
        tiroir_ouvert()?.dispatchEvent(new Event('fermer-tiroir'))
    }

    // Ouvre le sous-menu de ce nom (modèle sous-menu) dans le tiroir ouvert, et revient à son
    // menu principal
    $ouvrir_sous_menu = (nom) =>
    {
        tiroir_ouvert()?.dispatchEvent(new CustomEvent('ouvrir-sous-menu', { detail: nom }))
    }

    $fermer_sous_menu = () =>
    {
        tiroir_ouvert()?.dispatchEvent(new Event('fermer-sous-menu'))
    }

    // Appelée par chaque tiroir à chaque changement de $path : une navigation vers une autre
    // page ferme le tiroir ouvert
    $suivre_navigation_tiroir = (chemin) =>
    {
        const tiroir = tiroir_ouvert()
        if (tiroir && tiroir.dataset.chemin !== chemin)
            $fermer_tiroir()
    }

    // ─── Démarrage ───────────────────────────────────────────────────────────

    // Compte et types d anicroches, chargés au démarrage : le routeur attend leur chargement,
    // sous le même modèle d attente que la page demandée
    $demarrage = Promise.all([ $obtenir_compte(), $charger_types_anicroches() ])
]

tete

corps

fond
