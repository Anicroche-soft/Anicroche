@script [
    $phase = 'chargement'

    $connecte = null
    $jeton_acces = null

    $compte = null
    $profil = null

    // Faux pour un compte dont l effacement est demandé : les pages le traitent alors comme
    // déconnecté, sauf la page du compte, qui affiche l effacement en cours
    $compte_actif = false

    $add_action('prior_requested', async (options) =>
    {
        if ($jeton_acces)
            options.headers['Authorization'] = `Bearer ${$jeton_acces}`

        // L API ne tient compte que du profil sélectionné
        if ($profil?.id)
            options.headers['X-Profil'] = $profil.id
    })

    $add_action('post_requested', async (data, options) =>
    {
        if (data?.data?.jeton_acces)
            $jeton_acces = data.data.jeton_acces

        if (options?.url?.pathname === '/connexion' && data?.code === 200)
        {
            if (await $obtenir_compte())
            {
                $navigate_to($compte_actif ? '/' : '/profil')
            }
            else
            {
                $navigate_to(
                    $compte?.is_gerant_of_profils?.length === 0
                        ? '/profil/creation'
                        : '/profil/selection'
                )
            }
        }

        if (options?.url?.pathname === '/deconnexion' && data?.code === 200)
        {
            $jeton_acces = null
            localStorage.removeItem('id_profil')
        }

        if (data && data.est_connecte !== undefined)
        {
            $connecte = data.est_connecte ? true : false
            if (!$connecte)
            {
                $compte       = null
                $profil       = null
                $compte_actif = false
            }
        }
    })

    $obtenir_compte = async () =>
    {
        const reponse = await $search('moi')
        if (!reponse.error)
        {
            $compte       = reponse.data
            $compte_actif = !$compte.date_demande_effacement
        }

        // Sans profil sélectionné, l API traite aussi le compte en cours d effacement comme déconnecté
        if (!reponse.error && !$compte_actif)
        {
            $profil = null
            return true
        }

        if (!reponse.error)
        {
            if ($compte?.is_gerant_of_profils?.length === 1)
            {
                return $selectionner_profil($compte.is_gerant_of_profils[0].id)
            }
            else
            {
                return $selectionner_profil(localStorage.getItem('id_profil'))
            }
        }
        else
        {
            return false
        }
    }

    $selectionner_profil = (id) =>
    {
        if (!id)
        {
            return false
        }

        const profil = $compte.is_gerant_of_profils.find(p => p.id == id)

        if (!profil)
        {
            return false
        }

        $profil = profil
        localStorage.setItem('id_profil', id)

        return true
    }
]

tete

corps

fond
