@script [
    $connecte = null
    $jeton_acces = null

    $compte = null
    $profil = null

    // Faux pour un compte dont l effacement est demandé : les pages le traitent alors comme
    // déconnecté, sauf la page du compte, qui affiche l effacement en cours
    $compte_actif = false

    // Types d anicroches de l API (GET /types), gardés jusqu à l actualisation de la page :
    // { <nom> : { libelle, identifiant, auteurs, administration, exceptions, sources } }
    $types_anicroches = {}

    // Types rencontrés mais absents de l API même après rechargement : ils ne la font plus
    // recharger jusqu à l actualisation de la page
    const types_inconnus = new Set()

    // Un seul chargement à la fois : les demandes simultanées attendent le même
    let chargement_types = null

    $charger_types_anicroches = () =>
    {
        chargement_types ??= (async () =>
        {
            const reponse = await $search('types')
            if (!reponse.error && reponse.data && typeof reponse.data === 'object')
                $types_anicroches = reponse.data
            chargement_types = null
            return !reponse.error
        })()
        return chargement_types
    }

    // Configuration d un type, ou null s il est inconnu. Un type absent fait recharger les types
    // une fois : toujours absent, il est retenu comme inconnu (sauf si l API n a pas répondu)
    $obtenir_type_anicroche = async (nom) =>
    {
        if (Object.hasOwn($types_anicroches, nom))
            return $types_anicroches[nom]
        if (types_inconnus.has(nom))
            return null

        const charge = await $charger_types_anicroches()

        if (Object.hasOwn($types_anicroches, nom))
            return $types_anicroches[nom]
        if (charge)
            types_inconnus.add(nom)
        return null
    }

    // Version synchrone, pour les gabarits : le type doit déjà avoir été obtenu
    $type_anicroche = (nom) => Object.hasOwn($types_anicroches, nom) ? $types_anicroches[nom] : null

    // Le rôle est celui du profil sélectionné
    $administre_type = (nom) => !!$profil && ($type_anicroche(nom)?.administration ?? []).includes($profil.role)

    // Exceptions : [{ identifiant, specificites }], specificites parmi legalite, preavis et acceptation
    $a_specificite = (anicroche, specificite) =>
        ($type_anicroche(anicroche?.type)?.exceptions ?? [])
            .some(exception => exception.identifiant === anicroche?.id && exception.specificites.includes(specificite))

    $est_legale = (anicroche) => $a_specificite(anicroche, 'legalite')

    $soumise_au_preavis = (anicroche) => $a_specificite(anicroche, 'preavis')

    // Versions programmées des anicroches soumises au préavis, d après les types :
    // [{ id_anicroche, titre, numero, date_parution }]
    $lire_versions_a_venir = async () =>
    {
        const ids = Object.values($types_anicroches).flatMap(type => (type.exceptions ?? [])
            .filter(exception => exception.specificites.includes('preavis'))
            .map(exception => exception.identifiant))
        const versions = []

        for (const id of ids)
        {
            const reponse = await $search(`anicroche/${encodeURIComponent(id)}`)
            const a_venir = reponse.code === 200 ? reponse.data?.a_venir : null
            if (a_venir)
                versions.push({ id_anicroche: id, ...a_venir, titre: a_venir.titre ?? id })
        }
        return versions
    }

    // Sources d une version (telles que les renvoie l API : une source par rôle, ou une liste
    // pour un rôle à plusieurs sources), dans l ordre des rôles du type puis des positions :
    // [{ role, libelle, format, max, position, langue, region, version, contenu }]
    $lister_sources_anicroche = (type, sources) =>
        (type?.sources ?? []).flatMap(source =>
        {
            const valeur = sources?.[source.role]
            const liste  = Array.isArray(valeur) ? valeur : valeur ? [ valeur ] : []
            return liste.map(element => ({
                role    : source.role,
                libelle : source.libelle,
                format  : source.format,
                max     : source.max,
                ...element
            }))
        })

    $add_action('prior_requested', async (options) =>
    {
        if ($jeton_acces)
            options.headers['Authorization'] = `Bearer ${$jeton_acces}`

        // L API ne tient compte que du profil sélectionné
        if ($profil?.id)
            options.headers['X-Profil'] = $profil.id
    })

    $add_action('post_requested', async (data, options) =>
    {
        if (data?.data?.jeton_acces)
            $jeton_acces = data.data.jeton_acces

        if (options?.url?.pathname === '/connexion' && data?.code === 200)
        {
            if (await $obtenir_compte())
            {
                $navigate_to($compte_actif ? '/' : '/compte')
            }
            else
            {
                $navigate_to(
                    $compte?.is_gerant_of_profils?.length === 0
                        ? '/profil/creation'
                        : '/profil/selection'
                )
            }
        }

        if (options?.url?.pathname === '/deconnexion' && data?.code === 200)
        {
            $jeton_acces = null
            localStorage.removeItem('id_profil')
        }

        if (data && data.est_connecte !== undefined)
        {
            $connecte = data.est_connecte ? true : false
            if (!$connecte)
            {
                $compte       = null
                $profil       = null
                $compte_actif = false
            }
        }
    })

    $obtenir_compte = async () =>
    {
        const reponse = await $search('moi')
        if (!reponse.error)
        {
            $compte       = reponse.data
            $compte_actif = !$compte.date_demande_effacement
        }

        // Sans profil sélectionné, l API traite aussi le compte en cours d effacement comme déconnecté
        if (!reponse.error && !$compte_actif)
        {
            $profil = null
            return true
        }

        if (!reponse.error)
        {
            if ($compte?.is_gerant_of_profils?.length === 1)
            {
                return $selectionner_profil($compte.is_gerant_of_profils[0].id)
            }
            else
            {
                return $selectionner_profil(localStorage.getItem('id_profil'))
            }
        }
        else
        {
            return false
        }
    }

    // Date lisible (« 19 novembre 2026 », ou « 19 novembre 2026 à 14:05 » avec l heure) : une
    // date seule AAAA-MM-JJ est lue telle quelle, une date et heure de l API (en UTC) dans le
    // fuseau du visiteur
    $formater_date = (date, avec_heure = false) =>
    {
        if (!date)
            return ''

        const jour_seul = /^\d{4}-\d{2}-\d{2}$/.test(String(date))
        const valeur    = new Date(date)
        const jour      = valeur.toLocaleDateString('fr-FR', {
            day      : 'numeric',
            month    : 'long',
            year     : 'numeric',
            timeZone : jour_seul ? 'UTC' : undefined
        })

        if (!avec_heure || jour_seul)
            return jour
        return `${jour} à ${valeur.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}`
    }

    $selectionner_profil = (id) =>
    {
        if (!id)
        {
            return false
        }

        const profil = $compte.is_gerant_of_profils.find(p => p.id == id)

        if (!profil)
        {
            return false
        }

        $profil = profil
        localStorage.setItem('id_profil', id)

        return true
    }

    // ─── Attente des boutons ─────────────────────────────────────────────────

    $est_en_attente = (noeud) => noeud?.getAttribute('aria-busy') === 'true'

    // Décalages du tour des traits : le tracé du rect commence en haut à gauche, après l arrondi,
    // et sa distance au milieu du haut (sur un tour de 100) dépend des proportions du bouton.
    // Le premier trait (10 de long) y est centré au départ
    const placer_indicateur_attente = (noeud) =>
    {
        const trait = noeud.querySelector(':scope > .attente > rect')
        if (!trait)
            return

        const { width, height } = trait.getBBox()
        const rayon     = Math.min(parseFloat(getComputedStyle(trait).rx) || 0, width / 2, height / 2)
        const perimetre = trait.getTotalLength()
        if (perimetre <= 0)
            return

        const debut = 5 - (width / 2 - rayon) / perimetre * 100
        noeud.style.setProperty('--debut-tour-attente',  debut.toFixed(3))
        noeud.style.setProperty('--milieu-tour-attente', (debut - 50).toFixed(3))
        noeud.style.setProperty('--fin-tour-attente',    (debut - 100).toFixed(3))
    }

    // Durée de --d-animation en millisecondes, celle du fondu de l indicateur
    const duree_animation = (noeud) =>
    {
        const valeur = getComputedStyle(noeud).getPropertyValue('--d-animation').trim()
        const nombre = parseFloat(valeur) || 0
        return valeur.endsWith('ms') ? nombre : nombre * 1000
    }

    // Une action est asynchrone quand elle renvoie une promesse : les noeuds donnés restent en
    // attente (aria-busy, .en-attente) jusqu à ce qu elle se termine, réussie ou non. Une action
    // synchrone ne touche à rien : aucun état n est posé, il n y a donc rien à retirer
    $attendre_action = async (noeuds, resultat) =>
    {
        if (typeof resultat?.then !== 'function')
            return resultat

        const liste = [ noeuds ].flat().filter(Boolean)

        // Dans le try : même une erreur pendant la pose de l état passe par le finally
        try
        {
            liste.forEach(noeud =>
            {
                noeud.setAttribute('aria-busy', 'true')
                noeud.classList.remove('fin-attente')
                noeud.classList.add('en-attente')
                placer_indicateur_attente(noeud)
            })

            return await resultat
        }
        finally
        {
            liste.forEach(noeud =>
            {
                noeud.removeAttribute('aria-busy')

                // Les traits continuent de tourner pendant leur fondu
                noeud.classList.replace('en-attente', 'fin-attente')
                setTimeout(() =>
                {
                    if (!noeud.classList.contains('en-attente'))
                        noeud.classList.remove('fin-attente')
                }, duree_animation(noeud))
            })
        }
    }

    // ─── Démarrage ───────────────────────────────────────────────────────────

    // Compte et types d anicroches, chargés au démarrage : le routeur attend leur chargement,
    // sous le même modèle d attente que la page demandée
    $demarrage = Promise.all([ $obtenir_compte(), $charger_types_anicroches() ])
]

tete

corps

fond
