@script [
    $format      = `petit`
    $orientation = `paysage`
    $pointeur    = `precis`
    $theme       = `clair`
    $defilement  = `sommet`

    // Titre propre à la page, affecté par chaque page (voir $title plus bas)
    $titre = null

    // Puce du menu dont relève la page (accueil, explorer, creer, gadgets, profil), affectée
    // par chaque page
    $puce = null

    // Route de l adresse (voir routeur), déclarée ici pour que le menu et les pages la voient
    $route = null

    // Adresse actuelle de chaque page à adresse fixe ($routes, dans app.adn), par le nom de sa
    // route : celle de son dernier onglet affiché pour une page dont les onglets ont chacun leur
    // adresse, sinon son adresse. Une ancre vers un nom de route y prend son adresse (voir
    // boite-ancre). Les routes à captures (anicroches) et sans adresse (introuvable) n y sont pas
    $adresses_pages = {}

    const adresses_route = (route) => route?.path === undefined ? [] : [route.path].flat()

    $oublier_onglets = () =>
    {
        $adresses_pages = Object.fromEntries(
            Object.entries($routes ?? {})
                .map(([nom, route]) => [nom, adresses_route(route)])
                .filter(([nom, adresses]) => adresses.length && !adresses.some(adresse => adresse.includes('<$')))
                .map(([nom, adresses]) => [nom, adresses[0]])
        )
    }

    // Retient l adresse d un onglet affiché, si elle est l une de celles d une route à plusieurs
    // adresses
    $retenir_onglet = (adresse) =>
    {
        const nom = Object.keys($adresses_pages).find(nom =>
            adresses_route($routes[nom]).length > 1 && adresses_route($routes[nom]).includes(adresse))

        if (nom && $adresses_pages[nom] !== adresse)
            $adresses_pages = { ...$adresses_pages, [nom]: adresse }
    }

    $oublier_onglets()

    const actualiser_format = () =>
    {
        const w = window.innerWidth
        const h = window.innerHeight

        $format = w > 1024 ? `grand` : `petit`
        $orientation = w > h ? `paysage` : `portrait`

        document.documentElement.classList.remove(`grand`,   `petit`, `paysage`, `portrait`)
        document.documentElement.classList.add($format, $orientation)
    }

    const actualiser_pointeur = (media_query) =>
    {
        $pointeur = media_query.matches ? `grossier` : `precis`

        document.documentElement.classList.remove(`grossier`, `precis`)
        document.documentElement.classList.add($pointeur)
    }

    const actualiser_theme = (media_query_theme) =>
    {
        $theme = media_query_theme.matches ? `sombre` : `clair`

        document.documentElement.classList.remove(`clair`, `sombre`)
        document.documentElement.classList.add($theme)
    }

    // Appelée à chaque défilement d'un onglet : rien ne change tant que l état reste le même,
    // car modifier les classes de <html> fait recalculer les styles de toute la page
    $actualiser_defilement = (defilement) =>
    {
        const racine = document.documentElement

        if (![ `interieur`, `sommet` ].includes(defilement) || racine.classList.contains(defilement))
            return

        $defilement = defilement
        racine.classList.remove(defilement === `interieur` ? `sommet` : `interieur`)
        racine.classList.add(defilement)
    }

    const media_query_pointeur = window.matchMedia(`(pointer: coarse)`)
    const media_query_theme = window.matchMedia(`(prefers-color-scheme: dark)`)

    actualiser_format()
    actualiser_pointeur(media_query_pointeur)
    actualiser_theme(media_query_theme)
    $actualiser_defilement(`sommet`)

    window.addEventListener(`resize`, actualiser_format)
    media_query_pointeur.addEventListener(`change`, actualiser_pointeur)
    media_query_theme.addEventListener(`change`, actualiser_theme)
]

@style [
    @font-face {
        font-family: "Eczar";
        src: url("/systeme/fontes/Eczar.ttf") format("truetype");
        font-weight: 400 800;
        font-style: normal;
        font-display: swap;
    }

    * {
        gap: var(--l-ecart);

        background:      var(--f-fond);
        font-family:     var(--p-fonte);
        font-size:       var(--l-fonte);
        font-weight:     var(--e-fonte);
        line-height:     1;
        color:           var(--c-flux);
        scrollbar-color: var(--c-flux) transparent;

        outline-style:  solid;
        outline-color:  transparent;
        outline-width:  0.125rem;
        outline-offset: 0.125rem;

        transition: outline-color var(--d-animation);

        --f-fond: transparent;
        --c-focus: var(--c-flux);
    }

    *:focus-visible {
        outline-color: var(--c-focus);
    }

    *::selection {
        color: var(--c-fond);
        background: var(--c-flux);
    }

    a, button {
        cursor: pointer;
    }

    /* Par défaut, un fieldset ne rétrécit pas sous la largeur de son contenu (min-content) :
       un contenu long le ferait dépasser de son conteneur au lieu de se replier ou d'être coupé */
    fieldset {
        min-inline-size: 0;
    }

    /* Étiquette d'un champ de formulaire */
    .etiquette {
        --e-fonte: var(--e-etiquette);
    }

    path {
        stroke: var(--c-flux);
        stroke-width: 0.125rem;
        stroke-linejoin: round;
        stroke-linecap: round;
        fill: none;
    }

    .icone.lettre path {
        stroke-linecap: butt;
    }

    html {
        overflow: hidden;

        --p-fonte:  var(--p-texte);
        --p-titre:  'Eczar', serif;
        --p-texte:  sans-serif;
        --p-bouton: monospace;
        --p-champ:  monospace;

        --l-fenetre: 100dvw;
        --l-fonte: 1rem;
        --l-ligne: 1;
        --l-ecart: 1rem;
        --l-marge: 1rem;
        --l-blur: 4rem;
        --l-tete: 10.625rem;
        --h-tete: 100dvh;
        --h-navigation: 3.5rem;
        --h-avatar: 2rem;

        --e-fonte:     var(--e-texte);
        --e-titre:     450;
        --e-texte:     400;
        --e-gras:      600;
        --e-bouton:    600;
        --e-etiquette: var(--e-gras);

        --d-animation:      500ms;
        --d-animation-page: calc(var(--d-animation) / 2);

        --t-theme: 30;
        --t-avatar: var(--t-theme);

        --s-theme: 0.2;

        --p-trans: 50%;

        --c-noir:  oklch(0.00 0.00 0);
        --c-blanc: oklch(1.00 0.00 0);
        --c-trans: oklch(1.00 0.00 0 / 0%);

        --c-noir-trans:  oklch(0.00 0.00 0 / var(--p-trans));
        --c-blanc-trans: oklch(1.00 0.00 0 / var(--p-trans));

        --c-boue:  oklch(0.25 calc(var(--s-theme) / 20) var(--t-theme));
        --c-creme: oklch(0.95 calc(var(--s-theme) / 20) var(--t-theme));

        --c-boue-trans:  oklch(0.25 calc(var(--s-theme) / 20) var(--t-theme) / var(--p-trans));
        --c-creme-trans: oklch(0.95 calc(var(--s-theme) / 20) var(--t-theme) / var(--p-trans));

        --c-sombre: oklch(0.45 var(--s-theme) var(--t-theme));
        --c-vif:    oklch(0.65 var(--s-theme) var(--t-theme));
        --c-clair:  oklch(0.85 var(--s-theme) var(--t-theme));

        --c-sombre-trans: oklch(0.45 var(--s-theme) var(--t-theme) / var(--p-trans));
        --c-vif-trans:    oklch(0.65 var(--s-theme) var(--t-theme) / var(--p-trans));
        --c-clair-trans:  oklch(0.85 var(--s-theme) var(--t-theme) / var(--p-trans));

        --f-fond: var(--c-theme);
        --c-fond: var(--c-theme);
        --c-flux: var(--c-inverse);
    }

    html.petit {
        --h-navigation: 3rem;
    }

    html.petit.paysage {
        --l-tete: 3.5rem;
    }

    html.petit.portrait {
        --l-tete: 0rem;
        --h-tete: 3.5rem;
    }

    .clair {
        color-scheme: light;

        --c-theme:    var(--c-blanc);
        --c-analogue: var(--c-creme);
        --c-inverse:  var(--c-boue);

        --c-theme-trans:    var(--c-blanc-trans);
        --c-analogue-trans: var(--c-creme-trans);
        --c-inverse-trans:  var(--c-boue-trans);

        --c-plus:     var(--c-clair);
        --c-moins:    var(--c-sombre);

        --c-plus-trans:     var(--c-clair-trans);
        --c-moins-trans:    var(--c-sombre-trans);

        --f-degrade-vif: linear-gradient(90deg, var(--c-vif), var(--c-clair));
        --f-degrade-vif-trans: linear-gradient(90deg, var(--c-vif-trans), var(--c-clair-trans));
    }

    .sombre {
        color-scheme: dark;

        --c-theme:    var(--c-noir);
        --c-analogue: var(--c-boue);
        --c-inverse:  var(--c-creme);

        --c-theme-trans:    var(--c-noir-trans);
        --c-analogue-trans: var(--c-boue-trans);
        --c-inverse-trans:  var(--c-creme-trans);

        --c-plus:     var(--c-sombre);
        --c-moins:    var(--c-clair);

        --c-plus-trans:     var(--c-sombre-trans);
        --c-moins-trans:    var(--c-clair-trans);

        --f-degrade-vif: linear-gradient(90deg, var(--c-sombre), var(--c-vif));
        --f-degrade-vif-trans: linear-gradient(90deg, var(--c-sombre-trans), var(--c-vif-trans));
    }

    body {
        width: var(--l-fenetre);
        height: 100dvh;

        gap: 0;
    }

    /* Sans JavaScript (page construite par le serveur, au format petit portrait), le site garde
       la largeur d'un téléphone ; le transform rattache au body les éléments fixes */
    html:not(.avec-js) {
        --l-fenetre: min(100dvw, 32rem);
        background: var(--c-analogue);
    }

    html:not(.avec-js) body {
        margin-inline: auto;
        transform: translateZ(0);
    }
]

$title = [$titre] ? "$titre – $app.config.name" : :o

-base

?chargement
