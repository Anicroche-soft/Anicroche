@style [
    #menu {
        flex: 1;

        --l-ecart: 2rem;
    }

    #menu span {
        --e-fonte: var(--e-texte);
        --p-fonte: var(--p-texte);
    }

    .grand #menu .alt,
    .petit #menu span:not(.alt) {
        display: none;
    }

    #menu > .boite-ancre.actif {
        --c-flux: var(--c-moins);
    }

    /* La couleur se calcule sur chaque élément à partir de --c-flux, hérité sans transition */
    #menu > .boite-ancre span {
        transition: color var(--d-animation);
    }

    #menu > .boite-ancre path {
        transition: stroke var(--d-animation);
    }

    .petit #menu {
        justify-content: flex-end;

        --l-ecart: 1rem;
    }

    .petit.portrait #menu {
        justify-content: space-around;
        flex-direction: row;
    }
]

# Chaque puce mène à une page par le nom de sa route (app.adn) : la puce Profil ramène au dernier
# onglet affiché (profil ou compte). Explorer et Créer n'ont pas encore de page
<nav #menu>
    boite-ancre [accueil, Accueil, $actif : [$puce = accueil] ? :)]
        icone-maison
        <span>
            "Accueil"

    boite-ancre [/explorer, Explorer, $actif : [$puce = explorer] ? :)]
        icone-arc
        <span>
            "Explorer"

    boite-ancre [/creer, Créer, $actif : [$puce = creer] ? :)]
        icone-baguette
        <span>
            "Créer"

    boite-ancre [gadgets, Gadgets, $actif : [$puce = gadgets] ? :)]
        icone-aimant
        <span>
            "Gadgets"

    # Un compte dont l'effacement est demandé n'a accès qu'à la page du compte
    @if [$connecte & ! $compte_actif]
        boite-ancre [/compte, Compte, $actif : [$puce = profil] ? :)]
            icone-masque
            <span>
                "Compte"
    @else-if [$connecte]
        boite-ancre [profil, Profil, $actif : [$puce = profil] ? :)]
            icone-masque
            <span>
                "Profil"
    @else
        boite-ancre [connexion, Profil, $actif : [$puce = profil] ? :)]
            icone-masque
            <span>
                "Connexion"
