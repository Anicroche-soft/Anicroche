@script [
    // Adresse que suit l onglet actif (voir $suivre_adresse_onglet)
    $chemin_onglets = null

    $monter_page = () =>
    {
        const noeud = $node
        const vars  = $vars

        noeud.classList.add('entree')
        void noeud.offsetWidth
        requestAnimationFrame(() =>
            requestAnimationFrame(() =>
                noeud.classList.remove('entree')
            )
        )

        // Une page dont les onglets ont une adresse s ouvre sur l onglet de l adresse actuelle
        const n_initial = onglet_de_l_adresse(noeud)
        if (n_initial > 1)
        {
            const onglets = noeud.querySelectorAll(':scope > .onglet')
            onglets[n_initial - 1].scrollIntoView({ behavior: 'instant', block: 'nearest', inline: 'start' })
        }

        $chemin_onglets = $path
        if (n_initial)
            $retenir_onglet($path)
        marquer_onglet_actif(noeud, n_initial || 1, vars)
        atteindre_ancre(noeud, vars)

        noeud.addEventListener('scroll', () =>
        {
            const ratio = noeud.scrollLeft / (noeud.scrollWidth - noeud.clientWidth)

            const barre = noeud.querySelector(':scope .barre-onglets')
            if (barre)
            {
                const boutons = barre.querySelectorAll(':scope > .bouton-onglet')
                const indicateur = barre.querySelector(':scope > .indicateur')

                if (indicateur)
                {
                    const nb = boutons.length
                    indicateur.style.left = `calc((100% - ${nb - 1}rem) / ${nb} * ${ratio * (nb - 1)} + ${ratio * (nb - 1)}rem)`
                }
            }

            const onglets = noeud.querySelectorAll(':scope > .onglet')
            const n = Math.round(ratio * (onglets.length - 1)) + 1
            marquer_onglet_actif(noeud, n, vars)

            // L adresse suit l onglet une fois le défilement arrêté, pas les onglets traversés
            clearTimeout(vars.minuteur_adresse)
            vars.minuteur_adresse = setTimeout(() => synchroniser_adresse(noeud), 150)
        })
    }

    // $path a changé alors que la page est affichée (lien vers un autre de ses onglets,
    // $navigate_to…) : la page bascule vers l onglet de la nouvelle adresse
    $suivre_adresse_onglet = () =>
    {
        const page = $node.closest('.page')
        if (!page)
            return

        // Avant le montage de la page, c est $monter_page qui choisit l onglet
        if (!page.querySelector(':scope > .onglet.actif'))
            return

        $chemin_onglets = $path

        const n = onglet_de_l_adresse(page)
        if (n)
            $retenir_onglet($path)

        const onglets = page.querySelectorAll(':scope > .onglet')
        if (n && !onglets[n - 1].classList.contains('actif'))
            $basculer_vers_onglet(n, page)
    }

    $demonter_page = async () =>
    {
        clearTimeout($vars.minuteur_adresse)

        if ($vars.onglet_actif && $vars.sur_scroll_onglet)
            $vars.onglet_actif.removeEventListener('scroll', $vars.sur_scroll_onglet)

        const style = getComputedStyle($node)

        const parseTime = (value) =>
        {
            return value.split(',')
                .map(v => v.trim())
                .map(v => v.endsWith('ms') ? parseFloat(v) : parseFloat(v) * 1000)
        }

        const durations = parseTime(style.transitionDuration)
        const delays = parseTime(style.transitionDelay)

        const times = durations.map((d, i) => d + (delays[i] || 0))
        const maxTime = Math.max(...times, 0)

        $node.classList.add('sortie')

        await new Promise(r => setTimeout(r, maxTime))
    }

    $basculer_vers_onglet = (n, noeud = $node) =>
    {
        const page = noeud.closest('.page')
        if (!page) return

        const onglets = page.querySelectorAll(':scope > .onglet')
        const cible = onglets[n - 1]
        if (!cible) return

        cible.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' })

        marquer_onglet_actif(page, n)
        synchroniser_adresse(page)
    }

    $basculer_vers_onglet_suivant = (noeud = $node) =>
    {
        const page = noeud.closest('.page')
        if (!page) return

        const onglets = page.querySelectorAll(':scope > .onglet')
        const actif = [...onglets].findIndex(onglet => onglet.classList.contains('actif'))
        if (actif === -1 || actif === onglets.length - 1) return

        $basculer_vers_onglet(actif + 2, noeud)
    }

    $basculer_vers_onglet_precedant = (noeud = $node) =>
    {
        const page = noeud.closest('.page')
        if (!page) return

        const onglets = page.querySelectorAll(':scope > .onglet')
        const actif = [...onglets].findIndex(onglet => onglet.classList.contains('actif'))
        if (actif <= 0) return

        $basculer_vers_onglet(actif, noeud)
    }

    // Une adresse avec ancre (/compte) ouvre l onglet qui contient l élément visé, puis
    // y fait défiler la page jusqu à lui
    const atteindre_ancre = (page, vars) =>
    {
        let id = ''
        try
        {
            id = decodeURIComponent(String($hash ?? '').replace(/^#/, ''))
        }
        catch
        {
            return
        }
        if (!id)
            return

        const cible  = [...page.querySelectorAll('[id]')].find(element => element.id === id)
        const onglet = cible?.closest('.onglet')
        if (!onglet || onglet.parentElement !== page)
            return

        const onglets = [...page.querySelectorAll(':scope > .onglet')]

        onglet.scrollIntoView({ behavior: 'instant', block: 'nearest', inline: 'start' })
        cible.scrollIntoView({ behavior: 'instant', block: 'start', inline: 'nearest' })
        marquer_onglet_actif(page, onglets.indexOf(onglet) + 1, vars)
    }

    // Adresses des onglets, dans l ordre des boutons de la barre (null : onglet sans adresse)
    const lire_adresses_onglets = (page) =>
        [...page.querySelectorAll(':scope .bouton-onglet')].map(bouton => bouton.getAttribute('href'))

    // Numéro de l onglet dont l adresse est $path, ou 0
    const onglet_de_l_adresse = (page) =>
        lire_adresses_onglets(page).indexOf($path) + 1

    // Remplace l adresse par celle de l onglet actif, sans nouvelle entrée dans l historique.
    // Rien ne change si l adresse actuelle n est pas celle d un des onglets : la page est
    // peut-être en train d être quittée
    const synchroniser_adresse = (page) =>
    {
        if (!page.isConnected || page.classList.contains('sortie'))
            return

        const adresses = lire_adresses_onglets(page)
        if (!adresses.includes($path))
            return

        const onglets = [...page.querySelectorAll(':scope > .onglet')]
        const adresse = adresses[onglets.findIndex(onglet => onglet.classList.contains('actif'))]
        if (!adresse || adresse === $path)
            return

        $chemin_onglets = adresse
        $retenir_onglet(adresse)
        $navigate_to(adresse, true)
    }

    const marquer_onglet_actif = (page, n, vars = null) =>
    {
        const boutons_onglets = page.querySelectorAll(':scope .bouton-onglet')
        boutons_onglets.forEach((bouton_onglet, i) =>
        {
            const actif = i === n - 1
            bouton_onglet.classList.toggle('actif', actif)
        })

        const onglets = page.querySelectorAll(':scope > .onglet')
        onglets.forEach((onglet, i) =>
        {
            const actif = i === n - 1
            onglet.classList.toggle('actif', actif)
            onglet.inert = !actif

            if (actif && vars)
            {
                if (vars.onglet_actif && vars.onglet_actif !== onglet)
                    vars.onglet_actif.removeEventListener('scroll', vars.sur_scroll_onglet)

                vars.onglet_actif = onglet

                vars.sur_scroll_onglet = () =>
                {
                    $actualiser_defilement(onglet.scrollTop > 0 ? `interieur` : `sommet`)
                }

                onglet.addEventListener('scroll', vars.sur_scroll_onglet)

                $actualiser_defilement(onglet.scrollTop > 0 ? `interieur` : `sommet`)
            }
        })
    }
]

@style [
    .page {
        flex-direction: row;
        height: 100%;
        overflow-x: hidden;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;

        gap: 0;
        padding-left: var(--l-tete);

        transition: opacity var(--d-animation-page);
        scroll-behavior: smooth;
    }

    .page.defilable {
        overflow-x: auto;
    }

    .page::-webkit-scrollbar {
        display: none;
    }

    /* Sans JavaScript (rendu côté serveur), la page ne défile pas : seul l onglet actif,
       celui de l adresse, est affiché */
    :root:not(.avec-js) .page > .onglet:not(.actif) {
        display: none;
    }

    .page img {
        border-radius: 1rem;
        max-width: 100%;
    }
]

# $authentification : libre, interdite (déconnecté seulement), requise, requise_sans_profil,
# ou ouverte (aucune vérification : pages reçues par courriel). Un compte dont l'effacement
# est demandé est traité comme déconnecté, sauf sur la page du compte ($page_compte), qui
# affiche l'effacement en cours ; une page qui exige d'être connecté le renvoie vers elle,
# sauf si elle lui reste ouverte ($compte_suspendu)
@args [$defilable : :), $authentification : libre, $page_compte : :(, $compte_suspendu : :(]

<div
    .page
    [$defilable] ? .defilable
    @mount="$monter_page()"
    @unmount="await $demonter_page()"
>
    @if [$path != $chemin_onglets]
        <div hidden @mount="$suivre_adresse_onglet()">

    @static
        @if [$page_compte & $connecte & ! $compte_actif]
            navigation
                <div .gauche>

                <div .centre>
                    <span>
                        "Suppression du compte"

                <div .droite>
                    icone-horloge

            onglet
                section-effacement-en-cours

        @else-if [$authentification = interdite & $connecte]
            navigation
                <div .gauche>
                    fleche-retour

                <div .centre>

                <div .droite>
                    icone-horloge

            onglet
                section-deja-connecte

        @else-if [$authentification -{ [requise, requise_sans_profil] & $connecte & ! $compte_actif & ! $compte_suspendu]
            navigation
                <div .gauche>
                    fleche-retour

                <div .centre>

                <div .droite>
                    icone-horloge

            onglet
                section-compte-en-suppression

        @else-if [$authentification -{ [requise, requise_sans_profil] & ! $connecte]
            navigation
                <div .gauche>
                    fleche-retour

                <div .centre>

                <div .droite>
                    icone-horloge

            onglet
                section-pas-encore-connecte

        @else-if [$authentification -{ [requise, libre] & $compte_actif & ! $profil]
            navigation
                <div .gauche>
                    fleche-retour

                <div .centre>

                <div .droite>
                    icone-horloge

            onglet
                section-pas-de-profil

        @else
            @stud
