nom          : Apicroche
langue       : fr
cors_headers : [ X-Profil ]

types_anicroches : {
    page : {
        libelle        : Page
        identifiant    : libre
        auteurs        : :(
        administration : [ maitre ]
        sources        : {
            titre : {
                libelle : Titre
                format  : titre
                nombre  : 1-1
            }
            contenu : {
                libelle : Contenu
                format  : texte
                nombre  : 1-1
            }
        }
        exceptions     : [
            {
                identifiant  : conditions-generales-d-utilisation
                sources      : {
                    titre : "Conditions générales d'utilisation"
                }
                specificites : [ legalite, preavis, acceptation ]
            }
            {
                identifiant  : politique-de-confidentialite
                sources      : {
                    titre : "Politique de confidentialité"
                }
                specificites : [ legalite, preavis ]
            }
            {
                identifiant  : mentions-legales
                sources      : {
                    titre : "Mentions légales"
                }
                specificites : [ legalite ]
            }
        ]
    }
}
