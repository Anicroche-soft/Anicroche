@name [ sessions, session ]

@primary [ id ]

@fields [
    {
        name    : id
        type    : char
        size    : 21
        chars   : [A-Z0-9]
        default : auto
    }

    {
        alt     : jeton
        name    : hachage_jeton
        type    : hash
        size    : 1-256
        chars   : [a-z0-9]
        length  : 64
        default : auto
    }

    {
        name    : date_emission
        type    : datetime
        default : now
    }

    {
        name    : date_validite
        type    : datetime
        default : now+30d
    }

    {
        name  : date_revocation
        type  : datetime
        count : 0-1
    }

    {
        name  : adresse_ip
        type  : char
        size  : 1-45
        count : 0-1
    }

    {
        name  : agent_utilisateur
        type  : text
        count : 0-1
    }

    {
        name  : nom_appareil
        type  : char
        size  : 1-256
        count : 0-1
    }
]

# DELETE /session/<id> révoque une session du compte connecté (la ligne est supprimée, comme
# le ferait $nettoyer_sessions) ; révoquer la session en cours revient à se déconnecter
@rules [
    can_delete      : "$context.compte"
    restrict_delete : "#id_compte = $context.compte.id"
    prior_delete    : $preparer_revocation()
    post_delete     : $terminer_revocation($values)
]

@script [
    $preparer_revocation = async () =>
    {
        await $exiger_compte()
    }

    $terminer_revocation = ($values) =>
    {
        if ($values.id !== $context.session?.id)
            return

        // $detecter_connexion (authentification.sans) répond alors est_connecte : false
        $context.compte = null
        $set_cookie('jeton', '', { lifetime: 0 })
    }
]
