@name [ comptes, compte ]

@primary [ id ]

@fields [
    {
        name    : id
        type    : char
        size    : 12
        chars   : [A-Z0-9]
        default : auto
    }

    # PATCH /compte/<id> { mot_de_passe, clef, ids }, avec une clef modification-mot-de-passe
    # envoyée à l adresse principale
    {
        alt   : mot_de_passe
        name  : hachage_mot_de_passe
        type  : hash
        size  : 1-256
        count : 0-1
        rule  : "$hachage_mot_de_passe ~= /^.{12,128}$/"

        can_update   : "$context.compte"
        prior_update : $preparer_modification_mot_de_passe()
        post_update  : $notifier_modification_mot_de_passe()
    }

    # PATCH /compte/<id> { date_naissance }
    {
        name : date_naissance
        type : crypt
        size : 1-64
        rule : "$date_naissance ~= /^\d{4}-\d{2}-\d{2}$/"

        can_update   : "$context.compte"
        prior_update : $verifier_date_naissance($values)
    }

    {
        name : date_acceptation_conditions
        type : datetime
    }

    {
        name    : date_inscription
        type    : date
        default : now
    }

    # Activité et fin de compte : voir effacement.sans
    {
        name    : date_derniere_activite
        type    : datetime
        default : now
    }

    # Avertissements envoyés : d inactivité depuis la dernière activité, ou rappels de l effacement demandé
    {
        name    : nombre_avertissements
        type    : tinyint
        default : 0
    }

    {
        name  : date_premier_avertissement
        type  : datetime
        count : 0-1
    }

    {
        name  : date_demande_effacement
        type  : datetime
        count : 0-1
    }

    # L effacement est refusé quelques jours après un changement d adresse principale
    # (voir coordonnees.sans et effacement.sans)
    {
        name  : date_changement_courriel_principal
        type  : datetime
        count : 0-1
    }

    # Suspend la suppression pour inactivité (litige, réquisition, somme due…) : renseignée
    # à la main, jamais par une route
    {
        name  : date_conservation
        type  : datetime
        count : 0-1
    }

    {
        name  : coordonnees
        count : 0-N
    }

    {
        name  : sessions
        count : 0-N
    }

    {
        name  : annonces
        count : 0-N
    }
]

@rules [
    restrict_update : "#id = $context.compte.id"
    prior_update    : $preparer_modification_compte()
]

@routes [
    {
        path   : /moi
        method : get
        action : "$obtenir_compte()"
    }

    {
        path   : /inscription
        action : $inscrire_compte($body)
    }

    {
        path   : /connexion
        action : "$connecter_compte($body, $request)"
    }

    {
        path   : /deconnexion
        action : $deconnecter_compte($request)
    }
]

@script [
    $obtenir_compte = async () =>
    {
        await $exiger_compte({ effacement_demande: true })

        const compte = await $search_one('comptes',
            `
            #id = $id_compte
            `,
            { $id_compte: $context.compte.id },
            { select: 'id ; date_inscription ; date_naissance ; date_demande_effacement ; date_changement_courriel_principal ; coordonnees.id,type,coordonnee,est_principale,date_ajout ; sessions.id,date_emission,date_validite,date_revocation,adresse_ip,agent_utilisateur,nom_appareil ; is_gerant_of_profils.id,identifiant,pseudonyme,role,date_creation,sort,date_fermeture,desactive' }
        )

        const maintenant = new Date()

        // Adresses chiffrées en base, donc triées ici : la principale, puis par ordre alphabétique
        compte.coordonnees = (compte.coordonnees ?? []).sort((a, b) =>
            (b.est_principale ? 1 : 0) - (a.est_principale ? 1 : 0)
         || String(a.coordonnee).localeCompare(String(b.coordonnee), 'fr')
        )

        compte.date_effacement          = $date_effacement(compte)
        compte.date_effacement_possible = $date_effacement_possible(compte)
        compte.sessions                 = (compte.sessions ?? [])
            .filter(session => !session.date_revocation && new Date(session.date_validite) > maintenant)
            .map(({ date_revocation, ...session }) => ({ ...session, est_actuelle: session.id === $context.session?.id }))
            .sort((a, b) => new Date(b.date_emission) - new Date(a.date_emission))

        delete compte.date_changement_courriel_principal

        return $indicate(200, "Compte récupéré", compte)
    }

    // ─── Modification (PATCH /compte/<id>) ───────────────────────────────────

    $preparer_modification_compte = async () =>
    {
        await $exiger_compte()
    }

    // Un majeur ne peut pas devenir mineur, et un mineur ne peut que rajeunir, sans passer sous
    // l âge minimum (sauf, plus tard, pour un compte sous contrôle parental)
    $verifier_date_naissance = ($values) =>
    {
        const actuelle = $context.compte.date_naissance
        const age      = $calculer_age($values.date_naissance)

        if (age === null)
            return $indicate(422, "Date de naissance invalide")

        if (age < $age_minimum())
            return $indicate(403, "Âge minimum non atteint")

        const age_actuel = $calculer_age(actuelle)
        const vieillit   = $values.date_naissance < actuelle

        if (age_actuel >= $age_majorite() ? age < $age_majorite() : vieillit)
            return $indicate(403, "Modification de la date de naissance refusée")
    }

    $preparer_modification_mot_de_passe = async () =>
    {
        $context.principale = await $verifier_clef_principale('modification-mot-de-passe')
    }

    // Les autres sessions sont fermées : un voleur qui en aurait une perd son accès
    $notifier_modification_mot_de_passe = async () =>
    {
        await $consommer_clefs($context.principale.coordonnee, 'modification-mot-de-passe')

        await $delete_all('sessions',
            `
            #id_compte = $id_compte
          & #id       != $id_session
            `,
            { $id_compte: $context.compte.id, $id_session: $context.session.id }
        )

        await $ecrire_courriels(await $lire_courriels($context.compte.id),
            "Le mot de passe de votre compte Anicroche a changé",
            `<p>Le mot de passe de votre compte Anicroche a été changé, et vos autres sessions ont été fermées.</p>`
          + `<p>Si vous n'êtes pas à l'origine de ce changement, changez-le de nouveau sans attendre, à l'aide d'un code envoyé à votre adresse principale.</p>`
        )
    }

    $inscrire_compte = async ($body) =>
    {
        if (
            !$body.coordonnee
         || !$body.clef
         || !$body.mot_de_passe
         || !$body.date_naissance
         || !Array.isArray($body.ids)
         || !$body.ids.length
        )
            return $indicate(400, "Corps incomplet")

        // Vérifiés avant la clef, pour ne pas consommer d'essai
        const age = $calculer_age($body.date_naissance)

        if (age === null)
            return $indicate(422, "Date de naissance invalide")

        if (age < $age_minimum())
            return $indicate(403, "Âge minimum non atteint")

        if ($body.accepte_conditions !== true)
            return $indicate(422, "Conditions d'utilisation non acceptées")

        // Tant qu'aucune version des conditions n'est publiée, seul le premier compte peut être
        // créé (celui de l'éditeur, qui publiera les conditions)
        const conditions = await $version_en_vigueur('conditions-generales-d-utilisation')

        if (!conditions && await $search_one('compte', `:)`, {}, { select: 'id' }))
            return $indicate(503, "Conditions d'utilisation indisponibles")

        const clef = await $verifier_clef()

        const coordonnee_existante = await $search_one('coordonnee',
            `
            #hachage_coordonnee = $body.coordonnee
            `
        )

        if (!clef || coordonnee_existante)
            return $indicate(403, 'Accès refusé')

        await $delete_all('clefs',
            `
            #hachage_coordonnee = $body.coordonnee
          & #type               = authentification
            `
        )

        const compte = await $create_one('compte', {
            hachage_mot_de_passe        : $body.mot_de_passe,
            date_naissance              : $body.date_naissance,
            date_acceptation_conditions : new Date()
        })

        // Les codes ne sont envoyés que par courriel ; deux inscriptions simultanées peuvent passer la vérification de la clef
        try
        {
            await $create_one('coordonnee', {
                type               : 'courriel',
                coordonnee         : $body.coordonnee,
                hachage_coordonnee : $body.coordonnee,
                est_principale     : true,
                id_compte          : compte.id
            })
        }
        catch (erreur)
        {
            await $delete_one('compte', `#id = $compte.id`, { $compte: compte })
            throw erreur
        }

        // Pendant un préavis, l étape des conditions annonce aussi les versions à venir : le
        // nouveau compte ne reçoit pas leur courriel
        await $enregistrer_annonces(compte.id, await $versions_programmees(), 'inscription')

        return $indicate(201, "Inscription réussie")
    }

    $connecter_compte = async ($body, $request) =>
    {
        if (
            !$body.coordonnee
         || (
                !$body.mot_de_passe
             && (
                    !$body.clef
                 || !Array.isArray($body.ids)
                 || !$body.ids.length
                )
            )
        )
            return $indicate(400, "Corps incomplet")

        const coordonnee = await $search_one('coordonnee',
            `
            #hachage_coordonnee = $body.coordonnee
            `
        )

        if ($body.mot_de_passe)
        {
            await $limit('echecs_mot_de_passe', '20/1h', { count: false })

            const compte = coordonnee
                ? await $search_one('compte',
                    `
                    #id                   = $coordonnee.id_compte
                  & #hachage_mot_de_passe = $body.mot_de_passe
                    `,
                    { $coordonnee: coordonnee }
                )
                : await $verify_hash(null, $body.mot_de_passe)

            if (!compte)
            {
                await $limit('echecs_mot_de_passe', '20/1h')
                return $indicate(403, "Accès refusé")
            }
        }
        else
        {
            const clef = await $verifier_clef()

            if (!clef || !coordonnee)
                return $indicate(403, 'Accès refusé')

            await $delete_all('clefs',
                `
                #hachage_coordonnee = $body.coordonnee
              & #type               = authentification
                `
            )
        }

        const session = await $create_one('session',
            {
                adresse_ip        : $request.ip,
                agent_utilisateur : $request.user_agent,
                nom_appareil      : $nommer_appareil($request.user_agent),
                id_compte         : coordonnee.id_compte
            }
        )

        const cookie_session = `${session.id}.${session.jeton}`
        $set_cookie('jeton', cookie_session, { lifetime: '30d' })


        const jeton_acces = await $sign_token({ type: 'acces', id_compte: coordonnee.id_compte, id_session: session.id })

        $add_to_respond('est_connecte', true)

        return $indicate(200, "Connexion réussie", { jeton_acces })
    }

    $deconnecter_compte = async ($request) =>
    {
        await $exiger_compte({ effacement_demande: true })

        const cookie_session = $request.cookies?.jeton ?? null

        if (cookie_session)
        {
            const separateur = cookie_session.indexOf('.')

            if (separateur > 0 && separateur < cookie_session.length - 1)
            {
                const id_session = cookie_session.slice(0, separateur)

                await $update_one('session',
                    `
                    #id              = $id_session
                    `,
                    {
                        date_revocation : 'now'
                    },
                    { $id_session: id_session }
                )
            }
        }

        $set_cookie('jeton', '', { lifetime: 0 })

        $add_to_respond('est_connecte', false)

        return $indicate(200, "Déconnexion réussie")
    }
]
