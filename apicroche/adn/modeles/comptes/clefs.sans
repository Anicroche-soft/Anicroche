@name [ clefs, clef ]

@primary [ id ]

@unique [
    [ hachage_coordonnee, type, date_emission ]
]

@fields [
    {
        name    : id
        type    : char
        size    : 21
        chars   : [A-Z0-9]
        default : auto

        post_create : $retourner_id($values)
    }

    {
        alt  : coordonnee
        name : hachage_coordonnee
        type : hash

        # Une clef d authentification ou d ajout d adresse est envoyée à l adresse fournie ; les
        # autres ne le sont qu à l adresse principale du compte connecté. $preparer_clef vérifie
        # les prérequis de chaque type (voir TYPES_PRINCIPALE)
        can_create  : "
            (
                $type -{ [authentification, ajout-courriel]
              & $hachage_coordonnee ~= /^[^@\s]+@[^@\s]+\.[^@\s]+$/
            )
          | $type -{ [effacement, suppression-courriel, modification-courriel-principal, modification-mot-de-passe]
        "
        prior_create : $preparer_clef($values)
    }

    # Une clef ne sert qu à l usage de son type
    {
        name : type
        type : authentification/effacement/ajout-courriel/suppression-courriel/modification-courriel-principal/modification-mot-de-passe
        size : 1-48

        can_create : "$type -{ [authentification, effacement, ajout-courriel, suppression-courriel, modification-courriel-principal, modification-mot-de-passe]"
    }

    {
        name    : clef
        type    : hash
        size    : 1-256
        chars   : [0-9]
        length  : 9
        default : auto

        prior_create : $envoyer_clef($values)
    }

    {
        name    : nombre_tentatives
        type    : tinyint
        default : 6
    }

    {
        name    : date_emission
        type    : datetime
        default : now
    }

    {
        name    : date_validite
        type    : datetime
        default : now+15m
    }
]

@routes [
    {
        path   : /authentification
        action : $authentifier_clef($body)
    }
]

@script [
    // Types de clef envoyés à l adresse principale du compte connecté, et s ils exigent aussi son
    // mot de passe. Le changement de mot de passe ne l exige pas : il sert aussi en cas d oubli,
    // et une clef reçue sur une adresse du compte permet déjà de s y connecter
    const TYPES_PRINCIPALE = {
        'effacement'                      : true,
        'suppression-courriel'            : true,
        'modification-courriel-principal' : true,
        'modification-mot-de-passe'       : false
    }

    // Sujet et usage annoncés dans le courriel de chaque type
    const COURRIELS = {
        'effacement'                      : [ "Votre code de désinscription", "Il permet de demander la suppression de votre compte Anicroche." ],
        'ajout-courriel'                  : [ "Votre code d'ajout d'adresse", "Il permet d'ajouter cette adresse à votre compte Anicroche." ],
        'suppression-courriel'            : [ "Votre code de retrait d'adresse", "Il permet de retirer une adresse de votre compte Anicroche." ],
        'modification-courriel-principal' : [ "Votre code de changement d'adresse principale", "Il permet de changer l'adresse principale de votre compte Anicroche." ],
        'modification-mot-de-passe'       : [ "Votre code de changement de mot de passe", "Il permet de changer le mot de passe de votre compte Anicroche." ]
    }

    $preparer_clef = async ($values) =>
    {
        if ($values.type === 'ajout-courriel')
        {
            await $exiger_compte()

            // Le mot de passe d abord : une session seule ne permet pas de savoir si une adresse est inscrite
            if (!await $verifier_mot_de_passe())
                return $indicate(403, "Mot de passe invalide")

            if (await $search_one('coordonnee', `#hachage_coordonnee = $values.hachage_coordonnee`, { $values }))
                return $indicate(409, "Adresse déjà utilisée")
        }
        else if ($values.type in TYPES_PRINCIPALE)
        {
            await $exiger_compte()

            if ($values.type === 'effacement')
                await $exiger_effacement_possible()

            const principale = await $search_one('coordonnee',
                `
                #hachage_coordonnee = $values.hachage_coordonnee
              & #id_compte          = $id_compte
              & #est_principale
                `,
                { $values, $id_compte: $context.compte.id }
            )

            if (!principale)
                return $indicate(403, "Accès refusé")

            if (TYPES_PRINCIPALE[$values.type] && !await $verifier_mot_de_passe())
                return $indicate(403, "Mot de passe invalide")
        }

        const clef_recente = await $search_one('clef',
            `
            #hachage_coordonnee = $values.hachage_coordonnee
          & #type               = $values.type
          & #date_emission      > now-30s
            `,
            { $values }
        )

        if (clef_recente)
            return $indicate(429, "Clef trop récente déjà existante")

        await $delete_all('clefs',
            `
            #hachage_coordonnee = $values.hachage_coordonnee
          & #type = $values.type
            `,
            { $values },
            {
                order  : 'date_emission',
                dir    : 'desc',
                offset : 1
            }
        )
    }

    $envoyer_clef = async ($values) =>
    {
        // Empêche la détection d’un numéro de téléphone par les messageries.
        const clef_affichee = String($values.clef).replace(/(\d{3})(?=\d)/g, '$1&#8203;-&#8203;')

        const coordonnee_existante = await $search_one('coordonnee',
            `
            #hachage_coordonnee = $values.hachage_coordonnee
            `,
            { $values }
        )

        if ($values.type in COURRIELS)
        {
            const [ sujet, usage ] = COURRIELS[$values.type]

            await $send_email({
                to      : $values.hachage_coordonnee,
                subject : sujet,
                content : `<p>Votre code : <strong>${clef_affichee}</strong></p>`
                        + `<p>${usage} Si vous n'êtes pas à l'origine de cette demande, ne le communiquez à personne`
                        + ($values.type === 'ajout-courriel' ? `.</p>` : ` et changez votre mot de passe.</p>`)
            })
            return
        }

        await $send_email({
            to      : $values.hachage_coordonnee,
            subject : coordonnee_existante ? "Votre code de connexion" : "Votre code d'inscription",
            content : `<p>Votre code : <strong>${clef_affichee}</strong></p>`
        })
    }

    $retourner_id = ($values) =>
    {
        $add_to_data('id', $values.id)
    }

    $authentifier_clef = async ($body) =>
    {
        if (
            !$body.coordonnee
         || !$body.clef
         || !Array.isArray($body.ids)
         || !$body.ids.length
        )
            return $indicate(400, "Corps incomplet")

        const clef = await $verifier_clef()

        const coordonnee_existante = await $search_one('coordonnee',
            `
            #hachage_coordonnee = $body.coordonnee
            `
        )

        if (!clef)
            return $indicate(403, 'Accès refusé')

        return $indicate(200, "Authentification réussie", {
            type : coordonnee_existante ? 'connexion' : 'inscription'
        })
    }
]
