@name [ anicroches, anicroche ]

@primary [ id ]

@fields [
    {
        name         : id
        type         : char
        size         : 1-48
        rule         : "$type != page | $id ~= /^(?=[a-z0-9-]*[a-z])[a-z0-9]+(?:-[a-z0-9]+)*$/"
        can_create   : ':)'
        can_search   : ':)'
        prior_create : $verifier_creation_anicroche($values)
        post_create  : $ouvrir_premier_brouillon($values)
    }

    {
        name       : type
        type       : page/
        can_create : ':)'
        can_search : ':)'
    }

    {
        name  : versions
        count : 0-N
    }

    {
        name  : textes
        count : 0-N
    }
]

# Chaque anicroche trouvée est complétée par sa version en vigueur et ses sources. Seules
# celles qui ont une version publiée sont visibles, sauf pour les profils maîtres,
# qui voient aussi le brouillon en cours
@rules [
    post_search : $completer_anicroches($results)
]

@script [
    // Seules les pages existent pour l instant : elles sont réservées aux profils maîtres
    $verifier_creation_anicroche = async ($values) =>
    {
        await $exiger_maitre()

        const existante = await $search_one('anicroche', `#id = $id`, { $id: $values.id })
        if (existante)
            return $indicate(409, "Identifiant déjà utilisé")
    }

    $ouvrir_premier_brouillon = async ($values) =>
    {
        await $creer_premier_brouillon($values.id)
        $add_to_data('brouillon', 1)
    }

    // Une source par rôle pour une version donnée :
    // - une source non remplacée par une version plus récente reste valable
    // - préférence de langue : langue et région préférées, puis langue seule, puis sans langue
    const resoudre_sources = (textes, numero) =>
    {
        const { langue, region } = $langue_preferee()
        const preferences = [ [ langue, region ], [ langue, '' ], [ '', '' ] ]
        const rang = (texte) =>
        {
            const index = preferences.findIndex(([l, r]) => l === texte.langue && r === texte.region)
            return index < 0 ? preferences.length : index
        }

        const sources = {}
        for (const texte of textes)
        {
            if (texte.version > numero)
                continue

            const actuelle = sources[texte.role]
            const meilleure = !actuelle
                || rang(texte) < rang(actuelle)
                || (rang(texte) === rang(actuelle) && texte.version > actuelle.version)

            if (meilleure)
                sources[texte.role] = texte
        }

        return Object.fromEntries(Object.entries(sources).map(([role, texte]) => [role, {
            langue  : texte.langue,
            region  : texte.region,
            version : texte.version,
            contenu : texte.contenu
        }]))
    }

    $completer_anicroches = async ($results) =>
    {
        const maitre = await $est_maitre()

        for (let i = $results.length - 1; i >= 0; i--)
        {
            const anicroche = $results[i]
            const version   = await $version_en_vigueur(anicroche.id)

            if (!version && !maitre)
            {
                $results.splice(i, 1)
                continue
            }

            const textes = await $search_all('textes', `#id_anicroche = $id`, { $id: anicroche.id })

            anicroche.version          = version?.numero ?? null
            anicroche.date_publication = version?.date_publication ?? null
            anicroche.sources          = version ? resoudre_sources(textes, version.numero) : {}

            if (!maitre)
                continue

            const derniere = await $search_one('version',
                `#id_anicroche = $id`,
                { $id: anicroche.id },
                { order: 'numero', dir: 'desc' }
            )

            // Le brouillon montre les sources telles qu elles seront une fois publiées
            anicroche.brouillon = derniere && !derniere.date_publication
                ? { numero: derniere.numero, sources: resoudre_sources(textes, derniere.numero) }
                : null
        }
    }
]
