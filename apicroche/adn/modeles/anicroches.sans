@name [ anicroches, anicroche ]

@primary [ id ]

@fields [
    {
        name         : id
        type         : char
        size         : 1-48
        rule         : "$type != page | $id ~= /^(?=[a-z0-9-]*[a-z])[a-z0-9]+(?:-[a-z0-9]+)*$/"
        can_create   : ':)'
        can_search   : ':)'
        prior_create : $verifier_creation_anicroche($values)
    }

    {
        name       : type
        type       : page/
        can_create : ':)'
        can_search : ':)'
    }

    {
        name  : versions
        count : 0-N
    }

    {
        name  : textes
        count : 0-N
    }
]

# Seules les anicroches qui ont une version publiée sont visibles ; chacune est complétée
# par sa version en vigueur et ses sources
@rules [
    restrict_search : "#versions.date_publication <= now"
    post_search     : $completer_anicroches($results)
]

@script [
    // Seules les pages existent pour l instant : elles sont réservées aux gérants de @anicroche
    $verifier_creation_anicroche = async ($values) =>
    {
        await $exiger_gerant_anicroche()

        const existante = await $search_one('anicroche', `#id = $id`, { $id: $values.id })
        if (existante)
            return $indicate(409, "Identifiant déjà utilisé")
    }

    // Complète chaque anicroche trouvée par la route automatique de recherche avec sa version
    // en vigueur et une source par rôle :
    // - une source non remplacée par une version plus récente reste valable
    // - préférence de langue : langue et région préférées, puis langue seule, puis sans langue
    $completer_anicroches = async ($results) =>
    {
        const { langue, region } = $langue_preferee()
        const preferences = [ [ langue, region ], [ langue, '' ], [ '', '' ] ]
        const rang = (texte) =>
        {
            const index = preferences.findIndex(([l, r]) => l === texte.langue && r === texte.region)
            return index < 0 ? preferences.length : index
        }

        for (const anicroche of $results)
        {
            const version = await $version_en_vigueur(anicroche.id)
            const textes  = version
                ? await $search_all('textes',
                    `
                    #id_anicroche = $id
                  & #version     <= $numero
                    `,
                    { $id: anicroche.id, $numero: version.numero }
                )
                : []

            const sources = {}
            for (const texte of textes)
            {
                const actuelle = sources[texte.role]
                const meilleure = !actuelle
                    || rang(texte) < rang(actuelle)
                    || (rang(texte) === rang(actuelle) && texte.version > actuelle.version)

                if (meilleure)
                    sources[texte.role] = texte
            }

            anicroche.version          = version?.numero ?? null
            anicroche.date_publication = version?.date_publication ?? null
            anicroche.sources          = Object.fromEntries(Object.entries(sources).map(([role, texte]) => [role, {
                langue  : texte.langue,
                region  : texte.region,
                contenu : texte.contenu
            }]))
        }
    }
]
