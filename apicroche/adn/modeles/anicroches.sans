@name [ anicroches, anicroche ]

@primary [ id ]

@fields [
    # Libre ou attribué automatiquement, selon le type (voir types.sans)
    {
        name         : id
        type         : char
        size         : 1-48
        can_create   : ':)'
        can_search   : ':)'
        prior_create : $verifier_creation_anicroche($values)
        post_create  : $ouvrir_premier_brouillon($values)
    }

    # Une clef de types_anicroches (app.adn)
    {
        name       : type
        type       : char
        size       : 1-32
        can_create : ':)'
        can_search : ':)'
    }

    {
        name  : versions
        count : 0-N
    }

    {
        name  : textes
        count : 0-N
    }

    # Pour un type avec auteurs, une anicroche sans auteurs est supprimée : ses textes ont été
    # vidés (voir effacement.sans)
    {
        name  : auteurs
        entry : auteur
        ref   : profils
        count : N-N
    }
]

# Chaque anicroche trouvée est complétée par sa version en vigueur et ses sources. Seules
# celles qui ont une version publiée sont visibles, sauf pour les profils qui administrent
# leur type, qui voient aussi le brouillon en cours. Une anicroche supprimée n est jamais visible
@rules [
    post_search : $completer_anicroches($results)
]

@script [
    $verifier_creation_anicroche = async ($values) =>
    {
        if (!$type_anicroche($values.type))
            return $indicate(422, "Type d'anicroche inconnu")

        await $exiger_administration($values.type)
        await $preparer_identifiant($values)
    }

    $ouvrir_premier_brouillon = async ($values) =>
    {
        await $initialiser_anicroche({ id: $values.id, type: $values.type })
        $add_to_data('id', $values.id)
        $add_to_data('brouillon', 1)
    }

    // Une source par rôle et par position pour une version donnée :
    // - une source non remplacée par une version plus récente reste valable
    // - préférence de langue : langue et région préférées, puis langue seule, puis sans langue
    // Un rôle à plusieurs sources (nombre maximum au-dessus de 1) donne une liste rangée par
    // position, les autres une source seule
    const resoudre_sources = (type, textes, numero) =>
    {
        const { langue, region } = $langue_preferee()
        const preferences = [ [ langue, region ], [ langue, '' ], [ '', '' ] ]
        const rang = (texte) =>
        {
            const index = preferences.findIndex(([l, r]) => l === texte.langue && r === texte.region)
            return index < 0 ? preferences.length : index
        }

        const retenues = new Map()
        for (const texte of textes)
        {
            if (texte.version > numero)
                continue

            const clef      = `${texte.role}|${texte.position}`
            const actuelle  = retenues.get(clef)
            const meilleure = !actuelle
                || rang(texte) < rang(actuelle)
                || (rang(texte) === rang(actuelle) && texte.version > actuelle.version)

            if (meilleure)
                retenues.set(clef, texte)
        }

        const multiples = new Set($sources_type(type).filter(source => source.max > 1).map(source => source.role))
        const sources   = {}

        for (const texte of [ ...retenues.values() ].sort((a, b) => a.position - b.position))
        {
            const source = {
                position : texte.position,
                langue   : texte.langue,
                region   : texte.region,
                version  : texte.version,
                contenu  : texte.contenu
            }

            if (multiples.has(texte.role))
                (sources[texte.role] ??= []).push(source)
            else
                sources[texte.role] ??= source
        }

        return sources
    }

    $completer_anicroches = async ($results) =>
    {
        for (let i = $results.length - 1; i >= 0; i--)
        {
            const anicroche  = $results[i]
            const version    = await $version_en_vigueur(anicroche.id)
            const administre = $administre_type(anicroche.type)

            if ((!version && !administre) || await $est_anicroche_supprimee(anicroche))
            {
                $results.splice(i, 1)
                continue
            }

            const textes = await $search_all('textes', `#id_anicroche = $id`, { $id: anicroche.id })

            anicroche.version          = version?.numero ?? null
            anicroche.date_publication = version?.date_publication ?? null
            anicroche.sources          = version ? resoudre_sources(anicroche.type, textes, version.numero) : {}

            if (!administre)
                continue

            const derniere = await $search_one('version',
                `#id_anicroche = $id`,
                { $id: anicroche.id },
                { order: 'numero', dir: 'desc' }
            )

            // Le brouillon montre les sources telles qu elles seront une fois publiées
            anicroche.brouillon = derniere && !derniere.date_publication
                ? { numero: derniere.numero, sources: resoudre_sources(anicroche.type, textes, derniere.numero) }
                : null
        }
    }
]
