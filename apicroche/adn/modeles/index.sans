@actions [
    {
        prior_run : $creer_pages_obligatoires()
    }

    {
        periodically : $nettoyer_sessions()
        period : 1d
    }

    {
        periodically : $nettoyer_clefs()
        period : 1d
    }

    {
        prior_respond : $normaliser_coordonnee()
    }

    {
        prior_respond : $rafraichir_jeton()
    }

    {
        post_respond : $detecter_connexion()
    }
]

@limits [
    {
        limit : 300/1m
    }

    {
        path  : [ /connexion, /inscription, /authentification ]
        limit : 10/1m
    }

    {
        path  : [ /desinscription, /restauration ]
        limit : 10/1m
    }

    {
        path  : /export
        limit : 5/10m
    }

    {
        path   : /clef
        method : post
        limit  : 3/10m
    }
]

@routes [
    {
        path    : /test/search/all
        action  : $tester_search_all($body)
        mode    : dev
    }
]

@script [
    $tester_search_all = async ($body) =>
    {
        if (typeof $body !== 'object' || !$body)
            return $indicate(400, 'Corps invalide')

        const name = typeof $body.name === 'string' ? $body.name.trim() : ''
        const projection  = $body.projection
        const restriction = ($body.restriction === undefined || $body.restriction === null)
            ? true
            : (typeof $body.restriction === 'string' ? $body.restriction.trim() : '')

        if (!name)
            return $indicate(400, 'Paramètre requis manquant : name')

        if (!restriction)
            return $indicate(400, 'Le paramètre restriction doit être une chaîne non vide quand il est fourni')

        if (projection !== undefined && projection !== null)
        {
            if (typeof projection !== 'string')
                return $indicate(400, 'Le paramètre projection doit être une chaîne (valeurs séparées par des ; )')
        }

        let resultats
        try
        {
            resultats = (projection === undefined || projection === null)
                ? await $search_all(name, restriction)
                : await $search_all(name, restriction, {}, { select: projection })
        }
        catch (err)
        {
            const message = typeof err?.message === 'string' && err.message
                ? err.message
                : 'Erreur search_all'
            return $indicate(422, message)
        }

        return $indicate(200, 'Recherche effectuée', {
            total    : resultats.length,
            resultats: resultats
        })
    }

    $nettoyer_sessions = async () =>
    {
        console.log('=================\nNETTOYER SESSIONS\n=================')
        await $delete_all('sessions',
            `
            #date_revocation != null
          | #date_validite   < now
            `
        )
    }

    $nettoyer_clefs = async () =>
    {
        console.log('==============\nNETTOYER CLEFS\n==============')
        await $delete_all('clefs',
            `
            #date_validite < now
            `
        )
    }

    $normaliser_coordonnee = () =>
    {
        if (typeof $body?.coordonnee === 'string')
            $body.coordonnee = $body.coordonnee.trim().toLowerCase()
    }

    // Une clef ne sert qu à l usage de son type : une clef de connexion ne confirme pas un effacement
    $verifier_clef = async (type = 'authentification') =>
    {
        // Décrémenter avant de vérifier : des essais simultanés ne peuvent pas dépasser le quota
        await $update_all('clefs',
            `
            #id                 -{ $body.ids
          & #hachage_coordonnee  = $body.coordonnee
          & #type                = $type
          & #nombre_tentatives  >= 0
            `,
            {
                nombre_tentatives : 'nombre_tentatives - 1'
            },
            { $type: type }
        )

        return await $search_one('clef',
            `
            #id                 -{ $body.ids
          & #hachage_coordonnee  = $body.coordonnee
          & #type                = $type
          & #clef                = $body.clef
          & #nombre_tentatives  >= 0
          & #date_validite       > now
            `,
            { $type: type }
        )
    }

    // Session valide et son compte (le jeton de la session, haché, ne peut être vérifié qu à sa lecture)
    const lire_session = async (condition, valeurs) =>
    {
        const session = await $search_one('session',
            `
            ${condition}
          & #date_validite   > now
          & #date_revocation = null
            `,
            valeurs,
            { select: 'id ; date_emission ; date_validite ; nom_appareil ; is_session_of_compte' }
        )

        const compte = session?.is_session_of_compte
        if (!compte)
            return null

        delete session.is_session_of_compte
        return { session, compte }
    }

    const authentifier = async ({ session, compte }) =>
    {
        $context.compte  = compte
        $context.session = session
        await $noter_activite()
        await $resoudre_profil()
    }

    $rafraichir_jeton = async () =>
    {
        const en_tete = $request.headers?.authorization ?? null
        const jeton_acces = en_tete?.startsWith('Bearer ')
            ? en_tete.slice(7).trim()
            : null

        if (jeton_acces)
        {
            const payload = await $verify_token(jeton_acces)

            // Les liens des courriels sont aussi des jetons signés : seul un jeton d accès authentifie,
            // et seulement tant que sa session n est ni expirée ni révoquée
            if (payload?.type === 'acces' && payload.id_session)
            {
                // Une seule requête : le compte, joint à sa session
                const compte = await $search_one('compte',
                    `
                    #sessions.id              = $id_session
                  & #sessions.date_validite   > now
                  & #sessions.date_revocation = null
                    `,
                    { $id_session: payload.id_session }
                )

                if (compte)
                    return await authentifier({ session: { id: payload.id_session }, compte })
            }
        }

        const cookie_session = $request.cookies?.jeton ?? null

        if (!cookie_session)
            return

        const separateur = cookie_session.indexOf('.')
        if (separateur <= 0 || separateur >= cookie_session.length - 1)
            return

        const lecture = await lire_session(
            `
            #id            = $id_session
          & #hachage_jeton = $jeton_session
            `,
            {
                $id_session    : cookie_session.slice(0, separateur),
                $jeton_session : cookie_session.slice(separateur + 1)
            }
        )

        if (!lecture)
            return

        const session        = lecture.session
        const maintenant     = new Date()
        const duree_totale   = new Date(session.date_validite) - new Date(session.date_emission)
        const duree_restante = new Date(session.date_validite) - maintenant

        if (duree_restante < duree_totale / 2)
        {
            await $update_one('session',
                `#id = $session.id`,
                { date_revocation: 'now' },
                { $session: session }
            )

            const nouvelle_session = await $create_one('session', {
                id_compte         : lecture.compte.id,
                adresse_ip        : $request.ip,
                agent_utilisateur : $request.user_agent,
                nom_appareil      : session.nom_appareil
            })

            const cookie_rotation = `${nouvelle_session.id}.${nouvelle_session.jeton}`
            $set_cookie('jeton', cookie_rotation, { lifetime: '30d' })

            const nouveau_jeton_acces = await $sign_token({ type: 'acces', id_compte: lecture.compte.id, id_session: nouvelle_session.id })
            $add_to_data('jeton_acces', nouveau_jeton_acces)

            lecture.session = {
                id            : nouvelle_session.id,
                date_emission : nouvelle_session.date_emission,
                date_validite : nouvelle_session.date_validite,
                nom_appareil  : session.nom_appareil
            }
        }

        await authentifier(lecture)
    }

    // Date de dernière activité, pour la suppression des comptes inactifs (voir effacement.sans) :
    // écrite au plus une fois par jour
    $noter_activite = async () =>
    {
        const compte = $context.compte
        if (!compte || new Date(compte.date_derniere_activite) > new Date(Date.now() - 24 * 60 * 60 * 1000))
            return

        await $update_one('compte',
            `#id = $id`,
            {
                date_derniere_activite     : 'now',
                nombre_avertissements      : 0,
                date_premier_avertissement : null
            },
            { $id: compte.id }
        )
    }

    // Le profil sélectionné sur le site arrive dans l en-tête X-Profil : seul celui-ci compte
    // pour les droits, et seulement si le compte en est gérant
    $resoudre_profil = async () =>
    {
        const id_profil = String($request.headers?.['x-profil'] ?? '').trim()

        if (!$context.compte || !id_profil)
            return

        const profil = await $search_one('profil',
            `
            #id         = $id_profil
          & #gerants.id = $id_compte
            `,
            { $id_profil: id_profil, $id_compte: $context.compte.id }
        )

        if (profil)
            $context.profil = profil
    }

    $detecter_connexion = async () =>
    {
        $add_to_respond('est_connecte', !!$context.compte)
    }

    // Un compte dont l effacement est demandé est gelé : seules les routes qui le permettent
    // explicitement (consultation, déconnexion, annulation) lui restent ouvertes
    $exiger_compte = (options = {}) =>
    {
        if (!$context.compte)
            return $indicate(401, 'Non authentifié')

        if ($context.compte.date_demande_effacement && !options.effacement_demande)
            return $indicate(403, "Effacement du compte en cours")
    }

    // ─── Courriels du compte ────────────────────────────────────────────────

    $lire_courriels = async (id_compte) =>
        (await $search_all('coordonnees',
            `
            #id_compte = $id_compte
          & #type      = courriel
            `,
            { $id_compte: id_compte }
        )).map(coordonnee => coordonnee.coordonnee)

    // Toutes les adresses du compte sont prévenues : un voleur qui aurait changé l adresse
    // principale n empêche pas l ancienne d être avertie
    $ecrire_courriels = async (adresses, sujet, contenu) =>
    {
        for (const adresse of adresses)
        {
            try
            {
                await $send_email({ to: adresse, subject: sujet, content: contenu })
            }
            catch (erreur)
            {
                console.log(`/!\\ courriel au compte non envoyé : ${erreur.message}`)
            }
        }
    }

    // Vérifie une clef du type donné, envoyée à l adresse principale du compte connecté (corps :
    // { clef, ids }), et renvoie cette adresse. $verifier_clef lit l adresse dans le corps : c est
    // celle du compte qui compte
    $verifier_clef_principale = async (type) =>
    {
        if (
            !$body.clef
         || !Array.isArray($body.ids)
         || !$body.ids.length
        )
            return $indicate(400, "Corps incomplet")

        const principale = await $search_one('coordonnee',
            `
            #id_compte = $id_compte
          & #est_principale
            `,
            { $id_compte: $context.compte.id }
        )

        if (!principale)
            return $indicate(403, "Accès refusé")

        $body.coordonnee = principale.coordonnee

        if (!await $verifier_clef(type))
            return $indicate(403, "Accès refusé")

        return principale
    }

    // Supprime les clefs d un type pour une adresse, une fois l une d elles utilisée
    $consommer_clefs = (coordonnee, type) =>
        $delete_all('clefs',
            `
            #hachage_coordonnee = $coordonnee
          & #type               = $type
            `,
            { $coordonnee: coordonnee, $type: type }
        )

    // ─── Appareils ───────────────────────────────────────────────────────────

    // Navigateurs et systèmes reconnus, dans l ordre de test : un agent utilisateur en cite
    // souvent plusieurs (Edge se dit aussi Chrome et Safari)
    const NAVIGATEURS = [
        [ /SamsungBrowser/,             'Samsung Internet' ],
        [ /\bEdg(e|A|iOS)?\b/,          'Edge'             ],
        [ /\bOPR\b|Opera/,              'Opera'            ],
        [ /Firefox|FxiOS/,              'Firefox'          ],
        [ /Chrome|Chromium|CriOS/,      'Chrome'           ],
        [ /Safari/,                     'Safari'           ]
    ]

    const SYSTEMES = [
        [ /Android/,                    'Android'          ],
        [ /iPhone|iPod/,                'iPhone'           ],
        [ /iPad/,                       'iPad'             ],
        [ /CrOS/,                       'ChromeOS'         ],
        [ /Windows/,                    'Windows'          ],
        [ /Mac OS X|Macintosh/,         'macOS'            ],
        [ /Linux/,                      'Linux'            ]
    ]

    const reconnaitre = (liste, agent) => liste.find(([ motif ]) => motif.test(agent))?.[1] ?? null

    // Nom lisible de l appareil (« Firefox sur Linux »), ou null s il n est pas reconnu
    $nommer_appareil = (agent_utilisateur) =>
    {
        const agent      = String(agent_utilisateur ?? '')
        const navigateur = reconnaitre(NAVIGATEURS, agent)
        const systeme    = reconnaitre(SYSTEMES, agent)

        if (navigateur && systeme)
            return `${navigateur} sur ${systeme}`
        return navigateur ?? systeme
    }

    // ─── Âge ─────────────────────────────────────────────────────────────────

    // Âge minimum pour s'inscrire seul (RGPD art. 8, loi Informatique et Libertés art. 45)
    $age_minimum = () => 15

    $age_majorite = () => 18

    // Âge en années révolues d'une date de naissance AAAA-MM-JJ, ou null si la date est
    // invalide, antérieure à 1900 ou future
    $calculer_age = (date_naissance, date_reference) =>
    {
        const maintenant = date_reference ?? new Date()
        const morceaux = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(date_naissance ?? ''))
        if (!morceaux)
            return null

        const [annee, mois, jour] = morceaux.slice(1).map(Number)
        const date = new Date(Date.UTC(annee, mois - 1, jour))

        const existe = date.getUTCFullYear() === annee
                    && date.getUTCMonth()    === mois - 1
                    && date.getUTCDate()     === jour
        if (!existe || annee < 1900 || date > maintenant)
            return null

        const anniversaire_passe = maintenant.getUTCMonth() > mois - 1
                                || (maintenant.getUTCMonth() === mois - 1 && maintenant.getUTCDate() >= jour)

        return maintenant.getUTCFullYear() - annee - (anniversaire_passe ? 0 : 1)
    }

    // ─── Pages ───────────────────────────────────────────────────────────────

    $langue_preferee = () => ({ langue: 'fr', region: 'FR' })

    // Toute anicroche naît avec le brouillon de sa première version et ses sources obligatoires
    $initialiser_anicroche = async (anicroche) =>
    {
        const version = await $search_one('version', `#id_anicroche = $id`, { $id: anicroche.id })
        if (!version)
            await $create_one('version', { id_anicroche: anicroche.id, numero: 1 })

        await $creer_sources_obligatoires(anicroche)
    }

    // Les anicroches légales (clef legalite des types d app.adn) existent toujours
    $creer_pages_obligatoires = async () =>
    {
        for (const [type, config] of Object.entries($app.types_anicroches ?? {}))
        {
            if (config?.identifiant !== 'libre' || !Array.isArray(config?.legalite))
                continue

            for (const id of config.legalite)
            {
                const existante = await $search_one('anicroche', `#id = $id`, { $id: id })
                if (!existante)
                {
                    await $create_one('anicroche', { id, type })
                    console.log(`  ${type.toUpperCase().padEnd(6)} ${id} créée`)
                }
                else if (existante.type !== type)
                {
                    console.log(`/!\\ app.adn : ${id} est déclarée légale pour le type ${type}, mais elle est de type ${existante.type}`)
                    continue
                }

                // Aussi pour une anicroche créée avant cette règle
                await $initialiser_anicroche({ id, type })
            }
        }
    }

    // Une version est parue quand sa date de parution est passée
    $est_parue = (version) =>
        !!version?.date_parution && new Date(version.date_parution) <= new Date()

    // Version parue la plus récente, quel que soit son accès
    $version_en_vigueur = async (id_anicroche) =>
        await $search_one('version',
            `
            #id_anicroche  = $id_anicroche
          & #date_parution <= now
            `,
            { $id_anicroche: id_anicroche },
            { order: 'numero', dir: 'desc' }
        )
]
