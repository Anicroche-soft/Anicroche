@actions [
    {
        prior_run : $creer_pages_obligatoires()
    }

    {
        periodically : $nettoyer_sessions()
        period : 1d
    }

    {
        periodically : $nettoyer_clefs()
        period : 1d
    }

    {
        prior_respond : $normaliser_coordonnee()
    }

    {
        prior_respond : $rafraichir_jeton()
    }

    {
        post_respond : $detecter_connexion()
    }
]

@limits [
    {
        limit : 300/1m
    }

    {
        path  : [ /connexion, /inscription, /authentification ]
        limit : 10/1m
    }

    {
        path   : /clef
        method : post
        limit  : 3/10m
    }
]

@routes [
    {
        path    : /test/search/all
        action  : $tester_search_all($body)
        mode    : dev
    }
]

@script [
    $tester_search_all = async ($body) =>
    {
        if (typeof $body !== 'object' || !$body)
            return $indicate(400, 'Corps invalide')

        const name = typeof $body.name === 'string' ? $body.name.trim() : ''
        const projection  = $body.projection
        const restriction = ($body.restriction === undefined || $body.restriction === null)
            ? true
            : (typeof $body.restriction === 'string' ? $body.restriction.trim() : '')

        if (!name)
            return $indicate(400, 'Paramètre requis manquant : name')

        if (!restriction)
            return $indicate(400, 'Le paramètre restriction doit être une chaîne non vide quand il est fourni')

        if (projection !== undefined && projection !== null)
        {
            if (typeof projection !== 'string')
                return $indicate(400, 'Le paramètre projection doit être une chaîne (valeurs séparées par des ; )')
        }

        let resultats
        try
        {
            resultats = (projection === undefined || projection === null)
                ? await $search_all(name, restriction)
                : await $search_all(name, restriction, {}, { select: projection })
        }
        catch (err)
        {
            const message = typeof err?.message === 'string' && err.message
                ? err.message
                : 'Erreur search_all'
            return $indicate(422, message)
        }

        return $indicate(200, 'Recherche effectuée', {
            total    : resultats.length,
            resultats: resultats
        })
    }

    $nettoyer_sessions = async () =>
    {
        console.log('=================\nNETTOYER SESSIONS\n=================')
        await $delete_all('sessions',
            `
            #date_revocation != null
          | #date_validite   < now
            `
        )
    }

    $nettoyer_clefs = async () =>
    {
        console.log('==============\nNETTOYER CLEFS\n==============')
        await $delete_all('clefs',
            `
            #date_validite < now
            `
        )
    }

    $normaliser_coordonnee = () =>
    {
        if (typeof $body?.coordonnee === 'string')
            $body.coordonnee = $body.coordonnee.trim().toLowerCase()
    }

    $verifier_clef = async () =>
    {
        // Décrémenter avant de vérifier : des essais simultanés ne peuvent pas dépasser le quota
        await $update_all('clefs',
            `
            #id                 -{ $body.ids
          & #hachage_coordonnee  = $body.coordonnee
          & #type                = authentification
          & #nombre_tentatives  >= 0
            `,
            {
                nombre_tentatives : 'nombre_tentatives - 1'
            }
        )

        return await $search_one('clef',
            `
            #id                 -{ $body.ids
          & #hachage_coordonnee  = $body.coordonnee
          & #type                = authentification
          & #clef                = $body.clef
          & #nombre_tentatives  >= 0
          & #date_validite       > now
            `
        )
    }

    $rafraichir_jeton = async () =>
    {
        const en_tete = $request.headers?.authorization ?? null
        const jeton_acces = en_tete?.startsWith('Bearer ')
            ? en_tete.slice(7).trim()
            : null

        if (jeton_acces)
        {
            const payload = await $verify_token(jeton_acces)

            if (payload?.id_compte)
            {
                const compte = await $search_one('compte',
                    `#id = $payload.id_compte`,
                    { $payload: payload }
                )

                if (compte)
                {
                    $context.compte = compte
                    return
                }
            }
        }

        const cookie_session = $request.cookies?.jeton ?? null

        if (!cookie_session)
            return

        const separateur = cookie_session.indexOf('.')
        if (separateur <= 0 || separateur >= cookie_session.length - 1)
            return

        const id_session = cookie_session.slice(0, separateur)
        const jeton_session = cookie_session.slice(separateur + 1)

        const session = await $search_one('session',
            `
            #id              = $id_session
          & #hachage_jeton   = $jeton_session
          & #date_validite   > now
          & #date_revocation = null
            `,
            {
                $id_session: id_session,
                $jeton_session: jeton_session
            }
        )

        if (!session)
            return

        const maintenant = new Date()
        const emission = new Date(session.date_emission)
        const validite = new Date(session.date_validite)
        const duree_totale = validite - emission
        const duree_restante = validite - maintenant

        if (duree_restante < duree_totale / 2)
        {
            await $update_one('session',
                `#id = $session.id`,
                { date_revocation: 'now' },
                { $session: session }
            )

            const nouvelle_session = await $create_one('session', {
                id_compte         : session.id_compte,
                adresse_ip        : $request.ip,
                agent_utilisateur : $request.user_agent
            })

            const cookie_rotation = `${nouvelle_session.id}.${nouvelle_session.jeton}`
            $set_cookie('jeton', cookie_rotation, { lifetime: '30d' })

            const nouveau_jeton_acces = await $sign_token({ id_compte: session.id_compte })
            $add_to_data('jeton_acces', nouveau_jeton_acces)
        }

        const compte = await $search_one('compte',
            `#id = $session.id_compte`,
            { $session: session }
        )

        $context.compte = compte
    }

    $detecter_connexion = async () =>
    {
        $add_to_respond('est_connecte', !!$context.compte)
    }

    $exiger_compte = () =>
    {
        if (!$context.compte)
            return $indicate(401, 'Non authentifié')
    }

    // Provisoire (dev) : seuls les gérants du profil @anicroche modifient les pages,
    // en attendant les rôles d'utilisateurs
    $est_gerant_anicroche = async () =>
    {
        if (!$context.compte)
            return false

        const profil = await $search_one('profil',
            `
            #identifiant = anicroche
          & #gerants.id  = $id_compte
            `,
            { $id_compte: $context.compte.id }
        )

        return !!profil
    }

    $exiger_gerant_anicroche = async () =>
    {
        await $exiger_compte()

        if (!(await $est_gerant_anicroche()))
            return $indicate(403, 'Accès refusé')
    }

    // ─── Âge ─────────────────────────────────────────────────────────────────

    // Âge minimum pour s'inscrire seul (RGPD art. 8, loi Informatique et Libertés art. 45)
    $age_minimum = () => 15

    // Âge en années révolues d'une date de naissance AAAA-MM-JJ, ou null si la date est
    // invalide, antérieure à 1900 ou future
    $calculer_age = (date_naissance, date_reference) =>
    {
        const maintenant = date_reference ?? new Date()
        const morceaux = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(date_naissance ?? ''))
        if (!morceaux)
            return null

        const [annee, mois, jour] = morceaux.slice(1).map(Number)
        const date = new Date(Date.UTC(annee, mois - 1, jour))

        const existe = date.getUTCFullYear() === annee
                    && date.getUTCMonth()    === mois - 1
                    && date.getUTCDate()     === jour
        if (!existe || annee < 1900 || date > maintenant)
            return null

        const anniversaire_passe = maintenant.getUTCMonth() > mois - 1
                                || (maintenant.getUTCMonth() === mois - 1 && maintenant.getUTCDate() >= jour)

        return maintenant.getUTCFullYear() - annee - (anniversaire_passe ? 0 : 1)
    }

    // ─── Pages ───────────────────────────────────────────────────────────────

    $langue_preferee = () => ({ langue: 'fr', region: 'FR' })

    $creer_pages_obligatoires = async () =>
    {
        const pages = [ 'conditions-d-utilisation', 'mentions-legales', 'politique-de-confidentialite' ]

        for (const id of pages)
        {
            const existante = await $search_one('anicroche', `#id = $id`, { $id: id })
            if (existante)
                continue

            await $create_one('anicroche', { id, type: 'page' })
            console.log(`  PAGE   ${id} créée`)
        }
    }

    // Version publiée la plus récente dont la date est passée
    $version_en_vigueur = async (id_anicroche) =>
        await $search_one('version',
            `
            #id_anicroche     = $id_anicroche
          & #date_publication <= now
            `,
            { $id_anicroche: id_anicroche },
            { order: 'numero', dir: 'desc' }
        )
]
