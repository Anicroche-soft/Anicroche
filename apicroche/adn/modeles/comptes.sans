@name [ comptes, compte ]

@primary [ id ]

@fields [
    {
        name    : id
        type    : char
        size    : 12
        chars   : [A-Z0-9]
        default : auto
    }

    {
        name  : hachage_mot_de_passe
        type  : hash
        size  : 1-256
        count : 0-1
        rule  : "$hachage_mot_de_passe ~= /^.{12,128}$/"
    }

    {
        name : date_naissance
        type : crypt
        size : 1-64
        rule : "$date_naissance ~= /^\d{4}-\d{2}-\d{2}$/"
    }

    {
        name : date_acceptation_conditions
        type : datetime
    }

    {
        name    : date_inscription
        type    : date
        default : now
    }

    {
        name  : coordonnees
        count : 0-N
    }

    {
        name  : sessions
        count : 0-N
    }
]

@routes [
    {
        path   : /moi
        method : get
        action : "$obtenir_compte()"
    }

    {
        path   : /inscription
        action : $inscrire_compte($body)
    }

    {
        path   : /connexion
        action : "$connecter_compte($body, $request)"
    }

    {
        path   : /deconnexion
        action : $deconnecter_compte($request)
    }
]

@script [
    $obtenir_compte = async () =>
    {
        await $exiger_compte()

        const compte = await $search_one('comptes',
            `
            #id = $id_compte
            `,
            { $id_compte: $context.compte.id },
            { select: 'id ; date_inscription ; coordonnees.type,coordonnee,est_principale ; is_gerant_of_profils.id,identifiant,pseudonyme,role,date_creation' }
        )

        return $indicate(200, "Compte récupéré", compte)
    }

    $inscrire_compte = async ($body) =>
    {
        if (
            !$body.coordonnee
         || !$body.clef
         || !$body.mot_de_passe
         || !$body.date_naissance
         || !Array.isArray($body.ids)
         || !$body.ids.length
        )
            return $indicate(400, "Corps incomplet")

        // Vérifiés avant la clef, pour ne pas consommer d'essai
        const age = $calculer_age($body.date_naissance)

        if (age === null)
            return $indicate(422, "Date de naissance invalide")

        if (age < $age_minimum())
            return $indicate(403, "Âge minimum non atteint")

        if ($body.accepte_conditions !== true)
            return $indicate(422, "Conditions d'utilisation non acceptées")

        // En dev, l'inscription reste possible tant qu'aucune version des conditions n'est publiée
        const conditions = await $version_en_vigueur('conditions-generales-d-utilisation')

        if (!conditions && (process.env.mode || 'prod') !== 'dev')
            return $indicate(503, "Conditions d'utilisation indisponibles")

        const clef = await $verifier_clef()

        const coordonnee_existante = await $search_one('coordonnee',
            `
            #hachage_coordonnee = $body.coordonnee
            `
        )

        if (!clef || coordonnee_existante)
            return $indicate(403, 'Accès refusé')

        await $delete_all('clefs',
            `
            #hachage_coordonnee = $body.coordonnee
          & #type               = authentification
            `
        )

        const compte = await $create_one('compte', {
            hachage_mot_de_passe        : $body.mot_de_passe,
            date_naissance              : $body.date_naissance,
            date_acceptation_conditions : new Date()
        })

        // Les codes ne sont envoyés que par courriel ; deux inscriptions simultanées peuvent passer la vérification de la clef
        try
        {
            await $create_one('coordonnee', {
                type               : 'courriel',
                coordonnee         : $body.coordonnee,
                hachage_coordonnee : $body.coordonnee,
                est_principale     : true,
                id_compte          : compte.id
            })
        }
        catch (erreur)
        {
            await $delete_one('compte', `#id = $compte.id`, { $compte: compte })
            throw erreur
        }

        return $indicate(201, "Inscription réussie")
    }

    $connecter_compte = async ($body, $request) =>
    {
        if (
            !$body.coordonnee
         || (
                !$body.mot_de_passe
             && (
                    !$body.clef
                 || !Array.isArray($body.ids)
                 || !$body.ids.length
                )
            )
        )
            return $indicate(400, "Corps incomplet")

        const coordonnee = await $search_one('coordonnee',
            `
            #hachage_coordonnee = $body.coordonnee
            `
        )

        if ($body.mot_de_passe)
        {
            await $limit('echecs_mot_de_passe', '20/1h', { count: false })

            const compte = coordonnee
                ? await $search_one('compte',
                    `
                    #id                   = $coordonnee.id_compte
                  & #hachage_mot_de_passe = $body.mot_de_passe
                    `,
                    { $coordonnee: coordonnee }
                )
                : await $verify_hash(null, $body.mot_de_passe)

            if (!compte)
            {
                await $limit('echecs_mot_de_passe', '20/1h')
                return $indicate(403, "Accès refusé")
            }
        }
        else
        {
            const clef = await $verifier_clef()

            if (!clef || !coordonnee)
                return $indicate(403, 'Accès refusé')

            await $delete_all('clefs',
                `
                #hachage_coordonnee = $body.coordonnee
              & #type               = authentification
                `
            )
        }

        const session = await $create_one('session',
            {
                adresse_ip        : $request.ip,
                agent_utilisateur : $request.user_agent,
                id_compte         : coordonnee.id_compte
            }
        )

        const cookie_session = `${session.id}.${session.jeton}`
        $set_cookie('jeton', cookie_session, { lifetime: '30d' })


        const jeton_acces = await $sign_token({ id_compte: coordonnee.id_compte })

        $add_to_respond('est_connecte', true)

        return $indicate(200, "Connexion réussie", { jeton_acces })
    }

    $deconnecter_compte = async ($request) =>
    {
        await $exiger_compte()

        const cookie_session = $request.cookies?.jeton ?? null

        if (cookie_session)
        {
            const separateur = cookie_session.indexOf('.')

            if (separateur > 0 && separateur < cookie_session.length - 1)
            {
                const id_session = cookie_session.slice(0, separateur)

                await $update_one('session',
                    `
                    #id              = $id_session
                    `,
                    {
                        date_revocation : 'now'
                    },
                    { $id_session: id_session }
                )
            }
        }

        $set_cookie('jeton', '', { lifetime: 0 })

        $add_to_respond('est_connecte', false)

        return $indicate(200, "Déconnexion réussie")
    }
]
