@name [ profils, profil ]

@primary [ id ]

@unique [
    [ identifiant ]
]

@fields [
    {
        name    : id
        type    : char
        size    : 15
        chars   : [A-Z0-9]
        default : auto
    }

    # Un profil sans gérant est anonymisé : il n a plus d identifiant ni de pseudonyme
    # (voir effacement.sans)
    {
        name  : identifiant
        type  : char
        size  : 1-65
        count : 0-1
        rule : "$identifiant ~= /^(?=.{1,32}(?:\.|$))(?=[a-z0-9-]*[a-z])[a-z0-9]+(?:-[a-z0-9]+)*(?:\.(?=.{1,32}$)(?=[a-z0-9-]*[a-z])[a-z0-9]+(?:-[a-z0-9]+)*)?$/"

        can_create   : ':)'
        prior_create : $valider_creation_profil($values)
        post_create  : $lier_createur_au_profil($values)

        can_update   : "$context.compte"
        prior_update : "$valider_modification_identifiant($values, $request)"
        post_update  : "$appliquer_renommage_profil($values, $request)"
    }

    {
        name  : pseudonyme
        type  : char
        size  : 1-64
        count : 0-1

        can_create : ':)'
        can_update : "$context.compte"
    }

    # Rôle du profil sur le site : appelé à recevoir d autres valeurs
    {
        name    : role
        type    : visiteur/maitre
        default : visiteur
    }

    {
        name    : date_creation
        type    : date
        default : now
    }

    # Fermeture du profil (voir fermetures_profils.sans) : choix fait à la demande de fermeture
    # du profil (PATCH { sort, mot_de_passe }, annulée par PATCH { sort: null }), ou à la demande
    # d effacement du compte de son seul gérant (anonymisation par défaut)
    {
        name  : sort
        type  : anonymisation/suppression
        count : 0-1

        can_update   : "$context.compte"
        prior_update : "$valider_fermeture_profil($values, $request)"
        post_update  : "$appliquer_fermeture_profil($values, $request)"
    }

    # Échéance de la fermeture demandée pour le profil lui-même
    {
        name  : date_fermeture
        type  : datetime
        count : 0-1
    }

    # Nombre de rappels de la fermeture déjà envoyés
    {
        name    : nombre_avertissements
        type    : tinyint
        default : 0
    }

    # Un profil désactivé reste à ses gérants, qui peuvent le réactiver
    {
        name    : desactive
        type    : boolean
        default : 0

        can_update   : "$context.compte"
        prior_update : "$valider_desactivation_profil($values, $request)"
        post_update  : "$annoncer_desactivation_profil($values, $request)"
    }

    {
        name  : gerants
        entry : gerant
        ref   : comptes
        count : N-N
    }
]

@rules [
    restrict_update : "#gerants.id = $context.compte.id"
]

@routes [
    {
        path   : /profil/<$id>/derives
        method : get
        action : $compter_profils_derives($request)
    }
]

@script [
    // Au plus 5 profils racines (sans .) par compte
    const LIMITE_RACINES = 5

    const lire_racine = (identifiant) =>
    {
        const separateur = identifiant.indexOf('.')
        return separateur > 0 ? identifiant.slice(0, separateur) : null
    }

    const chercher_derives = (identifiant) =>
        $search_all('profils',
            `#identifiant ~= $motif`,
            { $motif: new RegExp(`^${identifiant}\\.`) },
            { select: 'id ; identifiant' }
        )

    const compter_racines_gerees = async () =>
    {
        const profils = await $search_all('profils',
            `#gerants.id = $id_compte`,
            { $id_compte: $context.compte.id },
            { select: 'identifiant' }
        )
        return profils.filter(profil => !(profil.identifiant ?? '').includes('.')).length
    }

    const est_gerant = async (id_profil) =>
        !!await $search_one('gerant_profil',
            `
            #id_compte = $id_compte
          & #id_profil = $id_profil
            `,
            { $id_compte: $context.compte.id, $id_profil: id_profil }
        )

    // Vérifie qu'un identifiant peut être pris : disponible, et selon son type,
    // racine dans la limite du compte ou dérivé d'un profil racine géré par le compte
    const verifier_identifiant = async (identifiant, profil_actuel = null) =>
    {
        const existant = await $search_one('profil', `#identifiant = $identifiant`, { $identifiant: identifiant })
        if (existant && existant.id !== profil_actuel?.id)
            return $indicate(409, "Identifiant déjà utilisé")

        // Réservé à un autre profil, ou à aucun (voir reservations.sans) : refusé de même, sans
        // dire qu il est réservé
        if (await $est_reserve_a_un_autre(identifiant, profil_actuel?.id))
            return $indicate(409, "Identifiant déjà utilisé")

        const racine = lire_racine(identifiant)

        // Une base portée par des profils dérivés reste réservée, même sans profil racine :
        // ils en sont détachés quand leur racine disparaît (voir effacement.sans), mais un nom
        // libéré par erreur permettrait de prendre la main sur leurs futurs dérivés
        if (!racine && profil_actuel?.identifiant !== identifiant && (await chercher_derives(identifiant)).length)
            return $indicate(409, "Identifiant déjà utilisé")

        if (!racine)
        {
            const deja_racine = profil_actuel && !profil_actuel.identifiant.includes('.')
            if (!deja_racine && await compter_racines_gerees() >= LIMITE_RACINES)
                return $indicate(403, "Limite de profils racines atteinte")
            return
        }

        const parent = await $search_one('profil', `#identifiant = $racine`, { $racine: racine })
        if (!parent || parent.id === profil_actuel?.id)
            return $indicate(422, "Profil racine introuvable")

        // Garder sa base reste permis à un profil dérivé dont le compte ne gère pas la racine
        const meme_racine = profil_actuel && lire_racine(profil_actuel.identifiant) === racine
        if (!meme_racine && !await est_gerant(parent.id))
            return $indicate(403, "Profil racine inaccessible")
    }

    $valider_creation_profil = async ($values) =>
    {
        await $exiger_compte()

        if (!$values.identifiant || !$values.pseudonyme)
            return $indicate(400, "Corps incomplet")

        await verifier_identifiant($values.identifiant)
    }

    $lier_createur_au_profil = async ($values) =>
    {
        await $create_one('gerant_profil', {
            id_compte: $context.compte.id,
            id_profil: $values.id
        })
    }

    // PATCH /profil/<id> { identifiant, mot_de_passe } : changer d identifiant demande le mot de
    // passe du compte (une session seule ne suffit pas). Un profil racine qui a des profils
    // dérivés garde son type : le renommer renomme aussi ses dérivés, y compris ceux que le
    // compte ne gère pas
    $valider_modification_identifiant = async ($values, $request) =>
    {
        const profil = await $search_one('profil', `#id = $id`, { $id: $request.params.id })
        if (!profil || $values.identifiant === profil.identifiant)
            return

        await verifier_identifiant($values.identifiant, profil)

        const derives = profil.identifiant.includes('.') ? [] : await chercher_derives(profil.identifiant)

        if (derives.length && $values.identifiant.includes('.'))
            return $indicate(422, "Un profil qui a des profils dérivés ne peut pas devenir un profil dérivé")

        for (const derive of derives)
        {
            const nouveau = $values.identifiant + derive.identifiant.slice(profil.identifiant.length)
            if (await $search_one('profil', `#identifiant = $nouveau`, { $nouveau: nouveau })
             || await $est_reserve_a_un_autre(nouveau, derive.id))
                return $indicate(409, `L'identifiant ${nouveau} est déjà utilisé`)
        }

        // L ancien identifiant sera réservé au profil : au-delà de la limite, il faut attendre
        // la fin d une réservation, sauf pour reprendre un identifiant réservé (le nombre de
        // réservations ne change pas)
        const reservations = await $lire_reservations_profil(profil.id)
        const reprise      = reservations.some(reservation => reservation.identifiant === $values.identifiant)
        if (!reprise && reservations.length >= $LIMITE_RESERVATIONS)
            return $indicate(403, `Trop de changements d'identifiant récents : le prochain sera possible le ${formater_date(reservations[0].date_fin)}`)

        // En dernier : une erreur sur l identifiant ne consomme pas d essai de mot de passe
        if (!await $verifier_mot_de_passe())
            return $indicate(403, "Mot de passe invalide")

        $context.renommage_profil = { ancien: profil.identifiant, derives }
    }

    const formater_date = (date) => new Date(date).toLocaleDateString('fr-FR', {
        day      : 'numeric',
        month    : 'long',
        year     : 'numeric',
        timeZone : 'Europe/Paris'
    })

    // Renomme les profils dérivés, réserve à chaque profil renommé son ancien identifiant (et
    // libère celui qu il reprend), puis prévient les gérants
    $appliquer_renommage_profil = async ($values, $request) =>
    {
        const renommage = $context.renommage_profil
        if (!renommage)
            return

        const renommes = [ { id: $request.params.id, ancien: renommage.ancien, nouveau: $values.identifiant } ]

        for (const derive of renommage.derives)
        {
            const nouveau = $values.identifiant + derive.identifiant.slice(renommage.ancien.length)
            await $update_one('profil', `#id = $id`, { identifiant: nouveau }, { $id: derive.id })
            renommes.push({ id: derive.id, ancien: derive.identifiant, nouveau })
        }

        for (const profil of renommes)
        {
            await $retirer_reservation(profil.nouveau, profil.id)
            await $reserver_identifiant(profil.ancien, profil.id)
        }

        await prevenir_gerants_renommage(renommes)
    }

    // Chaque gérant d un profil renommé reçoit, à toutes ses adresses, la liste des profils qu il
    // gère parmi ceux renommés (les dérivés peuvent avoir d autres gérants que leur racine)
    const prevenir_gerants_renommage = async (renommes) =>
    {
        const par_compte = new Map()
        for (const profil of renommes)
        {
            const liens = await $search_all('gerants_profils', `#id_profil = $id`, { $id: profil.id })
            for (const lien of liens)
                par_compte.set(lien.id_compte, [ ...(par_compte.get(lien.id_compte) ?? []), profil ])
        }

        for (const [ id_compte, profils ] of par_compte)
        {
            const changements = profils
                .map(profil => `<li>@${profil.ancien} devient @${profil.nouveau}</li>`)
                .join('')

            await $ecrire_courriels(await $lire_courriels(id_compte),
                profils.length > 1
                    ? "Les identifiants de profils que vous gérez sur Anicroche ont changé"
                    : "L'identifiant d'un profil que vous gérez sur Anicroche a changé",
                `<p>${profils.length > 1 ? "Les identifiants de profils que vous gérez ont été modifiés" : "L'identifiant d'un profil que vous gérez a été modifié"} :</p>`
              + `<ul>${changements}</ul>`
              + `<p>${profils.length > 1 ? "Les anciens identifiants restent réservés à leur profil" : "L'ancien identifiant reste réservé à ce profil"} jusqu'au ${formater_date($date_fin_reservation())} : personne d'autre ne peut le prendre, et vous pouvez le reprendre d'ici là.</p>`
              + `<p>Si ni vous ni un autre gérant de ce profil n'êtes à l'origine de ce changement, changez votre mot de passe, fermez les sessions que vous ne reconnaissez pas, puis rétablissez l'identifiant depuis la page d'édition du profil.</p>`
            )
        }
    }

    // ─── Fermeture et désactivation ──────────────────────────────────────────

    // Demander la fermeture exige le mot de passe et un profil qui peut fermer ; l annuler, une
    // fermeture en cours. Le mot de passe est vérifié en dernier : une demande impossible ne
    // consomme pas d essai
    $valider_fermeture_profil = async ($values, $request) =>
    {
        await $exiger_compte()

        const profil = await $search_one('profil', `#id = $id`, { $id: $request.params.id })

        if ($values.sort === null)
        {
            if (!profil.date_fermeture)
                return $indicate(409, "Aucune fermeture en cours")

            $context.fermeture_profil = { profil, annulation: true }
            return
        }

        if (![ 'anonymisation', 'suppression' ].includes($values.sort))
            return $indicate(422, "Valeur invalide : sort")

        if (profil.date_fermeture)
            return $indicate(409, "Fermeture déjà demandée")

        const raison = await $empecher_fermeture_profil(profil.id)
        if (raison)
            return $indicate(403, raison)

        if (!await $verifier_mot_de_passe())
            return $indicate(403, "Mot de passe invalide")

        $context.fermeture_profil = { profil, annulation: false }
    }

    $appliquer_fermeture_profil = async ($values, $request) =>
    {
        const { profil, annulation } = $context.fermeture_profil

        if (annulation)
        {
            await $update_one('profil',
                `#id = $id`,
                { date_fermeture: null, nombre_avertissements: 0 },
                { $id: profil.id }
            )
            await $annoncer_annulation_fermeture(profil, profil.sort)
            return
        }

        const date_fermeture = $calculer_date_fermeture()

        await $update_one('profil',
            `#id = $id`,
            { date_fermeture, nombre_avertissements: 0 },
            { $id: profil.id }
        )
        await $annoncer_demande_fermeture(profil, $values.sort, date_fermeture)

        $add_to_data('date_fermeture', date_fermeture)
    }

    $valider_desactivation_profil = async ($values, $request) =>
    {
        await $exiger_compte()

        if (typeof $values.desactive !== 'boolean')
            return $indicate(422, "Valeur invalide : desactive")

        const profil = await $search_one('profil', `#id = $id`, { $id: $request.params.id })

        $context.desactivation_profil = { profil, change: !!profil.desactive !== $values.desactive }
    }

    // Tous les gérants sont prévenus, celui qui a fait le changement compris
    $annoncer_desactivation_profil = async ($values, $request) =>
    {
        const { profil, change } = $context.desactivation_profil
        if (!change)
            return

        const liens = await $search_all('gerants_profils', `#id_profil = $id`, { $id: profil.id })

        for (const lien of liens)
            await $ecrire_courriels(await $lire_courriels(lien.id_compte),
                $values.desactive
                    ? `Votre profil @${profil.identifiant} a été désactivé`
                    : `Votre profil @${profil.identifiant} a été réactivé`,
                (
                    $values.desactive
                        ? `<p>Votre profil @${profil.identifiant} a été désactivé par l'un de ses gérants. Il peut être réactivé à tout moment depuis la page d'édition du profil.</p>`
                        : `<p>Votre profil @${profil.identifiant} a été réactivé par l'un de ses gérants.</p>`
                )
              + `<p>Si ni vous ni un autre gérant de ce profil n'êtes à l'origine de ce changement, changez votre mot de passe et fermez les sessions que vous ne reconnaissez pas.</p>`
            )
    }

    $compter_profils_derives = async ($request) =>
    {
        await $exiger_compte()

        const id = $request.params.id
        if (!await est_gerant(id))
            return $indicate(404, "Introuvable")

        const profil = await $search_one('profil', `#id = $id`, { $id: id })
        const derives = profil.identifiant.includes('.') ? [] : await chercher_derives(profil.identifiant)

        return $indicate(200, "Profils dérivés comptés", { nombre: derives.length })
    }
]
