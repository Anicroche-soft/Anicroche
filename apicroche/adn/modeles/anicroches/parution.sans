@script [
    // Une version est parue quand sa date de parution est passée
    $est_parue = (version) =>
        !!version?.date_parution && new Date(version.date_parution) <= new Date()

    // Version parue la plus récente, quel que soit son accès
    $version_en_vigueur = async (id_anicroche) =>
        await $search_one('version',
            `
            #id_anicroche  = $id_anicroche
          & #date_parution <= now
            `,
            { $id_anicroche: id_anicroche },
            { order: [[ 'numero', 'decreasing' ]] }
        )

    // Sources d une version, telles qu elle les montre (voir les replis de sources.sans) : une
    // source par rôle, ou une liste rangée par position pour un rôle à plusieurs sources
    $sources_version = async (anicroche, numero) =>
    {
        const lignes = await $search_all('sources', `#id_anicroche = $id`, { $id: anicroche.id },
            { fallback: { version: numero }, order: [[ 'position', 'increasing' ]] })

        const multiples = new Set($sources_type(anicroche.type).filter(source => source.max > 1).map(source => source.role))
        const sources   = {}

        for (const ligne of lignes)
        {
            const source = {
                position : ligne.position,
                langue   : ligne.langue,
                region   : ligne.region,
                version  : ligne.version,
                contenu  : ligne.contenu
            }

            if (multiples.has(ligne.role))
                (sources[ligne.role] ??= []).push(source)
            else
                sources[ligne.role] ??= source
        }

        return sources
    }
]
