@name [ anicroches, anicroche ]

@primary [ id ]

@fields [
    # Libre ou attribué automatiquement, selon le type (voir types.sans)
    {
        name         : id
        type         : char
        size         : 1-48
        can_create   : ':)'
        can_search   : ':)'
        prior_create : $verifier_creation_anicroche($values)
        post_create  : $ouvrir_premier_brouillon($values)
    }

    # Une clef de types_anicroches (app.adn)
    {
        name       : type
        type       : char
        size       : 1-32
        can_create : ':)'
        can_search : ':)'
    }

    # Langue et région d origine : celles des sources quand aucune préférence n est trouvée
    {
        name       : langue
        type       : char
        size       : 2-3
        rule       : "$langue ~= /^[a-z]{2,3}$/"
        default    : fr
        can_create : ':)'
        can_search : ':)'
    }

    {
        name       : region
        type       : char
        size       : 0-3
        rule       : "$region ~= /^([A-Z]{2}|[0-9]{3})?$/"
        default    : FR
        can_create : ':)'
        can_search : ':)'
    }

    # PATCH /anicroche/<id> { acces } :
    # - prive   : seuls ses gérants la voient ;
    # - partage : visible de quiconque la demande seule (par son lien), mais absente des listes ;
    # - public  : visible de tous, et listée.
    # Une anicroche légale est toujours publique (voir exceptions.sans)
    {
        name         : acces
        type         : prive/partage/public
        default      : prive
        can_update   : ':)'
        can_search   : ':)'
        prior_update : "$verifier_acces_anicroche($values, $request)"
    }

    # Une relation projetée ne montre que les entrées visibles (voir le restrict_search de
    # versions.sans et de sources.sans)
    {
        name       : versions
        count      : 0-N
        can_search : ':)'
    }

    {
        name       : sources
        count      : 0-N
        can_search : ':)'
    }

    {
        name  : annonces
        count : 0-N
    }

    # Pour un type avec auteurs, une anicroche sans auteurs est supprimée : ses sources ont été
    # vidés (voir effacement.sans)
    {
        name  : auteurs
        entry : auteur
        ref   : profils
        count : N-N
    }
]

# Une anicroche supprimée n est jamais visible. Les autres le sont pour leurs gérants (les
# profils qui administrent son type, et ses auteurs), et pour tous selon leur accès (partagée :
# seulement demandée seule), dès qu une de leurs versions est visible (voir versions.sans) :
# parue, programmée, ou brouillon à l essai
@rules [
    restrict_search : "
        ( !(#type -{ $context.types_avec_auteurs) | #auteurs.id != null )
      & ( #type -{ $context.types_administres
        | #auteurs.id = $context.profil.id
        | ( ( #acces = public
            | ( #acces = partage & $request.params.id != null ) )
          & ( #versions.acces = public
            | ( #versions.acces = programme & #versions.date_parution <= now )
            | ( #versions.acces = partage & $request.params.id != null ) ) ) )
    "
]

@script [
    $verifier_creation_anicroche = async ($values) =>
    {
        if (!$type_anicroche($values.type))
            return $indicate(422, "Type d'anicroche inconnu")

        await $exiger_administration($values.type)
        await $preparer_identifiant($values)
    }

    $verifier_acces_anicroche = async ($values, $request) =>
    {
        const anicroche = await $exiger_administration_anicroche($request.params.id)

        if ($est_legale(anicroche) && $values.acces !== 'public')
            return $indicate(422, "Cette page est légale : elle doit rester publique")
    }

    $ouvrir_premier_brouillon = async ($values) =>
    {
        await $initialiser_anicroche({ id: $values.id, type: $values.type })
        $add_to_data('id', $values.id)
        $add_to_data('brouillon', 1)
    }
]
