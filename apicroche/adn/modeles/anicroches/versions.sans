@name [ versions, version ]

@primary [ id_anicroche, numero ]

# Une version est un brouillon tant qu elle n est pas parue : sans date de parution, ou avec
# une parution programmée. Ses sources ne se modifient que sans date de parution : une
# version programmée doit d abord être déprogrammée
@fields [
    # POST /version { id_anicroche } crée le brouillon suivant de l anicroche
    {
        name         : id_anicroche
        type         : char
        size         : 1-48
        can_create   : ':)'
        can_search   : ':)'
        prior_create : $preparer_brouillon($values)
        post_create  : $completer_brouillon($values)
    }

    {
        name       : numero
        type       : int
        can_search : ':)'
    }

    # PATCH /version/<$id_anicroche>/<$numero> { date_parution } fait paraître le brouillon
    # maintenant ("now") ou le programme à une date future ; null annule une parution
    # programmée, sauf pour une anicroche soumise au préavis (voir types.sans)
    {
        name         : date_parution
        type         : datetime
        count        : 0-1
        can_update   : ':)'
        can_search   : ':)'
        prior_update : "$verifier_parution($values, $request)"
    }

    # PATCH /version/<$id_anicroche>/<$numero> { acces }, parue ou non :
    # - prive     : seuls les gérants de l anicroche la voient (voir anicroches.sans) ;
    # - partage   : visible de quiconque demande l anicroche, mais absente des listes ;
    # - programme : privée jusqu à sa date de parution, publique ensuite (seulement pour une
    #               version programmée ; lu public une fois la version parue, et remplacé par
    #               public en base, voir parution.sans) ;
    # - public    : visible de tous, et listée.
    # Un changement de date de parution fixe l accès, qui peut ensuite être modifié : public à
    # la parution immédiate, programme à la programmation, prive à l annulation d une parution
    # programmée. Une version datée (parue ou programmée) d une anicroche légale est toujours
    # publique : la version en vigueur et celle qui est annoncée doivent pouvoir être lues
    {
        name       : acces
        type       : prive/partage/programme/public
        default    : prive
        can_update : ':)'
        can_search : ':)'
        read       : {
            when  : "$acces = programme & $date_parution <= now"
            value : public
        }
    }
]

# Les gérants de l anicroche (voir anicroches.sans) voient toutes ses versions, les autres ses
# versions (brouillon compris : public, il est à l essai) selon leur accès et celui de l anicroche (partagée seulement pour une
# anicroche demandée seule, programmée une fois parue). DELETE /version/<$id_anicroche>/<$numero>
# supprime un brouillon non programmé et ses sources
@rules [
    restrict_search : "
        #is_version_of_anicroche.type -{ $context.types_administres
      | #is_version_of_anicroche.auteurs.id = $context.profil.id
      | ( ( #is_version_of_anicroche.acces = public
          | ( #is_version_of_anicroche.acces = partage & ( $request.params.id != null | $request.params.id_anicroche != null ) ) )
        & ( #acces = public
          | ( #acces = programme & #date_parution <= now )
          | ( #acces = partage & ( $request.params.id != null | $request.params.id_anicroche != null ) ) ) )
    "
    prior_update    : "$verifier_modification_version($values, $request)"
    can_delete      : "$context.compte"
    restrict_delete : "#date_parution = null"
    prior_delete    : $supprimer_sources_brouillon($values)
]

@script [
    const MARGE         = 60 * 1000
    const JOURS_PREAVIS = 30

    $preparer_brouillon = async ($values) =>
    {
        await $exiger_administration_anicroche($values.id_anicroche)

        const derniere = await $search_one('version',
            `#id_anicroche = $id`,
            { $id: $values.id_anicroche },
            { order: [[ 'numero', 'decreasing' ]] }
        )

        if (derniere && !$est_parue(derniere))
            return $indicate(409, "Un brouillon existe déjà", { numero: derniere.numero })

        $values.numero = (derniere?.numero ?? 0) + 1
    }

    $supprimer_sources_brouillon = async ($values) =>
    {
        await $exiger_administration_anicroche($values.id_anicroche)

        await $delete_all('sources',
            `
            #id_anicroche = $id_anicroche
          & #version      = $numero
            `,
            { $id_anicroche: $values.id_anicroche, $numero: $values.numero }
        )
    }

    // Une source obligatoire ajoutée au type après les versions précédentes est créée dans
    // le nouveau brouillon
    $completer_brouillon = async ($values) =>
    {
        const anicroche = await $search_one('anicroche', `#id = $id`, { $id: $values.id_anicroche })
        if (anicroche)
            await $creer_sources_obligatoires(anicroche)

        $add_to_data('numero', $values.numero)
    }

    // Un changement de date fixe l accès (la date elle-même est vérifiée par
    // $verifier_parution) ; une version d une anicroche légale ou soumise au préavis est publique
    // dès sa programmation, pour être lue pendant son annonce
    const acces_apres_parution = (anicroche, version, date_parution) =>
    {
        if (date_parution === null)
            return version?.acces === 'programme' ? 'prive' : version?.acces
        if (date_parution === 'now' || $est_legale(anicroche) || $soumise_au_preavis(anicroche))
            return 'public'
        return 'programme'
    }

    // L état de la version après la modification est vérifié
    $verifier_modification_version = async ($values, $request) =>
    {
        const anicroche = await $exiger_administration_anicroche($request.params.id_anicroche)
        const version   = await $search_one('version',
            `
            #id_anicroche = $id
          & #numero       = $numero
            `,
            { $id: anicroche.id, $numero: Number($request.params.numero) }
        )

        if ('date_parution' in $values)
            $values.acces = acces_apres_parution(anicroche, version, $values.date_parution)
        else if ($values.acces === 'programme' && !(version?.date_parution && !$est_parue(version)))
            return $indicate(422, "Seule une version dont la parution est programmée peut avoir l'accès programmé")

        if (!$est_legale(anicroche))
            return

        const date  = 'date_parution' in $values ? $values.date_parution : version?.date_parution
        const acces = $values.acces ?? version?.acces

        if (date && acces !== 'public')
            return $indicate(422, "Cette page est légale : une version parue ou programmée doit être publique")
    }

    $verifier_parution = async ($values, $request) =>
    {
        const anicroche = await $exiger_administration_anicroche($request.params.id_anicroche)
        const numero    = Number($request.params.numero)
        const version   = await $search_one('version',
            `
            #id_anicroche = $id
          & #numero       = $numero
            `,
            { $id: anicroche.id, $numero: numero }
        )

        // Une version parue ne change plus de date : les acceptations des conditions déjà
        // enregistrées désigneraient une autre version
        if ($est_parue(version))
            return $indicate(422, "Une version parue ne peut plus changer de date")

        // Le préavis annoncé doit être tenu : une erreur se corrige directement en base
        if (version?.date_parution && $soumise_au_preavis(anicroche))
            return $indicate(422, "La parution programmée d'une page soumise au préavis ne peut être ni annulée ni déplacée")

        if ($values.date_parution === null)
            return

        // Une minute de marge couvre le délai de la requête ; "now" fait paraître immédiatement
        if ($values.date_parution !== 'now')
        {
            const date = new Date($values.date_parution)

            if (Number.isNaN(date.getTime()))
                return $indicate(422, "Date de parution invalide")

            if (date < new Date(Date.now() - MARGE))
                return $indicate(422, "La date de parution ne peut pas être passée")

            // Une page soumise au préavis paraît immédiatement (correction mineure) ou après un
            // préavis d au moins 30 jours (modification de fond), compté à partir du dernier
            // courriel d annonce : les jours d envoi, selon le quota, s y ajoutent
            if ($soumise_au_preavis(anicroche))
            {
                const jours   = JOURS_PREAVIS + await $jours_envoi_annonces()
                const minimum = new Date(Date.now() + jours * 24 * 60 * 60 * 1000)

                if (date < new Date(minimum.getTime() - MARGE))
                    return $indicate(422,
                        `Cette page est soumise au préavis : elle paraît immédiatement (correction mineure) ou au plus tôt le ${minimum.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris' })} (modification de fond : ${JOURS_PREAVIS} jours de préavis après l'envoi des annonces)`,
                        { date_minimale: minimum }
                    )
            }

            $values.date_parution = date
        }

        await $verifier_sources_publiables(anicroche, numero)
    }
]
