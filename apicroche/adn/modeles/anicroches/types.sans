# Types d anicroches, décrits dans la clef types_anicroches d app.adn. Chaque propriété d un
# type déclenche une possibilité du script général des anicroches ; toutes sont facultatives,
# et une valeur absente ou invalide (signalée au démarrage) prend sa valeur par défaut :
# - libelle        : nom du type affiché par le site (« Page ») ; par défaut, le nom du type ;
# - identifiant    : libre (choisi à la création, en minuscules) ou un nombre (clef
#                    automatique de ce nombre de caractères A-Z0-9) ; par défaut 15 ;
# - auteurs        : :) si les anicroches du type ont des profils auteurs ; par défaut :) ;
# - administration : rôles de profil qui ont tous les droits sur les anicroches du type ; par
#                    défaut aucun ;
# - sources        : rôles des sources, chacun avec son libellé (par défaut, le rôle), son
#                    format (voir FORMATS, par défaut texte) et son nombre de sources (0-1,
#                    1-1, 1-N…, par défaut 1-1), rangées par position ; les sources
#                    obligatoires sont créées vides avec l anicroche ; une source de format
#                    titre (une seule par type) donne le titre de chaque version ; par défaut
#                    aucune source ;
# - exceptions     : anicroches créées au démarrage (le type doit avoir un identifiant libre),
#                    chacune avec son identifiant, le contenu de ses sources obligatoires à
#                    leur création ({ <rôle> : <contenu> }, par défaut aucun) et ses
#                    spécificités (par défaut aucune) ; par défaut aucune exception :
#     - legalite    : une version parue ou programmée est toujours publique ;
#     - preavis     : l anicroche paraît immédiatement (correction mineure) ou au moins 30
#                     jours plus tard (modification de fond), et sa parution programmée ne peut
#                     être ni annulée ni déplacée ;
#     - acceptation : avec preavis, sa version en vigueur s accepte par une case à cocher à la
#                     restauration d un compte ; les autres versions inconnues du compte y
#                     sont seulement présentées.

@actions [
    {
        prior_run : $verifier_types_anicroches()
    }

    # Les droits sur les anicroches s expriment dans les restrict_search : $context reçoit les
    # types avec auteurs, et $resoudre_profil les types que le profil administre
    {
        prior_respond : $preparer_droits_anicroches()
    }
]

# GET /types donne la configuration de tous les types, la même pour tous : le site la garde en
# mémoire jusqu à son actualisation
@routes [
    {
        path   : /types
        method : get
        action : $obtenir_types()
    }
]

@script [
    const MOTIF_NOMBRE      = /^(\d+)-(\d+|N)$/
    const MOTIF_LISIBLE     = /^(?=[a-z0-9-]*[a-z])[a-z0-9]+(?:-[a-z0-9]+)*$/
    const CARACTERES_CLEF   = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'
    const LONGUEUR_MAXIMALE = 48

    // Clef des messages et commentaires, 36¹⁵ ≈ 2 × 10²³ possibilités : des multiples de 3,
    // plus courts pour les types peu nombreux, plus longs pour les fichiers
    const IDENTIFIANT_PAR_DEFAUT = 15
    const NOMBRE_PAR_DEFAUT      = '1-1'

    // Formats de source : ils décident du champ d édition et de l affichage dans le site
    const FORMATS = [ 'titre', 'texte' ]

    const SPECIFICITES = [ 'legalite', 'preavis', 'acceptation' ]

    const est_dictionnaire = (valeur) => !!valeur && typeof valeur === 'object' && !Array.isArray(valeur)

    // « 1-N » donne { min: 1, max: Infinity }, et null pour une valeur invalide
    $lire_nombre = (texte) =>
    {
        const morceaux = MOTIF_NOMBRE.exec(String(texte ?? NOMBRE_PAR_DEFAUT))
        if (!morceaux)
            return null

        const min = Number(morceaux[1])
        const max = morceaux[2] === 'N' ? Infinity : Number(morceaux[2])
        return min <= max ? { min, max } : null
    }

    const identifiant_valide = (identifiant) =>
        identifiant === 'libre' || (Number.isInteger(identifiant) && identifiant > 0 && identifiant <= LONGUEUR_MAXIMALE)

    const identifiant_lisible = (id) => typeof id === 'string' && MOTIF_LISIBLE.test(id) && id.length <= LONGUEUR_MAXIMALE

    // Configuration complétée de ses valeurs par défaut, la seule lue par le reste des scripts
    const completer_type = (nom, config) =>
    {
        config = est_dictionnaire(config) ? config : {}

        const sources = Object.entries(est_dictionnaire(config.sources) ? config.sources : {}).map(([role, source]) =>
        {
            source = est_dictionnaire(source) ? source : {}
            const nombre = $lire_nombre(source.nombre) ?? $lire_nombre(NOMBRE_PAR_DEFAUT)
            return {
                role,
                libelle : typeof source.libelle === 'string' ? source.libelle : role,
                format  : FORMATS.includes(source.format) ? source.format : 'texte',
                min     : nombre.min,
                max     : nombre.max
            }
        })

        return {
            libelle        : typeof config.libelle === 'string' ? config.libelle : nom,
            identifiant    : identifiant_valide(config.identifiant) ? config.identifiant : IDENTIFIANT_PAR_DEFAUT,
            auteurs        : typeof config.auteurs === 'boolean' ? config.auteurs : true,
            administration : Array.isArray(config.administration) ? config.administration : [],
            sources,
            exceptions     : (Array.isArray(config.exceptions) ? config.exceptions : [])
                .filter(exception => est_dictionnaire(exception) && identifiant_lisible(exception.identifiant))
                .map(exception => ({
                    identifiant  : exception.identifiant,
                    sources      : est_dictionnaire(exception.sources) ? exception.sources : {},
                    specificites : Array.isArray(exception.specificites)
                        ? exception.specificites.filter(specificite => SPECIFICITES.includes(specificite))
                        : []
                }))
        }
    }

    const types_completes = new Map(Object.entries(est_dictionnaire($app.types_anicroches) ? $app.types_anicroches : {})
        .map(([nom, config]) => [ nom, completer_type(nom, config) ]))

    $type_anicroche = (type) => types_completes.get(type) ?? null

    $sources_type = (type) => $type_anicroche(type)?.sources ?? []

    $a_des_auteurs = (type) => $type_anicroche(type)?.auteurs === true

    $preparer_droits_anicroches = () =>
    {
        $context.types_avec_auteurs = [ ...types_completes.keys() ].filter(type => $a_des_auteurs(type))
    }

    $types_administres = (role) =>
        [ ...types_completes ].filter(([, type]) => type.administration.includes(role)).map(([nom]) => nom)

    // Le site reçoit les exceptions sans le contenu de leurs sources, sauf leur titre (celui des
    // versions parues avant la source de titre du type), et un maximum illimité (N) vaut null
    const decrire_type = (type) => ({
        ...type,
        exceptions : type.exceptions.map(({ identifiant, specificites, sources }) =>
        {
            const role  = type.sources.find(source => source.format === 'titre')?.role
            const titre = role && typeof sources[role] === 'string' ? sources[role] : null
            return { identifiant, specificites, titre }
        }),
        sources    : type.sources.map(source => ({ ...source, max: Number.isFinite(source.max) ? source.max : null }))
    })

    $obtenir_types = () =>
    {
        const types = {}
        for (const [nom, type] of types_completes)
            types[nom] = decrire_type(type)

        return $indicate(200, 'Types récupérés', types)
    }

    // ─── Exceptions ──────────────────────────────────────────────────────────

    $exceptions_type = (type) => $type_anicroche(type)?.exceptions ?? []

    $exception_anicroche = (anicroche) =>
        $exceptions_type(anicroche?.type).find(exception => exception.identifiant === anicroche?.id) ?? null

    $a_specificite = (anicroche, specificite) =>
        $exception_anicroche(anicroche)?.specificites.includes(specificite) ?? false

    // Identifiants des anicroches de tous les types qui ont la spécificité
    $ids_specificite = (specificite) =>
        [ ...types_completes.keys() ].flatMap(type => $exceptions_type(type)
            .filter(exception => exception.specificites.includes(specificite))
            .map(exception => exception.identifiant))

    $est_legale = (anicroche) => $a_specificite(anicroche, 'legalite')

    $soumise_au_preavis = (anicroche) => $a_specificite(anicroche, 'preavis')

    // ─── Titres ──────────────────────────────────────────────────────────────

    $role_titre = (type) =>
        $sources_type(type).find(source => source.format === 'titre')?.role ?? null

    // Titre des sources d une version (voir $sources_version) : sa source de titre,
    // sinon celle de l exception à sa création, sinon l identifiant
    $titre_sources = (anicroche, sources) =>
    {
        const role    = $role_titre(anicroche.type)
        const valeur  = role ? sources?.[role] : null
        const source  = Array.isArray(valeur) ? valeur[0] : valeur
        const contenu = String(source?.contenu ?? '').trim()

        return contenu || (role && $exception_anicroche(anicroche)?.sources[role]) || anicroche.id
    }

    $titre_version = async (id_anicroche, numero) =>
    {
        const anicroche = await $search_one('anicroche', `#id = $id`, { $id: id_anicroche })
        if (!anicroche)
            return id_anicroche

        return $titre_sources(anicroche, await $sources_version(anicroche, numero))
    }

    // ─── Droits ──────────────────────────────────────────────────────────────

    // Le rôle est celui du profil sélectionné
    $administre_type = (type) =>
        !!$context.profil && ($type_anicroche(type)?.administration ?? []).includes($context.profil.role)

    $exiger_administration = async (type) =>
    {
        await $exiger_compte()

        if (!$administre_type(type))
            return $indicate(403, 'Accès refusé')
    }

    // Renvoie l anicroche, après avoir vérifié que le profil administre son type
    $exiger_administration_anicroche = async (id_anicroche) =>
    {
        await $exiger_compte()

        const anicroche = await $search_one('anicroche', `#id = $id`, { $id: id_anicroche })
        if (!anicroche)
            return $indicate(404, "Anicroche introuvable")

        await $exiger_administration(anicroche.type)
        return anicroche
    }

    // ─── Identifiants ────────────────────────────────────────────────────────

    const generer_clef = (longueur) =>
        Array.from(crypto.getRandomValues(new Uint32Array(longueur)), n => CARACTERES_CLEF[n % CARACTERES_CLEF.length]).join('')

    // Complète ou vérifie $values.id selon le type
    $preparer_identifiant = async ($values) =>
    {
        const identifiant = $type_anicroche($values.type).identifiant

        if (identifiant === 'libre')
        {
            if (!identifiant_lisible($values.id))
                return $indicate(422, "Identifiant invalide")

            if (await $search_one('anicroche', `#id = $id`, { $id: $values.id }))
                return $indicate(409, "Identifiant déjà utilisé")
            return
        }

        if ($values.id !== undefined && $values.id !== null && $values.id !== '')
            return $indicate(422, "L'identifiant de ce type est attribué automatiquement")

        for (;;)
        {
            const clef = generer_clef(identifiant)
            if (!await $search_one('anicroche', `#id = $id`, { $id: clef }))
            {
                $values.id = clef
                return
            }
        }
    }

    // ─── Sources ─────────────────────────────────────────────────────────────

    const compter_positions = async (id_anicroche, role) =>
    {
        const derniere = await $search_one('source',
            `
            #id_anicroche = $id
          & #role         = $role
            `,
            { $id: id_anicroche, $role: role },
            { order: [[ 'position', 'decreasing' ]] }
        )
        return derniere?.position ?? 0
    }

    // Sources obligatoires créées dans le dernier brouillon, jusqu au nombre minimum : vides,
    // ou avec le contenu donné par l exception de l anicroche
    $creer_sources_obligatoires = async (anicroche) =>
    {
        const brouillon = await $search_one('version',
            `
            #id_anicroche  = $id
          & #date_parution = null
            `,
            { $id: anicroche.id },
            { order: [[ 'numero', 'decreasing' ]] }
        )
        if (!brouillon)
            return

        const { langue, region } = await $search_one('anicroche', `#id = $id`, { $id: anicroche.id })
        const contenus           = $exception_anicroche(anicroche)?.sources ?? {}

        for (const source of $sources_type(anicroche.type))
        {
            for (let position = await compter_positions(anicroche.id, source.role) + 1; position <= source.min; position++)
                await $create_one('source', {
                    id_anicroche : anicroche.id,
                    role         : source.role,
                    position,
                    version      : brouillon.numero,
                    langue,
                    region,
                    contenu      : typeof contenus[source.role] === 'string' ? contenus[source.role] : ''
                })
        }
    }

    // Sans position, la source s ajoute à la suite : le nombre maximum de son rôle s applique
    $verifier_role_source = async (anicroche, role, position) =>
    {
        const source = $sources_type(anicroche.type).find(source => source.role === role && source.max > 0)
        if (!source)
            return $indicate(422, `Rôle invalide pour une anicroche de type ${anicroche.type}`)

        if ((position === undefined || position === null) && await compter_positions(anicroche.id, role) >= source.max)
            return $indicate(422, `Nombre maximum de sources ${role} atteint (${source.max})`)
    }

    // Une version ne se publie qu avec le nombre minimum de sources non vides de chaque rôle,
    // une source comptant dès qu elle est remplie dans une langue
    $verifier_sources_publiables = async (anicroche, numero) =>
    {
        // Dans chaque langue, la source la plus récente jusqu à la version
        const lignes = await $search_all('sources', `#id_anicroche = $id`, { $id: anicroche.id },
            { fallback: { version: numero, langue: '*', region: '*' } })

        for (const source of $sources_type(anicroche.type))
        {
            const positions = new Set(lignes
                .filter(ligne => ligne.role === source.role && String(ligne.contenu ?? '').trim() !== '')
                .map(ligne => ligne.position))

            if (positions.size < source.min)
                return $indicate(422, source.min > 1
                    ? `Il faut au moins ${source.min} sources ${source.role} remplies`
                    : `La source ${source.role} est vide`)
        }
    }

    // ─── Vérification au démarrage ───────────────────────────────────────────

    // Signale les valeurs invalides, remplacées par leur valeur par défaut
    $verifier_types_anicroches = () =>
    {
        const types = $app.types_anicroches

        if (!est_dictionnaire(types) || !Object.keys(types).length)
        {
            console.log("/!\\ app.adn : aucun type d'anicroche (types_anicroches)")
            return
        }

        for (const [type, config] of Object.entries(types))
        {
            const avertir = (message) => console.log(`/!\\ app.adn : type ${type} : ${message}`)

            if (!est_dictionnaire(config))
            {
                avertir(`la configuration doit être un dictionnaire`)
                continue
            }

            const complet = $type_anicroche(type)

            if (config.libelle !== undefined && typeof config.libelle !== 'string')
                avertir(`libelle doit être un texte`)

            if (config.identifiant !== undefined && !identifiant_valide(config.identifiant))
                avertir(`identifiant invalide (${config.identifiant}) : libre ou un nombre de 1 à ${LONGUEUR_MAXIMALE}`)

            if (config.auteurs !== undefined && typeof config.auteurs !== 'boolean')
                avertir(`auteurs doit valoir :) ou :(`)

            if (config.administration !== undefined && !Array.isArray(config.administration))
                avertir(`administration doit être une liste de rôles`)

            if (config.sources !== undefined && !est_dictionnaire(config.sources))
                avertir(`sources doit être un dictionnaire`)

            for (const [role, source] of Object.entries(est_dictionnaire(config.sources) ? config.sources : {}))
            {
                if (!est_dictionnaire(source))
                {
                    avertir(`source ${role} : la configuration doit être un dictionnaire`)
                    continue
                }

                if (!$lire_nombre(source.nombre))
                    avertir(`source ${role} : nombre invalide (${source.nombre})`)

                if (source.libelle !== undefined && typeof source.libelle !== 'string')
                    avertir(`source ${role} : libelle doit être un texte`)

                if (source.format !== undefined && !FORMATS.includes(source.format))
                    avertir(`source ${role} : format invalide (${source.format}) : ${FORMATS.join(', ')}`)
            }

            if (complet.sources.filter(source => source.format === 'titre').length > 1)
                avertir(`une seule source peut avoir le format titre`)

            if (config.exceptions !== undefined && !Array.isArray(config.exceptions))
                avertir(`exceptions doit être une liste`)

            const exceptions = Array.isArray(config.exceptions) ? config.exceptions : []

            if (exceptions.length && complet.identifiant !== 'libre')
                avertir(`exceptions demande un identifiant libre`)

            for (const exception of exceptions)
            {
                const id = exception?.identifiant

                if (!est_dictionnaire(exception) || !identifiant_lisible(id))
                {
                    avertir(`exception : identifiant invalide (${id})`)
                    continue
                }

                const specificites = exception.specificites ?? []
                if (!Array.isArray(specificites) || specificites.some(specificite => !SPECIFICITES.includes(specificite)))
                    avertir(`exception ${id} : specificites doit être une liste parmi ${SPECIFICITES.join(', ')}`)
                if (Array.isArray(specificites) && specificites.includes('acceptation') && !specificites.includes('preavis'))
                    avertir(`exception ${id} : acceptation demande preavis`)

                if (exception.sources !== undefined && !est_dictionnaire(exception.sources))
                    avertir(`exception ${id} : sources doit être un dictionnaire`)

                for (const [role, contenu] of Object.entries(est_dictionnaire(exception.sources) ? exception.sources : {}))
                {
                    const source = complet.sources.find(source => source.role === role)

                    if (!source)
                        avertir(`exception ${id} : rôle de source inconnu (${role})`)
                    else if (typeof contenu !== 'string')
                        avertir(`exception ${id} : la source ${role} doit être un texte`)
                    else if (source.min < 1)
                        avertir(`exception ${id} : la source ${role} n'est pas obligatoire, son contenu n'est jamais créé`)
                }
            }
        }
    }
]
