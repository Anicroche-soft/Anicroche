@name [ clefs, clef ]

@primary [ id ]

@unique [
    [ hachage_coordonnee, type, date_emission ]
]

@fields [
    {
        name    : id
        type    : char
        size    : 21
        chars   : [A-Z0-9]
        default : auto

        post_create : $retourner_id($values)
    }

    {
        alt  : coordonnee
        name : hachage_coordonnee
        type : hash

        # Une clef d effacement n est envoyée qu à la coordonnée principale du compte connecté,
        # avec son mot de passe (mot_de_passe dans le corps) : $preparer_clef le vérifie, car
        # un objet comme $context.compte ne peut pas être combiné par & dans une expression
        can_create  : "
            (
                $type = authentification
              & $hachage_coordonnee ~= /^[^@\s]+@[^@\s]+\.[^@\s]+$/
            )
          | $type = effacement
        "
        prior_create : $preparer_clef($values)
    }

    {
        name : type
        type : authentification/effacement
        size : 1-32

        can_create : "$type -{ [authentification, effacement]"
    }

    {
        name    : clef
        type    : hash
        size    : 1-256
        chars   : [0-9]
        length  : 9
        default : auto

        prior_create : $envoyer_clef($values)
    }

    {
        name    : nombre_tentatives
        type    : tinyint
        default : 6
    }

    {
        name    : date_emission
        type    : datetime
        default : now
    }

    {
        name    : date_validite
        type    : datetime
        default : now+15m
    }
]

@routes [
    {
        path   : /authentification
        action : $authentifier_clef($body)
    }
]

@script [
    $preparer_clef = async ($values) =>
    {
        if ($values.type === 'effacement')
        {
            await $exiger_compte()

            const principale = await $search_one('coordonnee',
                `
                #hachage_coordonnee = $values.hachage_coordonnee
              & #id_compte          = $id_compte
              & #est_principale
                `,
                { $values, $id_compte: $context.compte.id }
            )

            if (!principale)
                return $indicate(403, "Accès refusé")

            if (!await $verifier_mot_de_passe())
                return $indicate(403, "Mot de passe invalide")
        }

        const clef_recente = await $search_one('clef',
            `
            #hachage_coordonnee = $values.hachage_coordonnee
          & #type               = $values.type
          & #date_emission      > now-30s
            `,
            { $values }
        )

        if (clef_recente)
            return $indicate(429, "Clef trop récente déjà existante")

        await $delete_all('clefs',
            `
            #hachage_coordonnee = $values.hachage_coordonnee
          & #type = $values.type
            `,
            { $values },
            {
                order  : 'date_emission',
                dir    : 'desc',
                offset : 1
            }
        )
    }

    $envoyer_clef = async ($values) =>
    {
        // Empêche la détection d’un numéro de téléphone par les messageries.
        const clef_affichee = String($values.clef).replace(/(\d{3})(?=\d)/g, '$1&#8203;-&#8203;')

        const coordonnee_existante = await $search_one('coordonnee',
            `
            #hachage_coordonnee = $values.hachage_coordonnee
            `,
            { $values }
        )

        if ($values.type === 'effacement')
        {
            await $send_email({
                to      : $values.hachage_coordonnee,
                subject : "Votre code de désinscription",
                content : `<p>Votre code : <strong>${clef_affichee}</strong></p>`
                        + `<p>Il permet de demander la suppression de votre compte Anicroche. Si vous n'êtes pas à l'origine de cette demande, ne le communiquez à personne et changez votre mot de passe.</p>`
            })
            return
        }

        await $send_email({
            to      : $values.hachage_coordonnee,
            subject : coordonnee_existante ? "Votre code de connexion" : "Votre code d'inscription",
            content : `<p>Votre code : <strong>${clef_affichee}</strong></p>`
        })
    }

    $retourner_id = ($values) =>
    {
        $add_to_data('id', $values.id)
    }

    $authentifier_clef = async ($body) =>
    {
        if (
            !$body.coordonnee
         || !$body.clef
         || !Array.isArray($body.ids)
         || !$body.ids.length
        )
            return $indicate(400, "Corps incomplet")

        const clef = await $verifier_clef()

        const coordonnee_existante = await $search_one('coordonnee',
            `
            #hachage_coordonnee = $body.coordonnee
            `
        )

        if (!clef)
            return $indicate(403, 'Accès refusé')

        return $indicate(200, "Authentification réussie", {
            type : coordonnee_existante ? 'connexion' : 'inscription'
        })
    }
]
