@name [ sources, source ]

# Adresse d une source : /source/<anicroche>/<role>/<position>/<version>/<langue>/<region>
# (une langue ou une région vide s écrit -)
@primary [ id_anicroche, role, position, version, langue, region ]

@fields [
    # POST /source ajoute une source au brouillon d une anicroche : aucune source n existe
    # sans son anicroche
    {
        name         : id_anicroche
        type         : char
        size         : 1-48
        can_create   : ':)'
        prior_create : $verifier_source($values)
    }

    {
        name       : role
        type       : char
        size       : 1-32
        can_create : ':)'
    }

    # Rang de la source parmi celles de son rôle, commun à toutes ses versions et langues.
    # Sans position, POST /source ajoute une source à la suite ; avec la position d une source
    # existante, il en dépose une nouvelle version ou une traduction. PATCH la déplace, tant
    # qu aucune version n est publiée
    {
        name         : position
        type         : order
        variants     : [ version, langue, region ]
        can_create   : ':)'
        can_update   : ':)'
        prior_update : $verifier_deplacement_source($request)
    }

    {
        name       : version
        type       : int
        can_create : ':)'
    }

    {
        name       : langue
        type       : char
        size       : 0-3
        rule       : "$langue ~= /^([a-z]{2,3})?$/"
        can_create : ':)'
    }

    {
        name       : region
        type       : char
        size       : 0-2
        rule       : "$region ~= /^([A-Z]{2})?$/"
        can_create : ':)'
    }

    # PATCH /source/... { contenu } corrige une source, tant que sa version est un brouillon
    {
        name         : contenu
        type         : text
        can_create   : ':)'
        can_update   : ':)'
        prior_update : $verifier_modification_source($request)
    }
]

@rules [
    post_create : $retourner_position($values)
]

@script [
    // Le brouillon d une anicroche est sa dernière version, si elle n a pas de date de publication
    const lire_brouillon = async (id_anicroche) =>
    {
        const derniere = await $search_one('version',
            `#id_anicroche = $id`,
            { $id: id_anicroche },
            { order: 'numero', dir: 'desc' }
        )
        return derniere && !derniere.date_publication ? derniere : null
    }

    $verifier_source = async ($values) =>
    {
        const anicroche = await $exiger_administration_anicroche($values.id_anicroche)

        await $verifier_role_source(anicroche, $values.role, $values.position)

        const brouillon = await lire_brouillon($values.id_anicroche)
        if (!brouillon || brouillon.numero !== Number($values.version))
            return $indicate(422, "La version doit être le brouillon de l'anicroche")

        if ($values.position === undefined || $values.position === null)
            return

        const existante = await $search_one('source',
            `
            #id_anicroche = $id_anicroche
          & #role         = $role
          & #position     = $position
          & #version      = $version
          & #langue       = $langue
          & #region       = $region
            `,
            {
                $id_anicroche : $values.id_anicroche,
                $role         : $values.role,
                $position     : Number($values.position),
                $version      : Number($values.version),
                $langue       : $values.langue,
                $region       : $values.region
            }
        )
        if (existante)
            return $indicate(409, "Cette source existe déjà : la modifier avec PATCH")
    }

    $retourner_position = ($values) =>
    {
        $add_to_data('position', $values.position)
    }

    $verifier_modification_source = async ($request) =>
    {
        await $exiger_administration_anicroche($request.params.id_anicroche)

        const brouillon = await lire_brouillon($request.params.id_anicroche)
        if (!brouillon || brouillon.numero !== Number($request.params.version))
            return $indicate(422, "Seule une source du brouillon peut être modifiée")
    }

    // La position est commune à toutes les versions : déplacer une source changerait l ordre
    // d une version publiée, même programmée
    $verifier_deplacement_source = async ($request) =>
    {
        await $verifier_modification_source($request)

        const publiee = await $search_one('version',
            `
            #id_anicroche     = $id
          & #date_publication != null
            `,
            { $id: $request.params.id_anicroche }
        )
        if (publiee)
            return $indicate(422, "L'ordre des sources ne peut plus changer une fois une version publiée")
    }
]
